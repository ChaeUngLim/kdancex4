# admin-web 환경 변수 예시. 복사해서 .env 로 쓰고 값을 채운다(.env 는 커밋하지 않는다).
# 이 파일에는 이름만 적는다 — 값은 비워 둔다(S0-6.4). 넣을 값의 모양은 각 줄 위 주석에 적었다.
# 이름 목록은 lib/server/env.ts 의 스키마와 같아야 한다(tests/unit/env-example-names.test.ts 가 대조한다).
#
# API 주소는 환경 변수로 받지 않는다 — 화면은 같은 출처 /api(이 Next.js 앱의 Route Handler)를 부른다(S0-5.4).

# --- 필수 · DB(Prisma 8) ---
# 개발 DB 주소. 모양: postgresql://kdance:<비밀번호>@localhost:5433/kdance_next
# 비밀번호는 infra/docker-compose.yml(또는 infra/.env) 의 POSTGRES_PASSWORD 와 맞춘다.
DATABASE_URL=

# --- 필수 · Better Auth ---
# 서명·해시에 쓰는 비밀값. 32자 이상 무작위 문자열.
BETTER_AUTH_SECRET=
# 인증 경로의 바깥 주소(쿠키·CSRF 출처 검사). 개발 PC 는 http://localhost:3000
BETTER_AUTH_URL=

# --- 필수 · 내부 작업 경로(S0-4.3) ---
# `/api/internal/**` 를 부를 때 헤더 X-Internal-Token 에 싣는 값. 32자 이상 무작위 문자열.
INTERNAL_API_TOKEN=

# --- 필수 · 결제·본인확인 ---
# PG 결제 통지(웹훅) 서명 검증 비밀값.
PG_WEBHOOK_SECRET=
# 가짜 본인확인 토큰 서명 키.
FAKE_IDENTITY_SECRET=
# 본인확인 CI 해시 키. FAKE_IDENTITY_SECRET 과 다른 값이어야 서버가 시작한다.
IDENTITY_CI_PEPPER=

# --- 필수 · 민감 칸 암호화(S1-1.10) ---
# 정산 계좌번호 원문 같은 민감 칸을 DB 에 넣기 전에 암호화하는 AES-256-GCM 키. 32바이트를 base64 로 쓴 값.
# 만드는 법: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 바꾸면 이미 저장한 값을 풀 수 없다 — 환경마다 한 번 만들고 저장소 밖 비밀값 파일에 보관한다.
FIELD_ENCRYPTION_KEY=

# --- 선택 · 환경 이름(S0-6.2) ---
# development · beta · production 중 하나(비우면 development). 베타도 NODE_ENV 는 production 이라 이 값으로 구별한다.
# production 이면 가짜 PG·가짜 본인확인을 쓸 수 없어 서버가 시작을 거부한다(실 어댑터는 S8-1·S8-2).
KDANCE_ENV=

# --- 선택 · 테스트 DB ---
# `npm run test:db` 가 쓰는 주소. 모양: postgresql://kdance:<비밀번호>@localhost:5433/kdance_next_test
# 비우거나 접속이 안 되면 db 프로젝트 테스트는 건너뛴다.
TEST_DATABASE_URL=

# --- 선택 · dev 전용 경로(S0-4.2) ---
# `/api/dev/**`(가짜 본인확인·가짜 PG 조작)를 열지. 정확히 true 일 때만 열리고, 그 밖의 값·빈 값은 404.
# 개발 PC 에서만 true. 베타·운영 배포는 반드시 비우거나 false(계약 README §1 「시험 전용 경로」).
KDANCE_DEV_ROUTES=

# --- 선택 · 시간 작업 실행기(S0-4.4) ---
# crontab 이 `npm run job:run -- /api/internal/<작업>` 으로 부를 서버 주소. 비우면 http://localhost:3000
KDANCE_INTERNAL_BASE_URL=

# --- 선택 · 특일 정보(S0-4.11) ---
# 공공데이터포털 「한국천문연구원 특일 정보」 인증키. 원본은 저장소 밖 ~/.config/kdance/public-data.env(권한 600).
# 비우면 응답이 빈 가짜를 써서 수집해도 0건이다.
PUBLIC_DATA_HOLIDAY_KEY=

# --- 선택 · 국세청 사업자 상태조회(S1-1.30) ---
# 공공데이터포털 「국세청_사업자등록정보 진위확인 및 상태조회」 인증키. 원본은 ~/.config/kdance/public-data.env(권한 600).
# 비우면 가짜를 써서 모든 번호가 미등록(not_found)으로 나온다. 점검 작업(S1-1.27)만 부른다.
PUBLIC_DATA_NTS_KEY=

# --- 선택 · 요청 제한(S0-3.10) ---
# Redis(infra 의 kdance-redis) 주소. 개발 PC 는 redis://localhost:6380 . 꺼져 있으면 해당 요청은 429 로 막힌다.
REDIS_URL=
# DB 테스트가 쓰는 Redis. 개발용 0번과 섞이지 않게 15번 DB(redis://localhost:6380/15)를 쓴다.
TEST_REDIS_URL=
# 한도 값. 비우면 기본값(실패 15분 5회 · 본인확인 하루 5회). 양의 정수만 받는다.
RATE_LIMIT_AUTH_FAILURE_MAX=
RATE_LIMIT_AUTH_FAILURE_WINDOW_SECONDS=
RATE_LIMIT_IDENTITY_MAX=
RATE_LIMIT_IDENTITY_WINDOW_SECONDS=
# 결제 시작(회원 한 명 기준) 한도(S3-3.13). 비우면 1분에 10회.
RATE_LIMIT_CHECKOUT_MAX=
RATE_LIMIT_CHECKOUT_WINDOW_SECONDS=
# 소개 문구 초안(POST /api/ai/class-intro-drafts) — 직원 한 명이 창(초)마다 몇 번까지(기본 60초 10회, SX-6.6)
RATE_LIMIT_INTRO_DRAFT_MAX=
RATE_LIMIT_INTRO_DRAFT_WINDOW_SECONDS=
# 결제 웹훅 서명 실패 한도(S3-3.13). 비우면 10분에 20회. 서명이 맞는 웹훅은 세지도 막지도 않는다.
RATE_LIMIT_WEBHOOK_SIGNATURE_FAILURE_MAX=
RATE_LIMIT_WEBHOOK_SIGNATURE_FAILURE_WINDOW_SECONDS=

# --- 선택 · 파일 저장 위치(S1-1.5) ---
# 올린 증빙·사진을 담을 폴더. 상대 경로면 admin-web 기준. 비우면 admin-web/.data/uploads(git 이 무시한다).
FILE_STORAGE_DIR=

# --- 선택 · AI 에이전트 서버(SX-1.5) ---
# 에이전트 서버 주소. 개발 PC 는 http://localhost:8100 (agent-server, 계약 16 §0).
AGENT_SERVER_URL=
# Next.js → 에이전트 서버 호출에 싣는 X-Agent-Token. 에이전트 서버와 같은 값을 쓴다.
AGENT_API_TOKEN=
# 질문 한 건용 신원 토큰(agentSessionToken, 120초)의 HMAC 서명 키. 위 토큰과 다른 값을 쓴다.
# 셋 중 하나라도 비우면 /api/ai/chat 은 에이전트를 부르지 않고 대체 안내(data-error)로 닫는다.
AGENT_SESSION_SECRET=
# AI 질문 제한 시간(밀리초, SX-5.5). 비우면 첫 이벤트 1500 · 전체 25000.
# 에이전트가 첫 이벤트를 안 주거나 전체 시간을 넘기면 플래너는 일반 검색 결과(이름으로 찾은 수업 카드)로 닫는다.
AI_CHAT_FIRST_EVENT_TIMEOUT_MS=
AI_CHAT_TOTAL_TIMEOUT_MS=

# --- 선택 · 결제 기한 ---
# 비우면 카드 15분 · 가상계좌 24시간 · 가상계좌 마감 전 여유 60분. 양의 정수만 받는다.
PAYMENT_CARD_DEADLINE_MINUTES=
PAYMENT_VA_DEADLINE_HOURS=
PAYMENT_VA_CUTOFF_MINUTES=

# --- 선택 · 알림 발송기(S7-1.5) ---
# expo(실제 Expo 푸시 — 무료, 키 없음) 또는 fake(보내지 않고 기록만). 비우면 개발은 fake, 베타·운영은 expo.
# 개발 PC 에서 expo 로 두면 시연용 가짜 토큰이 「등록 안 된 기기」로 닫힌다.
PUSH_DELIVERY=

# S6-3.4(강사 레벨 조절) — 강사 멤버십 가짜 포트. 여기 적은 강사 계정 id(쉼표로 이음)만 「멤버십 아님」으로 답한다(비우면 모두 멤버십).
# 개발 DB 시연: scripts/dev-demo-level-offers.ts 가 끝에 넣을 값을 보여 준다. S6-1(멤버십 표)이 생기면 이 값은 쓰지 않는다.
FAKE_INSTRUCTOR_NON_MEMBER_IDS=
