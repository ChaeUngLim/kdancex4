  pre_class_reminder            = "pre_class_reminder"
  // 문의 알림(S7-2.3(답변과 응답 기한 재알림), 계약 15 §2-2·§2-4·§2-6, data-model §12-9) — 셋 다 거래(transactional).
  //   inquiry_received: 학원 문의가 오면 그 학원 active 대표에게(category inquiry, 열쇠 inquiry:<id>:received:<staffId>)
  //   inquiry_answered: 대표·운영자가 답하면 문의자에게(열쇠 inquiry:<id>:answered:<messageId>)
  //   inquiry_overdue:  1영업일 안에 첫 답이 없으면 대표(학원 문의)·운영자(시스템 문의)에게 한 번(열쇠 inquiry:<id>:overdue:<staffId>)
  inquiry_received              = "inquiry_received"
  inquiry_answered              = "inquiry_answered"
  inquiry_overdue               = "inquiry_overdue"
