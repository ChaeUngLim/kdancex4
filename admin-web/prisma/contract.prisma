  level_up                      = "level_up"
  // 강사 레벨 승급 안내(S6-3.4(강사 레벨 조절과 평가 레벨 숨김), 계약 14 §6-1) — 멤버십 강사가 회원의 지금 레벨보다 높게 정하면
  //   그 회원에게 1건(분류 service). 열쇠 level-offer:<offerId>:sent. 본문은 「○○ 강사님이 쌈바 레벨을 4(초중급)로 올려 줬어요」와
  //   제안 id·세부 장르·올린 레벨뿐 — 강사 평가 레벨은 싣지 않는다(S6-3 수용 ③)
  level_offer                   = "level_offer"
}

// 알림함 칩(O21·O21B) — 승인 / 신청·마감 / 문의 / 정산 / 운영(S1-4.2, data-model §7-9).
enum NotificationCategory {
  @@type("pg/text@1")
  approval     = "approval"
  signup_close = "signup_close"
  inquiry      = "inquiry"
  settlement   = "settlement"
  operations   = "operations"
}

// S7-1.6(발송 재시도 작업) — 선점(sending)·재시도 대기(retry_wait)·끝내 실패(failed)를 더했다(data-model §12-2 · 전이 §12-5).
enum DeliveryStatus {
  @@type("pg/text@1")
  pending    = "pending"
  sending    = "sending"
  retry_wait = "retry_wait"
  sent       = "sent"
  skipped    = "skipped"
  failed     = "failed"
}

enum SettlementKind {
  @@type("pg/text@1")
  payment_hold = "payment_hold"
}

enum SettlementStatus {
  @@type("pg/text@1")
  hold = "hold"
}

// ───────────────────────── 1~3. 학원·공지 판본·회원 ─────────────────────────

// 학원 — 환불 비율표 JSONB 유지(공유 계약 §4.4) + 지역·대표.
model Academy {
  id                  Uuid                   @id
  name                String(storage: varchar, length: 200)
  refund_policy_tiers Json                   @default(sql`'[]'::jsonb`)
  region_sido         String
  region_gu           String
  owner_member_id     Uuid?
  owner               Member?                @relation(fields: [owner_member_id], references: [id])
  created_at          DateTime(as: temporal) @default(now())
  updated_at          DateTime(as: temporal)
  // 아래 셋은 DB 칸이 아니라 「이 학원을 가리키는 행들」을 되짚는 관계다(S0-3.5a — 가드용 최소 테이블).
  academy_owners          AcademyOwner[]
  instructor_affiliations InstructorAffiliation[]
  instructor_invites      InstructorInvite[]
  // 지점 목록 — DB 칸이 아니라 관계다(S1-1.1).
  academy_branches        AcademyBranch[]
  // 앱 학원 페이지 사진(최대 10장) — DB 칸이 아니라 관계다(S1-1.20).
  photos                  AcademyPhoto[]
  // 이 학원을 만든 입점 신청 · 정산 계좌 이력 — DB 칸이 아니라 관계다(S1-1.2).
  merchant_applications   MerchantApplication[]
  payout_accounts         AcademyPayoutAccount[]
  // 이 학원의 입점 동의 기록 · 받은 약관 변경 통지 — DB 칸이 아니라 관계다(S1-1.3).
  merchant_consents       MerchantConsent[]
  terms_change_notices    TermsChangeNotice[]
  // 사업자 상태 확인 기록 · 학원 제한 — DB 칸이 아니라 관계다(S1-1.4).
  business_status_checks  BusinessStatusCheck[]
  restrictions            AcademyRestriction[]
  // 이 학원에 열린 이용 제한 절차 — DB 칸이 아니라 관계다(S7-2.6).
  restriction_cases       RestrictionCase[]
  // 이 학원 일로 생긴 알림 — DB 칸이 아니라 관계다(S1-4.2).
  notifications           Notification[]
  // 소속 강사에게 보낸 학원 공지 — DB 칸이 아니라 관계다(S1-4.1).
  staff_notices           AcademyStaffNotice[]

  // ── 입점 칸(S1-1.1, data-model §7-3) ──
  // 학원 행은 입점 승인 때 만든다. 그래서 판매자 정보(상호·대표자명·사업자등록번호·주소·전화)와 승인 시각은
  // 처음부터 다 차 있어야 한다(NOT NULL). 승인 전 정보는 merchant_applications 에만 있다(S1-1 수용 ③).
  // 학원 상태 — active(정상) / restricted(게시 제한, FR-250) / termination_requested → terminated(입점 해지, FR-256).
  status                     AcademyStatus           @default(active)
  // 등록 형태 — 교육청 학원 / 교습소 / 신고 체육시설 / 미등록(FR-085). 엄격 환불 기준(FR-087)이 이 값을 본다.
  registration_type          AcademyRegistrationType
  // 운영자가 증빙을 확인한 시각. 등록 형태를 바꾸면 비우고 재심사한다(7-12 ⑥).
  registration_verified_at   DateTime(as: temporal)?
  // 업종코드 — 참고용이라 비어 있어도 된다.
  industry_code              String?
  // 판매자 정보(FR-240 통신판매중개자 고지 · FR-248 사업자 정보 표시) — 회원 화면에 그대로 보인다.
  business_name              String
  representative_name        String
  // 사업자등록번호는 숫자 10자리만 둔다(하이픈 없이). 아래 ck_academies_brn 이 DB 에서 막는다.
  business_registration_number String
  mail_order_report_number   String?
  business_address           String
  phone                      String
  // 카드 결제를 켰나 — 입점 때 카드 수수료에 동의했을 때만 true(FR-125b).
  card_payment_enabled       Boolean                 @default(false)
  // 플랫폼 수수료 1년 면제 마지막 날(FR-124). 면제 대상 분류는 platform_fee_rates 가 정한다.
  platform_fee_exempt_until  Date?
  // 국세청 사업자 상태 마지막 확인 결과와 시각(O-17). 원문 기록은 business_status_checks(§7-3b, 다른 Task)에 쌓는다.
  business_status            String?
  business_status_checked_at DateTime(as: temporal)?
  // 앱 학원 페이지 한 줄 소개·소개 글(FR-070 W22).
  tagline                    String?
  intro                      String?
  // 입점 승인 시각 — 학원 행이 생긴 이유이므로 늘 있다.
  approved_at                DateTime(as: temporal)

  // ── 등록 형태 변경 신청 칸(S1-1.17(등록 형태 변경 재심사), data-model §7-12 ⑥ · 계약 07 §4) ──
  // 대표가 등록 형태를 바꾸겠다고 내면 새 형태는 여기에만 적고, 위 registration_type 은 운영자가 재심사로 받아들일 때까지
  // 이전 값을 그대로 둔다(학원 상세의 등록 형태 표시 FR-088 이 그동안 이전 형태를 보인다).
  // 대신 registration_verified_at 을 비워 「확인 전」으로 돌린다 → 재심사가 끝날 때까지 엄격 기준(FR-087)이다.
  // 세 칸 모두 NULL = 변경 신청 없음. 받아들이기·돌려보내기는 운영자 도구(S7-4)가 하고 세 칸을 다시 비운다.
  pending_registration_type             AcademyRegistrationType?
  // 새 형태를 증명하는 서류 한 장(미등록으로 바꾸면 서류가 없으니 NULL). 사업자등록증은 입점 때 이미 냈다.
  pending_registration_evidence_file_id Uuid?
  pending_registration_evidence_file    UploadedFile?           @relation(fields: [pending_registration_evidence_file_id], references: [id])
  registration_change_requested_at      DateTime(as: temporal)?
  // 이 학원에 올린 포스터 읽기 — DB 칸이 아니라 관계다(SX-2.3).
  poster_extractions                    PosterExtraction[]
  // 이 학원이 받은 문의 — DB 칸이 아니라 관계다(S7-2.1).
  inquiries                             Inquiry[]

  // 사업자등록번호는 숫자 10자리(국세청 형식). 하이픈·공백이 섞인 값은 DB 가 거부한다.
  @@check(expression: sql`business_registration_number ~ '^[0-9]{10}$'`, name: "ck_academies_brn")
  // 변경 신청 칸은 「새 형태」와 「신청 시각」이 함께 차거나 함께 빈다. 신청이 없는데 서류만 남는 행도 막는다.
  @@check(
    expression: sql`((pending_registration_type IS NULL) = (registration_change_requested_at IS NULL)) AND (pending_registration_type IS NOT NULL OR pending_registration_evidence_file_id IS NULL)`,
    name: "ck_academies_registration_change"
  )
  @@index([region_sido, region_gu], name: "ix_academies_region")
  @@map("academies")
}

// 환불·취소 공지 종류 — 정규 / 이벤트형 / 개인 레슨(data-model §7-6, S1-3.1(공지 판본 테이블 넓히기)).
// 종류마다 판본 번호를 따로 쌓는다. private_lesson 은 Q22(개인 레슨 전용 양식) 임시 확정의 틀만 있고 content 모양은 S2-4 가 정한다.
enum RefundNoticeKind {
  @@type("pg/text@1")
  regular        = "regular"
  event          = "event"
  private_lesson = "private_lesson"
}

// 학원 환불·취소 공지 판본 — FR-284(주문 시점 값 고정). 주문은 결제 때의 판본을 가리킨다.
// 판본은 고치지 않고 새로 쌓는다. 옛 판본을 지우거나 바꾸면 이미 결제한 주문의 근거가 사라진다.
model RefundNoticeVersion {
  id                    Uuid                   @id
  academy_id            Uuid
  academy               Academy                @relation(fields: [academy_id], references: [id])
  // 어느 양식의 판본인가. 옛 행(종류가 생기기 전)은 모두 정규 공지였으므로 기본값을 regular 로 둔다.
  notice_kind           RefundNoticeKind       @default(regular)
  version               Int
  // 화면용 본문 — 서버가 content 로 만든다(대표가 직접 쓰는 글이 아니다).
  body                  String
  // 대표가 고른 값(구조화). 돌려줄 %(퍼센트) 칸이 여기 있다.
  //   정규:   { cancellableUntil, tiers: [{ point, percent }], nonRefundableCases, processingBusinessDays, ownerContact }
  //   이벤트형: { feeTiers: [{ window, percent }], nonRefundableCases, processingBusinessDays, ownerContact }
  // % 의 하한·상한(FR-086·FR-099c)은 저장 처리기(S1-3 의 API Task)가 검사한다 — 템플릿 판본마다 기준이 달라 DB 제약으로 박지 않는다.
  // 종류가 생기기 전 옛 행은 구조화 값이 없으므로 빈 객체가 기본값이다.
  content               Json                   @default(sql`'{}'::jsonb`)
  // 어느 템플릿(FR-086 등록 형태별 템플릿)의 몇 판으로 만들었나. 템플릿 없이 만든 옛 행은 비어 있다.
  template_code         String?
  template_version      String?
  // 판본을 올린 사람(대표 또는 위임 직원) — 감사 refund_notice.published 와 짝이다. 옛 행은 비어 있다.
  created_by_account_id Uuid?
  created_by_account    StaffAccount?          @relation(fields: [created_by_account_id], references: [id])
  created_at            DateTime(as: temporal) @default(now())

  @@check(expression: sql`version >= 1`, name: "ck_refund_notice_versions_version_positive")
  // 한 학원·한 종류 안에서 판본 번호는 하나뿐이다. 종류가 생겨서 (academy_id, version) 유니크를 이것으로 바꿨다.
  // 설계의 ix_refund_notice_latest (academy_id, notice_kind, version DESC) 는 같은 칸이라 따로 만들지 않는다 —
  // 계약 문법에 정렬 방향 인자가 없고, PostgreSQL 은 B-tree 를 거꾸로도 읽어 「종류별 최신 판본」 조회를 이 색인이 맡는다.
  @@index([academy_id, notice_kind, version], unique: true, name: "uq_refund_notice_academy_kind_version")
  @@map("refund_notice_versions")
}

// 회원 = 본인확인 1인(FR-003). 같은 사람이 계정 둘을 못 만들게 identity_ci_hash 가 유니크다.
model Member {
  id                    Uuid                   @id
  auth_user_id          String
  name                  String
  gender                Gender
  birth_date            Date
  phone                 String
  identity_ci_hash      String
  // 강사·대표·다른 회원에게 보이는 이름(FR-019a). 가입 때 받는다. 중복은 허용한다 — UNIQUE 를 걸지 않는다(data-model §15-4 ①, S3-1.2)
  nickname              String
  // 닉네임을 마지막으로 바꾼 시각. 바꾸는 경로는 S6-1(멤버십)이 만든다 — 지금은 칸만 예약한다
  nickname_changed_at   DateTime(as: temporal)?
  signup_notice_ack_at  DateTime(as: temporal)
  base_genre            Genre?
  experience_level      ExperienceLevel?
  available_from        Time?
  available_to          Time?
  created_at            DateTime(as: temporal) @default(now())
  updated_at            DateTime(as: temporal)
  audit_logs            AuditLog[]
  // 이 회원의 동의·철회 기록 — DB 칸이 아니라 관계다(S3-1.1).
  consents              MemberConsent[]
  // 이 회원의 알림 설정 · 기기 푸시 토큰 — DB 칸이 아니라 관계다(S7-1.2).
  notification_setting  NotificationSetting?
  push_tokens           PushToken[]
  // 이 회원이 쓴 문의 · 문의 글 · 신고 — DB 칸이 아니라 관계다(S7-2.1).
  inquiries             Inquiry[]
  inquiry_messages      InquiryMessage[]
  reports               Report[]
  // 이 회원에게 열린 이용 제한 절차 — DB 칸이 아니라 관계다(S7-2.6).
  restriction_cases     RestrictionCase[]
  restriction_explanations RestrictionExplanation[]
  // 이 회원이 올린 파일(문의·신고 첨부 — S7-2.7) — DB 칸이 아니라 관계다.
  uploaded_files        UploadedFile[]
  // 대표 캐릭터로 고른 등급 카드(FR-169c, S6-3.1). 카드가 지워지면 비운다(ON DELETE SET NULL). 고른 카드가 이 회원 것인지는 바꾸는 API 가 확인한다.
  featured_level_card_id Uuid?
  featured_level_card    LevelCard?           @relation(name: "member_featured_level_card", fields: [featured_level_card_id], references: [id], onDelete: SetNull)
  // 이 회원의 레벨·판정·승급·카드·강사 평가·레벨 제안·후보 동의 — DB 칸이 아니라 관계다(S6-3.1).
  genre_levels           MemberGenreLevel[]
  course_completions     CourseCompletion[]
  level_promotions       LevelPromotion[]
  level_cards            LevelCard[]          @relation(name: "level_card_owner")
  level_evaluations      InstructorLevelEvaluation[]
  level_offers           LevelOffer[]
  candidate_contact_consent CandidateContactConsent?

  @@check(
    expression: sql`(available_from IS NULL AND available_to IS NULL) OR (available_from IS NOT NULL AND available_to IS NOT NULL AND available_from < available_to)`,
    name: "ck_members_available_window"
  )
  // 닉네임은 앞뒤 공백 없이 2~12자(상수 NICKNAME_MIN·NICKNAME_MAX 와 같다). 허용 문자·금칙어는 앱 코드가 본다
  @@check(
    expression: sql`nickname = btrim(nickname) AND char_length(nickname) BETWEEN 2 AND 12`,
    name: "ck_members_nickname"
  )
  @@index([auth_user_id], unique: true, name: "uq_members_auth_user_id")
  @@index([identity_ci_hash], unique: true, name: "uq_members_identity_ci_hash")
  @@map("members")
}

// ───────────────────────── 4~5. 회원의 관심 장르·지역 ─────────────────────────

model MemberInterestGenre {
  member_id Uuid
  member    Member @relation(fields: [member_id], references: [id])
  genre     Genre

  @@id([member_id, genre])
  @@map("member_interest_genres")
}

model MemberRegion {
  member_id   Uuid
  member      Member @relation(fields: [member_id], references: [id])
  region_sido String
  region_gu   String

  @@id([member_id, region_sido, region_gu])
  @@map("member_regions")
}

// ───────────────────────── 6~9. 수업·신청 단위·회차·자리 묶음 ─────────────────────────

// 수업 상태(S2-2.1(수업 승인 기록 테이블), data-model §8-7·§8-8, FR-050a).
//   draft(임시 저장) ─승인 요청─▶ pending_approval(승인 중) ─대표 승인─▶ published(공개) ─모든 회차 폐강─▶ cancelled
//   「반려」(수정 요청)와 「등록 취소」는 상태가 따로 없다 — pending_approval 에서 draft 로 되돌아가고,
//   무슨 일이 있었는지는 class_approvals 에 revision_requested · withdrawn 한 줄로 남는다.
//   「마감」은 판매 단위(class_offerings.status = closed)의 일이고, 「종료」는 마지막 회차가 지난 것으로 읽을 때 계산한다.
enum ClassStatus {
  @@type("pg/text@1")
  draft            = "draft"
  pending_approval = "pending_approval"
  published        = "published"
  cancelled        = "cancelled"
}

// 수업 승인 기록의 행동(data-model §8-7). 한 줄 = 누가 언제 무엇을 했나.
enum ClassApprovalAction {
  @@type("pg/text@1")
  submitted          = "submitted"
  withdrawn          = "withdrawn"
  approved           = "approved"
  revision_requested = "revision_requested"
  auto_published     = "auto_published"
  edit_approved      = "edit_approved"
  edit_rejected      = "edit_rejected"
  closed             = "closed"
}

// 수업 세부 장르(data-model §8-7) — 댄스스포츠는 라틴·스탠다드, 살사·바차타는 살사·바차타. 그 밖의 장르는 비운다.
enum ClassSubGenre {
  @@type("pg/text@1")
  latin    = "latin"
  standard = "standard"
  salsa    = "salsa"
  bachata  = "bachata"
}

// 댄스스포츠 종목(FR-021 · D11) — 라틴 5종 + 스탠다드 5종. 수업 하나에 종목 하나.
enum ClassDiscipline {
  @@type("pg/text@1")
  rumba          = "rumba"
  cha_cha_cha    = "cha_cha_cha"
  samba          = "samba"
  paso_doble     = "paso_doble"
  jive           = "jive"
  waltz          = "waltz"
  tango          = "tango"
  viennese_waltz = "viennese_waltz"
  slow_foxtrot   = "slow_foxtrot"
  quickstep      = "quickstep"
}

// 수업 대상 레벨(data-model §8-7) — 회원 경험 수준 6구간에서 「댄서」를 뺀 5개. NULL = 레벨 무관.
enum ClassTargetLevel {
  @@type("pg/text@1")
  entry               = "entry"
  beginner            = "beginner"
  novice_intermediate = "novice_intermediate"
  intermediate        = "intermediate"
  advanced            = "advanced"
}

// 수업 적정 연령(FR-028) — 전 연령 또는 세대 셋.
enum ClassAgeGroup {
  @@type("pg/text@1")
  all      = "all"
  gen_2030 = "gen_2030"
  gen_4050 = "gen_4050"
  gen_5060 = "gen_5060"
}

model Class {
  id              Uuid                   @id
  academy_id      Uuid
  academy         Academy                @relation(fields: [academy_id], references: [id])
  title           String
  instructor_name String
  genre           Genre
  class_kind      ClassKind
  seat_mode       SeatMode
  // ── 승인 흐름 칸(S2-2.1, data-model §8-2) ──
  // 새 수업은 임시 저장(draft)으로 시작한다. 이 칸이 생기기 전부터 있던 행은 마이그레이션이 published 로 채운다.
  status                 ClassStatus             @default(draft)
  // 승인 요청한 때(24시간 재알림의 기준, FR-050a)
  submitted_at           DateTime(as: temporal)?
  // 대표가 승인한 때 · 승인한 사람. 대표가 직접 올려 바로 공개된 수업은 그 대표가 승인자다.
  approved_at            DateTime(as: temporal)?
  approved_by_account_id Uuid?
  approved_by            StaffAccount?           @relation(name: "class_approver", fields: [approved_by_account_id], references: [id])
  // 마지막 수정 요청(반려) 사유와 때 — 강사 화면에 그대로 보여 준다. 기록 전체는 class_approvals 에 있다.
  last_revision_reason   String?
  last_revision_at       DateTime(as: temporal)?
  // 24시간 재알림을 이미 보냈다는 표시(한 번만, FR-050a — S2-2.12 작업이 조건부 갱신으로 채운다)
  approval_reminded_at   DateTime(as: temporal)?
  // ── 수업 등록 칸(S2-2.3(수업 등록 API), data-model §8-2) ──
  // 담당 강사 · 올린 사람(강사 또는 대표). NULL 은 이 칸이 생기기 전의 옛 행뿐이고, 새 행은 앱이 늘 채운다.
  instructor_account_id  Uuid?
  instructor             StaffAccount?           @relation(name: "class_instructor", fields: [instructor_account_id], references: [id])
  created_by_account_id  Uuid?
  created_by             StaffAccount?           @relation(name: "class_creator", fields: [created_by_account_id], references: [id])
  // 세부 장르 · 종목 · 대상 레벨 · 기본 홀. 임시 저장에서는 비어 있을 수 있고, 다 찼는지는 승인 요청(submit) 때 앱이 본다.
  sub_genre              ClassSubGenre?
  discipline             ClassDiscipline?
  target_level           ClassTargetLevel?
  room_id                Uuid?
  room                   Room?                   @relation(fields: [room_id], references: [id])
  // 소개 문구(SX-6 가 생성 흐름을 맡는다 — 여기서는 칸만)
  intro_text             String?
  // 수업을 올리는 동안의 값의 원본(data-model §8 머리). 승인 요청 때 이 값으로 판매 단위·회차·자리 묶음을 만든다.
  registration_payload   Json                    @default(sql`'{}'::jsonb`)
  // 같은 사람이 같은 Idempotency-Key 로 다시 만들면 처음 행을 돌려준다(계약 11 §0).
  idempotency_key        String(storage: varchar, length: 200)?
  // ── 환불 공지 판본(S2-2.5(공지 자동 입력), data-model §8-2) ──
  // 승인 요청(submit) 때 그 학원의 최신 판본 id 를 붙인다(정규 계열 = regular, 금액 있는 이벤트형 = event).
  // 본문은 복사하지 않는다 — 판본은 지우거나 고치지 않고 쌓기만 하므로 id 하나로 그때 그 글을 다시 읽을 수 있다.
  // 임시 저장 중 · 0원 이벤트형(환불할 돈이 없다, FR-099d) · 이 칸이 생기기 전의 옛 행은 NULL 이다.
  refund_notice_version_id Uuid?
  refund_notice_version    RefundNoticeVersion?  @relation(fields: [refund_notice_version_id], references: [id])
  // ── 포스터(S2-2.8(수업 포스터 올리기), data-model §8-2 · 계약 11 §4-6) ──
  // 수업에 붙인 포스터 사진(uploaded_files.purpose = 'poster', 공개). 승인 흐름을 타지 않는 「바로 바뀌는 값」이라
  // 어느 상태에서나 바뀐다. NULL = 포스터 없음.
  poster_file_id           Uuid?
  poster_file              UploadedFile?         @relation(name: "class_poster", fields: [poster_file_id], references: [id])
  created_at      DateTime(as: temporal) @default(now())
  updated_at      DateTime(as: temporal)
  approvals       ClassApproval[]
  target_ages     ClassTargetAge[]
  // 이 수업 회차들의 변경 기록 — DB 칸이 아니라 관계다(S2-3.1).
  session_changes SessionChange[]
  // 강사가 이 수업 수강생에게 쓴 공지 — DB 칸이 아니라 관계다(S2-3.5).
  announcements   ClassAnnouncement[]
  // 공개 뒤 수정 요청 — DB 칸이 아니라 관계다(S2-3.12).
  edit_requests   ClassEditRequest[]
  // 이 수업을 만든 포스터 읽기(많아야 1행 — uq_poster_submitted_class). DB 칸이 아니라 관계다(SX-2.3).
  poster_extractions PosterExtraction[]
  // 이 수업의 홍보 이미지 만들기 기록 — DB 칸이 아니라 관계다(SX-6.5).
  promo_image_generations PromoImageGeneration[]
  // 이 수업의 소개 문구 초안 기록 — DB 칸이 아니라 관계다(SX-6.6).
  intro_drafts            ClassIntroDraft[]
  // 이 수업의 홍보 표지·소개 문구·검토 확인(많아야 1행 — class_id 가 PK). DB 칸이 아니라 관계다(SX-6.7).
  promo_assets            ClassPromoAsset?

  // 공개됐거나 공개 뒤 폐강된 수업은 승인한 때가 반드시 있다(승인 없이 공개되는 길을 DB 가 막는다).
  @@check(expression: sql`status NOT IN ('published', 'cancelled') OR approved_at IS NOT NULL`, name: "ck_classes_approved")
  // 수정 요청 사유는 1~200자(200 은 추천값). 빈 문자열 사유는 받지 않는다.
  @@check(expression: sql`last_revision_reason IS NULL OR char_length(last_revision_reason) BETWEEN 1 AND 200`, name: "ck_classes_revision")
  @@index([academy_id], name: "ix_classes_academy_id")
  @@index([genre], name: "ix_classes_genre")
  // 대표의 승인 대기 목록(O5 · 대시보드 pendingClassApprovals)은 이 색인으로 학원별 pending_approval 을 읽는다.
  @@index([academy_id, status], name: "ix_classes_academy_status")
  // 세부 장르는 장르에 맞는 값만(댄스스포츠 = 라틴·스탠다드, 살사·바차타 = 살사·바차타, 그 밖은 없음).
  // 임시 저장은 비어 있어도 되므로 「값이 있으면 짝이 맞아야 한다」로 건다 — 다 찼는지는 submit 의 앱 검증이 본다(약해짐, S2-2.3 증거에 기록).
  @@check(expression: sql`sub_genre IS NULL OR (genre = 'dance_sport' AND sub_genre IN ('latin', 'standard')) OR (genre = 'salsa_bachata' AND sub_genre IN ('salsa', 'bachata'))`, name: "ck_classes_genre_sub")
  // 종목은 댄스스포츠에만, 그리고 그 세부 장르(라틴·스탠다드)의 종목만(D11).
  @@check(expression: sql`discipline IS NULL OR (genre = 'dance_sport' AND ((sub_genre = 'latin' AND discipline IN ('rumba', 'cha_cha_cha', 'samba', 'paso_doble', 'jive')) OR (sub_genre = 'standard' AND discipline IN ('waltz', 'tango', 'viennese_waltz', 'slow_foxtrot', 'quickstep'))))`, name: "ck_classes_discipline")
  // 강사의 수업 목록(I19) · 강사 일정
  @@index([instructor_account_id, status], name: "ix_classes_instructor_status")
  // 같은 사람의 같은 멱등키는 한 행(두 번 눌러도 수업이 둘 생기지 않는다)
  @@index([created_by_account_id, idempotency_key], unique: true, where: sql`(idempotency_key IS NOT NULL)`, name: "uq_classes_creator_idempotency")
  @@map("classes")
}

// 수업의 적정 연령(data-model §8-4, FR-028) — 여러 개. 「전 연령(all)」은 다른 값과 같이 둘 수 없다(앱 규칙).
// 승인 요청(submit) 때 registration_payload 의 targetAges 로 채운다.
model ClassTargetAge {
  class_id  Uuid
  class     Class         @relation(fields: [class_id], references: [id])
  age_group ClassAgeGroup

  @@id([class_id, age_group])
  @@map("class_target_ages")
}

// 수업 승인 기록(S2-2.1, data-model §8-4) — 추가 전용. 고치거나 지우지 않고 한 줄씩 쌓는다.
// 승인 대기 목록은 이 표가 아니라 classes.status 에서 읽는다. 이 표는 강사 알림의 사유와 감사용 「무슨 일이 있었나」다.
model ClassApproval {
  id               Uuid                   @id
  class_id         Uuid
  class            Class                  @relation(fields: [class_id], references: [id])
  action           ClassApprovalAction
  // 그 행동을 한 직원(강사·대표). 폐강처럼 사람이 아닌 길은 아직 없다.
  actor_account_id Uuid
  actor            StaffAccount           @relation(fields: [actor_account_id], references: [id])
  // 수정 요청(반려) 사유 — 그 행동에만 있다.
  reason           String?
  // 몇 번째 제출인지(1부터). 반려 뒤 다시 올리면 2, 3 … 으로 늘고, 같은 제출에 대한 승인·반려도 같은 번호를 쓴다.
  revision_no      Int
  created_at       DateTime(as: temporal) @default(now())

  // 반려(revision_requested)에는 사유가 꼭 있고, 다른 행동에는 사유가 없다. 사유는 1~200자.
  @@check(expression: sql`(action = 'revision_requested') = (reason IS NOT NULL) AND (reason IS NULL OR char_length(reason) BETWEEN 1 AND 200)`, name: "ck_class_approvals_reason")
  @@check(expression: sql`revision_no >= 1`, name: "ck_class_approvals_revision_no")
  @@index([class_id, created_at], name: "ix_class_approvals_class")
  // 같은 수업의 같은 제출 번호로 「제출」이 두 번 쌓이지 않게 한다(두 번 누름·동시 요청 방어).
  @@index([class_id, revision_no], unique: true, where: sql`(action IN ('submitted', 'auto_published'))`, name: "uq_class_approvals_submit")
  @@map("class_approvals")
}

// 신청·결제 단위 — 정규 과정은 기간(term) 하나, 원데이는 회차(session) 하나(FR-052a).
model ClassOffering {
  id                      Uuid                   @id
  class_id                Uuid
  class                   Class                  @relation(fields: [class_id], references: [id])
  label                   String
  enrollment_unit         EnrollmentUnit
  price_amount            Int
  first_session_starts_at DateTime(as: temporal)
  last_session_ends_at    DateTime(as: temporal)
  status                  OfferingStatus
  // 반복 규칙 사본(KST 달력·시각) — 보여 주기·수정 비교용. 한 번만 하는 행사는 NULL(data-model §8-2, S2-2.3).
  schedule_rule           Json?
  // 환불 마감일(KST 달력, FR-099d · S2-2.6). 유료 이벤트형만 값이 있다 — 「이벤트형이면 필수」는 수업 구분이 classes 에 있어
  // 행 사이 비교라 CHECK 로 못 건다(승인 요청 때 앱 판정 checkRefundDeadline). 0원·개최일 뒤 금지는 아래 CHECK 두 개로 DB 도 막는다.
  refund_deadline_on      Date?
  created_at              DateTime(as: temporal) @default(now())
  updated_at              DateTime(as: temporal)
  // 이 신청 단위를 가리키는 문의 — DB 칸이 아니라 관계다(S7-2.1).
  inquiries               Inquiry[]
  // 이 판매 단위의 레벨 판정·승급·레벨 제안 — DB 칸이 아니라 관계다(S6-3.1).
  course_completions      CourseCompletion[]
  level_promotions        LevelPromotion[]
  level_offers            LevelOffer[]

  @@check(expression: sql`price_amount >= 0`, name: "ck_class_offerings_price_nonneg")
  @@check(expression: sql`price_amount > 0 OR refund_deadline_on IS NULL`, name: "ck_offerings_free_no_deadline")
  @@check(expression: sql`refund_deadline_on IS NULL OR refund_deadline_on <= (first_session_starts_at AT TIME ZONE 'Asia/Seoul')::date`, name: "ck_offerings_deadline_not_after_start")
  @@check(expression: sql`last_session_ends_at > first_session_starts_at`, name: "ck_class_offerings_period_order")
  @@index([class_id], name: "ix_offerings_class_id")
  @@index([status, first_session_starts_at], name: "ix_offerings_start")
  @@map("class_offerings")
}

// 회차 상태(data-model §8-7): 예정 → 휴강(이 회차만) · 폐강(이후 회차). 끝 상태. 시간·장소 변경은 상태를 바꾸지 않는다.
enum ClassSessionStatus {
  @@type("pg/text@1")
  scheduled = "scheduled"
  cancelled = "cancelled"
  closed    = "closed"
}

model ClassSession {
  id          Uuid                   @id
  offering_id Uuid
  offering    ClassOffering          @relation(fields: [offering_id], references: [id])
  seq         Int
  starts_at   DateTime(as: temporal)
  ends_at     DateTime(as: temporal)
  // 회차의 홀 · 그 회차를 실제로 가르치는 강사(S2-2.3, data-model §8-2). 승인 요청 때 수업의 값으로 채운다.
  // data-model 은 강사 칸을 NOT NULL 로 정했지만 NULL 허용으로 둔다(S2-2.4 에서 다시 봤다) — 강사 칸이 생기기 전의
  // 시드·테스트 회차(M1 취소·환불 픽스처)는 담당 강사 계정이 없어 채울 값이 없다. 등록 경로(submit)가 만드는 회차에는 늘 값이 있고,
  // 겹침 거부(ex_sessions_instructor)는 NULL 끼리 같다고 보지 않으므로 옛 행은 겹침 판정에서 빠질 뿐이다.
  room_id               Uuid?
  room                  Room?                  @relation(fields: [room_id], references: [id])
  instructor_account_id Uuid?
  instructor            StaffAccount?          @relation(name: "session_instructor", fields: [instructor_account_id], references: [id])
  // 회차 상태(S2-2.4, data-model §8-7) — 예정(scheduled)인 회차만 시간을 점유한다. 휴강(cancelled)·폐강(closed)은 S2-3 이 쓴다.
  status                ClassSessionStatus     @default(scheduled)
  // 휴강·폐강한 시각과 사유(S2-3.2, data-model §8-2). 사유는 수강생에게 보인다(계약 11 §6-2, 1~100자).
  cancelled_at          DateTime(as: temporal)?
  cancel_reason         String?
  // 이 회차의 변경 기록 · 대타 요청 — DB 칸이 아니라 관계다(S2-3.1).
  changes               SessionChange[]
  substitute_requests   SubstituteRequest[]
  // 이 회차를 두고 쓴 강사 공지(회차를 고르지 않은 공지는 수업에만 달린다) — DB 칸이 아니라 관계다(S2-3.5).
  announcements         ClassAnnouncement[]
  // 이 회차의 자리 종류별 현장 등록 인원(S3-5.4) — DB 칸이 아니라 관계다.
  seat_counters         SessionSeatCounter[]

  @@check(expression: sql`ends_at > starts_at`, name: "ck_class_sessions_time_order")
  // 휴강·폐강한 회차에만 닫은 시각이 있다(data-model §8-2 ck_sessions_cancelled).
  @@check(expression: sql`(status IN ('cancelled', 'closed')) = (cancelled_at IS NOT NULL)`, name: "ck_sessions_cancelled")
  @@index([offering_id, seq], unique: true, name: "uq_sessions_offering_seq")
  @@index([offering_id], name: "ix_sessions_offering_id")
  // 한 강사의 일정을 시간 순으로 읽는다(겹침 확인·캘린더). 겹침 자체는 마이그레이션 SQL 의 EXCLUDE 가 막는다
  // (ex_sessions_instructor · ex_sessions_room — Prisma 계약으로 표현되지 않아 손으로 쓴 SQL, data-model §8 머리).
  @@index([instructor_account_id, starts_at], name: "ix_sessions_instructor_time")
  @@map("class_sessions")
}

// ── S2-3.1(대타 요청·변경 기록 테이블) — data-model §8-5 · §8-7 · §8-8 ──

// 회차 변경 기록의 종류(data-model §8-7).
//   time_place = 시간·장소 변경(회차 상태는 그대로) · cancelled = 이 회차만 휴강 · closed = 폐강 ·
//   instructor_changed = 대체 강사 배정·대타 확정으로 그 회차의 강사가 바뀜
enum SessionChangeKind {
  @@type("pg/text@1")
  time_place         = "time_place"
  cancelled          = "cancelled"
  closed             = "closed"
  instructor_changed = "instructor_changed"
}

// 강사 수업 공지 종류(data-model §8-7, FR-063). 시간·장소 변경과 휴강은 공지 종류가 아니다(계약 11 §6-1·6-2 가 따로 다룬다).
enum ClassAnnouncementKind {
  @@type("pg/text@1")
  general  = "general"
  supplies = "supplies"
  progress = "progress"
}

// 대타 요청 상태(data-model §8-8).
//   open(후보에게 알림) ─먼저 수락한 한 명─▶ accepted ─대표 확인─▶ confirmed
//   open·accepted ─요청한 강사가 취소─▶ cancelled / open·accepted ─회차 시작 시각이 지남─▶ expired(S2-3.11)
enum SubstituteRequestStatus {
  @@type("pg/text@1")
  open      = "open"
  accepted  = "accepted"
  confirmed = "confirmed"
  cancelled = "cancelled"
  expired   = "expired"
}

// 대타 후보 한 명의 응답 상태 — invited(알림 받음) · accepted(수락) · declined(거절) · closed(다른 강사가 먼저 수락해 닫힘)
enum SubstituteCandidateStatus {
  @@type("pg/text@1")
  invited  = "invited"
  accepted = "accepted"
  declined = "declined"
  closed   = "closed"
}

// 공개 뒤 수업 수정 요청 상태(S2-3.12, data-model §8-7) — pending(대표 재승인 대기) → approved · rejected(사유) · withdrawn(올린 사람이 취소).
enum ClassEditRequestStatus {
  @@type("pg/text@1")
  pending   = "pending"
  approved  = "approved"
  rejected  = "rejected"
  withdrawn = "withdrawn"
}

// 공개 뒤 수업 수정 중 대표 재승인이 필요한 값(금액·요일·시간·기간·정원·환불 마감일)을 담는 요청(FR-050a · Q38(수업 수정 제한)). 감사 기록 대상.
// 승인을 기다리는 동안 classes·class_offerings·seat_pools 는 바뀌지 않는다 — 회원에게는 고치기 전 값이 그대로 보인다.
// 「바로 바뀌는 값」(소개 문구·포스터)은 이 표를 거치지 않고 classes 에 바로 쓴다.
model ClassEditRequest {
  id                      Uuid                   @id
  class_id                Uuid
  class                   Class                  @relation(fields: [class_id], references: [id])
  // 요청한 직원(수업을 올린 강사 또는 그 학원 대표)
  requested_by_account_id Uuid
  requested_by            StaffAccount           @relation(name: "class_edit_requester", fields: [requested_by_account_id], references: [id])
  status                  ClassEditRequestStatus @default(pending)
  // 바꿀 값만(계약 11 §5 요청의 changes 중 재승인 갈래) · 요청 때의 값(대표 화면의 「전 → 후」 재료)
  changes                 Json                   @default(sql`'{}'::jsonb`)
  before                  Json                   @default(sql`'{}'::jsonb`)
  // 반려 사유(1~200자, 대표가 적는다). 반려에만 있다.
  reject_reason           String?
  // 승인·반려한 대표와 그 시각
  decided_by_account_id   Uuid?
  decided_by              StaffAccount?          @relation(name: "class_edit_decider", fields: [decided_by_account_id], references: [id])
  decided_at              DateTime(as: temporal)?
  // 같은 사람이 같은 Idempotency-Key 로 다시 보내면 처음 요청을 돌려준다(계약 11 §5 「멱등: 키」).
  idempotency_key         String(storage: varchar, length: 200)
  created_at              DateTime(as: temporal) @default(now())

  // 반려(rejected)에만 사유가 있다. 사유는 1~200자.
  @@check(expression: sql`(status = 'rejected') = (reject_reason IS NOT NULL)`, name: "ck_class_edit_reject")
  @@check(expression: sql`reject_reason IS NULL OR char_length(reject_reason) BETWEEN 1 AND 200`, name: "ck_class_edit_reason_len")
  // 승인·반려에만 결정 시각이 있다(올린 사람의 취소는 결정이 아니다).
  @@check(expression: sql`(status IN ('approved', 'rejected')) = (decided_at IS NOT NULL)`, name: "ck_class_edit_decided")
  // 수업당 열린 수정 요청은 하나뿐이다. 끝난 요청은 몇 개든 남는다.
  @@index([class_id], unique: true, where: sql`(status = 'pending')`, name: "uq_class_edit_open")
  @@index([requested_by_account_id, idempotency_key], unique: true, name: "uq_class_edit_idem")
  // 수업 하나의 수정 요청 이력 · 대표의 승인 대기 목록(오래 기다린 순서)
  @@index([class_id, created_at], name: "ix_class_edit_class")
  @@map("class_edit_requests")
}

// 회차 하나의 변경 기록 — 추가 전용(고치거나 지우지 않는다). 시간·장소 변경은 회차 상태를 바꾸지 않고 이 표에만 쌓인다.
// 회원 알림 행(notifications)과 회원 선택 처리(휴강 7일 선택·환불)는 다른 Task(S2-3.2 · S4-3)가 쓴다.
model SessionChange {
  id                        Uuid                   @id
  class_id                  Uuid
  class                     Class                  @relation(fields: [class_id], references: [id])
  session_id                Uuid
  session                   ClassSession           @relation(fields: [session_id], references: [id])
  kind                      SessionChangeKind
  // 한 요청으로 묶인 여러 회차(폐강 · 소속 해제의 남은 회차 처리)를 같은 값으로 묶는다. 한 회차만 바꾸면 NULL.
  batch_id                  Uuid?
  // 바뀌기 전 값 · 바뀐 뒤 값(예: {startsAt, endsAt, roomId} · {instructorAccountId}). 회원 알림 문구가 이 둘을 읽는다.
  before                    Json                   @default(sql`'{}'::jsonb`)
  after                     Json                   @default(sql`'{}'::jsonb`)
  reason                    String?
  // 바꾼 직원(강사 또는 대표)
  changed_by_account_id     Uuid
  changed_by                StaffAccount           @relation(name: "session_change_actor", fields: [changed_by_account_id], references: [id])
  // 이 변경을 알린 회원 수(중복 제거한 수). 알림이 없으면 0.
  notified_member_count     Int                    @default(0)
  // 휴강일 때만 — 회원이 보강·환불을 고를 기한(알린 날부터 7일, Q16). 원본은 M4 의 선택 행이고 이 칸은 사본이다.
  member_choice_deadline_at DateTime(as: temporal)?
  // 강사·대표가 보낸 Idempotency-Key(계약 11 §6 「멱등: 키」). 같은 사람이 같은 키로 다시 보내면 처음 결과를 돌려준다.
  // 한 요청이 여러 행(폐강 묶음)을 만들면 요청한 회차의 행에만 둔다. 데이터 모델 §8-5 에 없던 칸 — S2-3.2 가 더했다.
  idempotency_key           String(storage: varchar, length: 200)?
  created_at                DateTime(as: temporal) @default(now())

  // 휴강(cancelled)에만 회원 선택 기한이 있고, 다른 종류에는 없다.
  @@check(expression: sql`(kind = 'cancelled') = (member_choice_deadline_at IS NOT NULL)`, name: "ck_session_changes_deadline")
  @@check(expression: sql`notified_member_count >= 0`, name: "ck_session_changes_notified")
  // 회차 하나의 변경 이력을 시간 순으로 읽는다.
  @@index([session_id, created_at], name: "ix_session_changes_session")
  // 같은 요청으로 묶인 변경을 한 번에 읽는다(묶음이 있는 행만 색인에 넣는다).
  @@index([batch_id], where: sql`(batch_id IS NOT NULL)`, name: "ix_session_changes_batch")
  // 같은 사람 · 같은 키는 한 번만(키가 있는 행만).
  @@index([changed_by_account_id, idempotency_key], unique: true, where: sql`(idempotency_key IS NOT NULL)`, name: "uq_session_changes_idem")
  @@map("session_changes")
}

// 대타 요청 — 강사가 자기 회차를 다른 강사에게 맡아 달라고 한다(FR-060, I-10). 감사 기록 대상.
// 「먼저 수락한 한 명」은 조건부 갱신 한 문장으로 정한다(… WHERE id=$1 AND status='open' — 영향 0 행이면 이미 닫힌 요청).
model SubstituteRequest {
  id                            Uuid                    @id
  session_id                    Uuid
  session                       ClassSession            @relation(fields: [session_id], references: [id])
  requested_by_account_id       Uuid
  requested_by                  StaffAccount            @relation(name: "substitute_requester", fields: [requested_by_account_id], references: [id])
  // 후보 강사에게 보내는 한마디(선택, 200자까지)
  message                       String?
  status                        SubstituteRequestStatus @default(open)
  // 먼저 수락한 강사와 그 시각
  accepted_candidate_account_id Uuid?
  accepted_candidate            StaffAccount?           @relation(name: "substitute_accepted_candidate", fields: [accepted_candidate_account_id], references: [id])
  accepted_at                   DateTime(as: temporal)?
  // 대표가 확인한 사람과 시각 — 확인되면 회차의 강사 칸이 바뀐다(S2-3.4)
  confirmed_by_account_id       Uuid?
  confirmed_by                  StaffAccount?           @relation(name: "substitute_confirmer", fields: [confirmed_by_account_id], references: [id])
  confirmed_at                  DateTime(as: temporal)?
  cancelled_at                  DateTime(as: temporal)?
  // 같은 강사가 같은 Idempotency-Key 로 다시 보내면 처음 요청을 돌려준다.
  idempotency_key               String(storage: varchar, length: 200)
  created_at                    DateTime(as: temporal)  @default(now())
  candidates                    SubstituteRequestCandidate[]

  // 수락됐거나 확정된 요청에는 수락한 강사와 수락 시각이 꼭 있다.
  @@check(expression: sql`status NOT IN ('accepted', 'confirmed') OR (accepted_candidate_account_id IS NOT NULL AND accepted_at IS NOT NULL)`, name: "ck_substitute_accepted")
  // 확정(confirmed)에만 확인 시각이 있다.
  @@check(expression: sql`(status = 'confirmed') = (confirmed_at IS NOT NULL)`, name: "ck_substitute_confirmed")
  @@check(expression: sql`message IS NULL OR char_length(message) <= 200`, name: "ck_substitute_msg")
  // 한 회차에 열린 요청(open·accepted)은 하나뿐이다. 끝난 요청은 몇 개든 남는다.
  @@index([session_id], unique: true, where: sql`(status IN ('open', 'accepted'))`, name: "uq_substitute_active")
  @@index([requested_by_account_id, idempotency_key], unique: true, name: "uq_substitute_idem")
  @@map("substitute_requests")
}

// 대타 요청을 알린 후보 강사. 후보 자격(같은 학원 active 소속 · 같은 활동 장르 · 그 시간에 일정 없음)은
// 요청을 만들 때 앱이 검사해 이 표에 저장한다(S2-3.4). 수락할 때 시간 여유를 한 번 더 본다.
model SubstituteRequestCandidate {
  request_id           Uuid
  request              SubstituteRequest         @relation(fields: [request_id], references: [id])
  candidate_account_id Uuid
  candidate            StaffAccount              @relation(name: "substitute_candidate", fields: [candidate_account_id], references: [id])
  status               SubstituteCandidateStatus @default(invited)
  responded_at         DateTime(as: temporal)?

  @@id([request_id, candidate_account_id])
  @@map("substitute_request_candidates")
}

// 강사 수업 공지(FR-063 · I13 · I13B) — 추가 전용. data-model §8-5 그대로(S2-3.5(강사 수업 공지)).
// 받는 사람은 보낼 때의 그 수업 확정 수강생으로 고정한다(recipient_count). 회원별 알림 행은 notifications(kind class_announcement)다.
// 회원의 수업 상세 「강사 공지」(M8C)는 이 표에서 읽는다 — 알림을 지워도 공지는 남는다.
model ClassAnnouncement {
  id                Uuid                   @id
  class_id          Uuid
  class             Class                  @relation(fields: [class_id], references: [id])
  // 어느 회차를 두고 쓴 공지인지(선택). 고르지 않으면 수업 전체 공지다.
  session_id        Uuid?
  session           ClassSession?          @relation(fields: [session_id], references: [id])
  author_account_id Uuid
  author            StaffAccount           @relation(name: "class_announcement_author", fields: [author_account_id], references: [id])
  kind              ClassAnnouncementKind
  title             String
  body              String
  // 푸시도 보낼지(I13 「푸시 알림도 보내기」). 끄면 알림함에만 남는다.
  push_requested    Boolean                @default(true)
  // 보낼 때 받은 회원 수(확정 수강생, 중복 제거). 0 이어도 공지는 남는다.
  recipient_count   Int
  // 같은 강사가 같은 Idempotency-Key 로 다시 보내면 처음 공지를 돌려준다.
  idempotency_key   String(storage: varchar, length: 200)
  created_at        DateTime(as: temporal) @default(now())

  // 제목 100자는 추천값(보드는 글자 수를 안 보인다) · 내용 500자는 I13 「62 / 500」
  @@check(expression: sql`char_length(title) BETWEEN 1 AND 100`, name: "ck_announce_title")
  @@check(expression: sql`char_length(body) BETWEEN 1 AND 500`, name: "ck_announce_body")
  @@check(expression: sql`recipient_count >= 0`, name: "ck_announce_recipients")
  @@index([author_account_id, idempotency_key], unique: true, name: "uq_announce_idem")
  // 수업 상세 「강사 공지」 최신순. 설계는 created_at DESC 지만 btree 는 거꾸로도 읽으므로 오름차순으로 둔다.
  @@index([class_id, created_at], name: "ix_announce_class")
  @@map("class_announcements")
}

// 자리 묶음 카운터 — 공유 계약 §4.7, data-model §4-4.
// 정원 초과는 조건부 UPDATE 가 1차로 막고, 아래 CHECK 가 DB 최후 방어선이다(FR-091(정원 초과 방지)).
model SeatPool {
  id              Uuid                   @id
  offering_id     Uuid
  offering        ClassOffering          @relation(fields: [offering_id], references: [id])
  seat_kind       SeatKind
  capacity        Int
  held_count      Int                    @default(0)
  confirmed_count Int                    @default(0)
  created_at      DateTime(as: temporal) @default(now())
  updated_at      DateTime(as: temporal)

  @@check(expression: sql`capacity > 0`, name: "ck_seat_pools_capacity_positive")
  @@check(expression: sql`held_count >= 0`, name: "ck_seat_pools_held_nonneg")
  @@check(expression: sql`confirmed_count >= 0`, name: "ck_seat_pools_confirmed_nonneg")
  @@check(expression: sql`held_count + confirmed_count <= capacity`, name: "ck_seat_pools_not_over")
  @@index([offering_id, seat_kind], unique: true, name: "uq_seat_pools_offering_kind")
  @@map("seat_pools")
}

// 회차별 자리 카운터(data-model §9-4 · §15-4 ②) — S3-5.4(현장 등록 인원)가 먼저 만든다.
// 현장에서 직접 받은 인원(onsite_count)만 숫자로 담는다. 이름·연락처 칸은 일부러 없다(「이름 없이 인원만 기록돼요」).
// 현장 수납은 플랫폼 밖이라(O-07) 주문·결제·정산 표와 이어지지 않는다. 누가 언제 바꿨는지는 audit_logs 에 남긴다.
// M4 의 S4-3 은 이 표에 보강 이동 인원(substitute_count) 칸만 더한다(먼저 만드는 마일스톤이 표를 정의한다 — §14).
// 행은 처음 고칠 때 만든다(없으면 0 으로 읽는다). updated_at = 현장 인원을 마지막으로 바꾼 시각.
model SessionSeatCounter {
  session_id   Uuid
  session      ClassSession           @relation(fields: [session_id], references: [id])
  seat_kind    SeatKind
  onsite_count Int                    @default(0)
  updated_at   DateTime(as: temporal) @default(now())

  @@id([session_id, seat_kind])
  @@check(expression: sql`onsite_count >= 0`, name: "ck_session_seat_onsite")
  @@map("session_seat_counters")
}

// ───────────────────────── 10~11. 주문·주문 상태 기록 ─────────────────────────

// 주문 = 돈. 금액과 주문 시점에 적용된 값(공지 판본·약관 판본·수수료율)을 그때 값으로 굳힌다(FR-284·FR-245).
model Order {
  id                           Uuid                   @id
  member_id                    Uuid
  member                       Member                 @relation(fields: [member_id], references: [id])
  offering_id                  Uuid
  offering                     ClassOffering          @relation(fields: [offering_id], references: [id])
  status                       OrderStatus
  list_price_amount            Int
  benefit_discount_amount      Int                    @default(0)
  coupon_discount_amount       Int                    @default(0)
  total_amount                 Int
  // 예매 수수료(FR-282a). 수업료와 따로 보존해야 취소해도 환불하지 않는 규칙을 나중에 적용할 수 있다.
  booking_fee_amount           Int                    @default(0)
  // S4-1.5(수단별 환불 실행) — 이 주문에서 돌려주기로 잡아 둔 금액 합(실패한 시도는 되돌려 뺀다, data-model §9-2).
  // 새 환불 경로만 올린다. 옛 이관 취소(S0-5)의 환불 행은 세지 않는다(추천안·사후 확인 2026-11-24).
  refunded_total_amount        Int                    @default(0)
  // 돌려준 예매 수수료(D21) — 법정 청약철회 환불이 성공할 때만 booking_fee_amount 가 된다.
  booking_fee_refunded_amount  Int                    @default(0)
  price_breakdown              Json
  refund_notice_version_id     Uuid
  refund_notice_version        RefundNoticeVersion    @relation(fields: [refund_notice_version_id], references: [id])
  intermediary_notice_version  String
  // 결제 시점에 동의한 약관 판본(FR-245).
  member_terms_version         String
  merchant_terms_version       String
  // 주문 시점에 실제로 적용한 수수료율. 1bp = 0.01%, 10000 = 100% (FR-124·FR-125e).
  platform_fee_rate_bp         Int
  cancel_fee_platform_share_bp Int
  // ── 주문 시점 스냅샷(S3-3.2, FR-284(주문 시점 값 고정) · 플랜 6-1) ──
  // 주문을 만드는 순간 수업·신청 단위에서 베껴 온다(lib/server/order-snapshot.ts 가 SQL 을 한 곳에서 만든다).
  // 그 뒤 대표가 수업을 고쳐도 이 칸은 그대로다 — 결제수단 판정·환불 경로·휴강 1회 금액이 결제할 때 본 값을 따라야 하기 때문이다.
  // 상품 종류: 정규 계열(카드 기본)과 이벤트형(계좌만, 취소 수수료 표)을 가른다(FR-280 · 계약 12 §2-1 5단계).
  class_kind                   ClassKind
  // 회차 수: 휴강 1회 금액 = 결제액 ÷ 회차 수(Q16 · 계약 12 `closureUnitAmount`). 개인 레슨은 수강권 횟수다.
  session_count                Int
  // 첫 회차 시작: 이벤트형 취소 수수료 구간(행사까지 며칠)의 기준(계약 12 `eventStartsAt`). 옮기기(Q26)만 덮어쓴다.
  first_session_starts_at      DateTime(as: temporal)
  // 환불 마감일(KST 달력, FR-099d). 유료 이벤트형만 값이 있고 정규·0원은 NULL — 신청 단위의 같은 이름 칸을 베낀다.
  refund_deadline_on           Date?
  // 노쇼 기준 판본(FR-135c · data-model §7-6) — 코드 상수 NO_SHOW_POLICY.version 을 베낀다.
  no_show_policy_version       String
  idempotency_key              String(storage: varchar, length: 200)
  paid_at                      DateTime(as: temporal)?
  closed_at                    DateTime(as: temporal)?
  created_at                   DateTime(as: temporal) @default(now())
  updated_at                   DateTime(as: temporal)
  // 이 주문의 레벨 판정 기록 — DB 칸이 아니라 관계다(S6-3.1).
  course_completions           CourseCompletion[]

  @@check(expression: sql`list_price_amount >= 0`, name: "ck_orders_list_price_nonneg")
  @@check(expression: sql`benefit_discount_amount >= 0`, name: "ck_orders_benefit_discount_nonneg")
  @@check(expression: sql`coupon_discount_amount >= 0`, name: "ck_orders_coupon_discount_nonneg")
  @@check(expression: sql`total_amount >= 0`, name: "ck_orders_total_amount")
  @@check(expression: sql`booking_fee_amount >= 0`, name: "ck_orders_booking_fee_nonneg")
  // 결제액 초과 환불을 DB 가 막는 마지막 방어선(SC-010(환불 초과 0건), D13·D15·D21). 상한은 결제액 − 예매 수수료, 청약철회면 결제액.
  @@check(
    expression: sql`refunded_total_amount >= 0 AND refunded_total_amount <= total_amount - booking_fee_amount + booking_fee_refunded_amount`,
    name: "ck_orders_refunded_cap"
  )
  @@check(expression: sql`booking_fee_refunded_amount IN (0, booking_fee_amount)`, name: "ck_orders_booking_fee_refunded")
  // 2026-11-10 고침(data-model §6-1): 할인이 정가를 넘으면 0원으로 막고, 예매 수수료는 할인 뒤 금액에 더한다.
  @@check(
    expression: sql`total_amount = GREATEST(0, list_price_amount - benefit_discount_amount - coupon_discount_amount) + booking_fee_amount`,
    name: "ck_orders_total_formula"
  )
  @@check(
    expression: sql`platform_fee_rate_bp BETWEEN 0 AND 10000 AND cancel_fee_platform_share_bp BETWEEN 0 AND 10000`,
    name: "ck_orders_fee_rates"
  )
  // 회차가 없는 주문은 팔 수 없다 — 0 이면 휴강 1회 금액 나눗셈이 깨진다(S3-3.2).
  @@check(expression: sql`session_count >= 1`, name: "ck_orders_session_count")
  @@index([member_id, idempotency_key], unique: true, name: "uq_orders_member_idempotency")
  @@index([member_id], name: "ix_orders_member_id")
  @@map("orders")
}

// 주문 상태 전이 감사 기록(FR-298) — 추가 전용(수정·삭제하지 않는다).
model OrderEvent {
  id          Uuid                   @id
  order_id    Uuid
  order       Order                  @relation(fields: [order_id], references: [id])
  from_status OrderStatus?
  to_status   OrderStatus
  reason      String
  created_at  DateTime(as: temporal) @default(now())

  @@index([order_id], name: "ix_order_events_order_id")
  @@map("order_events")
}

// ───────────────────────── 12~14. 결제·웹훅 원장·결제 예외 ─────────────────────────

// PG 거래 1건. 옛 「paid_at IS NOT NULL = 결제 완료」 판정은 status = 'paid' 로 바뀌었다.
model Payment {
  id                       Uuid                   @id
  order_id                 Uuid
  order                    Order                  @relation(fields: [order_id], references: [id], onDelete: Cascade)
  method                   PaymentMethod
  amount                   Int
  paid_at                  DateTime(as: temporal)?
  gateway_payment_key      String(storage: varchar, length: 200)?
  // 우리가 PG 에 주는 결제 id(PG 가 알려 주는 거래 id 와 다르다).
  gateway_payment_id       String(storage: varchar, length: 64)
  status                   PaymentStatus
  due_at                   DateTime(as: temporal)
  virtual_account_bank_code String?
  virtual_account_number    String?
  virtual_account_holder    String?
  pg_reported_amount       Int?
  created_at               DateTime(as: temporal) @default(now())
  updated_at               DateTime(as: temporal)

  @@check(expression: sql`amount >= 0`, name: "ck_payments_amount")
  @@index([gateway_payment_id], unique: true, name: "uq_payments_gateway_payment_id")
  // 주문 하나에 살아 있는 결제는 한 건뿐(ready·paid). 만료·취소된 결제는 여러 건 남을 수 있다.
  @@index([order_id], unique: true, where: sql`(status IN ('ready', 'paid'))`, name: "uq_payments_order_live")
  @@index([order_id], name: "ix_payments_order_id")
  @@index([status, due_at], name: "ix_payments_status_due")
  @@map("payments")
}

// 웹훅 수신 원장 — 같은 통지가 두 번 와도 webhook_id 유니크가 중복 반영을 막는다(FR-116).
model PaymentWebhookEvent {
  id                 Uuid                   @id
  webhook_id         String
  event_type         String
  gateway_payment_id String?
  result             WebhookResult
  payload            Json
  received_at        DateTime(as: temporal) @default(now())

  @@index([webhook_id], unique: true, name: "uq_webhook_events_webhook_id")
  @@map("payment_webhook_events")
}

// 돌려줄 대상(환불 대상) 기록의 유일한 자리(FR-290·FR-292). refunds 에는 넣지 않는다 —
// refunds 는 확정 예약의 환불 원장이고, 이 돈은 확정된 예약이 없다.
model PaymentException {
  id              Uuid                   @id
  payment_id      Uuid
  payment         Payment                @relation(fields: [payment_id], references: [id])
  order_id        Uuid
  order           Order                  @relation(fields: [order_id], references: [id])
  kind            PaymentExceptionKind
  received_amount Int
  status          PaymentExceptionStatus
  pg_transaction_id String?
  created_at      DateTime(as: temporal) @default(now())

  @@check(expression: sql`received_amount >= 0`, name: "ck_payment_exceptions_received_nonneg")
  @@index([payment_id, kind], unique: true, name: "uq_payment_exceptions_payment_kind")
  @@map("payment_exceptions")
}

// ───────────────────────── 15~18. 예약·캘린더·알림·정산 보류 ─────────────────────────

model Reservation {
  id             Uuid                   @id
  order_id       Uuid
  order          Order                  @relation(fields: [order_id], references: [id], onDelete: Cascade)
  offering_id    Uuid
  offering       ClassOffering          @relation(fields: [offering_id], references: [id])
  seat_pool_id   Uuid
  seat_pool      SeatPool               @relation(fields: [seat_pool_id], references: [id])
  // 결제 시점의 자리 구분 사본.
  seat_kind      SeatKind
  member_id      Uuid
  member         Member                 @relation(fields: [member_id], references: [id])
  status         ReservationStatus
  cancelled_at   DateTime(as: temporal)?
  cancel_reason  CancelReason?
  created_at     DateTime(as: temporal) @default(now())
  updated_at     DateTime(as: temporal)
  // 이 예약을 가리키는 문의 — DB 칸이 아니라 관계다(S7-2.1).
  inquiries      Inquiry[]
  // 이 예약의 레벨 판정 기록 — DB 칸이 아니라 관계다(S6-3.1).
  course_completions CourseCompletion[]

  // 취소 사유는 취소된 예약에만 둔다. 만료(expired)는 상태로 표현하므로 사유가 없다.
  @@check(expression: sql`cancel_reason IS NULL OR status = 'cancelled'`, name: "ck_reservations_cancel_reason")
  // 한 회원이 같은 신청 단위에 살아 있는 예약을 둘 못 가진다.
  @@index([member_id, offering_id], unique: true, where: sql`(status IN ('held', 'confirmed'))`, name: "uq_reservations_member_offering_active")
  @@index([order_id], name: "ix_reservations_order_id")
  @@index([offering_id], name: "ix_reservations_offering_id")
  @@index([member_id], name: "ix_reservations_member_id")
  @@map("reservations")
}

model CalendarEntry {
  id             Uuid                   @id
  member_id      Uuid
  member         Member                 @relation(fields: [member_id], references: [id])
  reservation_id Uuid
  reservation    Reservation            @relation(fields: [reservation_id], references: [id])
  session_id     Uuid
  session        ClassSession           @relation(fields: [session_id], references: [id])
  starts_at      DateTime(as: temporal)
  ends_at        DateTime(as: temporal)
  title          String
  created_at     DateTime(as: temporal) @default(now())

  @@index([member_id, session_id], unique: true, name: "uq_calendar_member_session")
  @@index([member_id, starts_at], name: "ix_calendar_member_start")
  @@map("calendar_entries")
}

// ── S3-4.1(결석 기록 테이블) — data-model §7-8 ──

// 결석을 누가 표시했나 — member(회원이 미리 알린 결석 예정, FR-092e) · instructor(강사가 대신 표시) · owner(대표가 대신 표시)
enum AttendanceMarkedByKind {
  @@type("pg/text@1")
  member     = "member"
  instructor = "instructor"
  owner      = "owner"
}

// 강사·대표가 표시한 결석에 회원이 건 이의의 상태 — none(이의 없음) → requested(이의 신청) → accepted(받아들임, 그 행을 취소) · rejected(거절).
// 값 이름과 처리자(강사인가 대표인가)는 data-model 의 추천안이다.
enum AttendanceDisputeStatus {
  @@type("pg/text@1")
  none      = "none"
  requested = "requested"
  accepted  = "accepted"
  rejected  = "rejected"
}

// 결석 기록 — 행이 있으면 그 회차는 결석이다(출석이 기본값, Q15(출결 방식)).
// 회원이 미리 알린 결석 예정과 강사·대표가 대신 표시한 결석을 한 표에 두고 marked_by_kind 로 나눈다.
// 레벨 계산(FR-169a(출석률 반영 레벨))은 둘 다 센다. 표시를 거두면 지우지 않고 cancelled_at 을 채운다(이력이 남는다).
model AttendanceMark {
  id                             Uuid                    @id
  reservation_id                 Uuid
  reservation                    Reservation             @relation(fields: [reservation_id], references: [id])
  session_id                     Uuid
  session                        ClassSession            @relation(fields: [session_id], references: [id])
  // 결석한 회원. 예약의 회원과 같은지는 쓰는 API 가 확인한다(행 사이 비교라 CHECK 로 못 건다)
  member_id                      Uuid
  member                         Member                  @relation(name: "attendance_member", fields: [member_id], references: [id])
  marked_by_kind                 AttendanceMarkedByKind
  // 표시한 사람 — 회원이 표시했으면 회원 칸, 강사·대표가 표시했으면 직원 계정 칸 하나만 채운다(ck_attendance_marker)
  marked_by_member_id            Uuid?
  marked_by_member               Member?                 @relation(name: "attendance_marker_member", fields: [marked_by_member_id], references: [id])
  marked_by_staff_account_id     Uuid?
  marked_by_staff                StaffAccount?           @relation(name: "attendance_marker_staff", fields: [marked_by_staff_account_id], references: [id])
  marked_at                      DateTime(as: temporal)  @default(now())
  cancelled_at                   DateTime(as: temporal)?
  // 이의 칸 — 강사·대표가 표시한 행에만 걸 수 있다(ck_attendance_dispute_staff_only)
  dispute_status                 AttendanceDisputeStatus @default(none)
  dispute_requested_at           DateTime(as: temporal)?
  dispute_reason                 String?
  dispute_resolved_by_account_id Uuid?
  dispute_resolved_by            StaffAccount?           @relation(name: "attendance_dispute_resolver", fields: [dispute_resolved_by_account_id], references: [id])
  dispute_resolved_at            DateTime(as: temporal)?

  // 표시한 사람 칸은 종류와 짝이 맞아야 한다 — member 는 회원 칸만, instructor·owner 는 직원 칸만.
  @@check(
    expression: sql`(marked_by_kind = 'member' AND marked_by_member_id IS NOT NULL AND marked_by_staff_account_id IS NULL) OR (marked_by_kind <> 'member' AND marked_by_staff_account_id IS NOT NULL AND marked_by_member_id IS NULL)`,
    name: "ck_attendance_marker"
  )
  // 회원이 스스로 알린 결석 예정에는 이의를 걸 수 없다(data-model §7-8 「강사·대표 표시 행에만」).
  @@check(expression: sql`dispute_status = 'none' OR marked_by_kind <> 'member'`, name: "ck_attendance_dispute_staff_only")
  // 이의를 걸었으면(none 이 아니면) 신청 시각이 있다.
  @@check(expression: sql`(dispute_status = 'none') = (dispute_requested_at IS NULL)`, name: "ck_attendance_dispute_requested")
  // 처리(accepted·rejected)된 이의에만 처리한 사람·시각이 있다.
  @@check(
    expression: sql`(dispute_status IN ('accepted', 'rejected')) = (dispute_resolved_at IS NOT NULL AND dispute_resolved_by_account_id IS NOT NULL)`,
    name: "ck_attendance_dispute_resolved"
  )
  // 한 예약의 한 회차에는 살아 있는 결석 표시가 하나뿐이다. 거둔(cancelled_at 있는) 행은 몇 개든 남는다.
  @@index([reservation_id, session_id], unique: true, where: sql`(cancelled_at IS NULL)`, name: "uq_attendance_session")
  // 회차 명단(S3-5)이 회차로, 레벨 계산이 회원으로 읽는다.
  @@index([session_id], name: "ix_attendance_session_id")
  @@index([member_id, marked_at], name: "ix_attendance_member_time")
  @@map("attendance_marks")
}

// 앱 안 알림 기록(FR-114). 같은 사건을 다시 처리해도 (kind, order_id, recipient) 가 같으면 1건이다.
model Notification {
  id                  Uuid                   @id
  // 받는 사람은 회원 또는 직원(강사·대표·운영자) 딱 한 명이다(S1-4.2, data-model §7-7).
  // 직원 알림함도 이 표를 같이 쓰려고 회원 칸을 NULL 허용으로 풀었다 — 아래 ck_notifications_one_recipient 가
  // 「둘 다 비었거나 둘 다 찬」 행을 DB 에서 막는다.
  recipient_member_id Uuid?
  recipient           Member?                @relation(fields: [recipient_member_id], references: [id])
  recipient_staff_account_id Uuid?
  recipient_staff     StaffAccount?          @relation(fields: [recipient_staff_account_id], references: [id])
  // 어느 학원 일인지(직원 알림함에서 학원별로 묶을 때). 회원 알림은 비워도 된다.
  academy_id          Uuid?
  academy             Academy?               @relation(fields: [academy_id], references: [id])
  // 알림함 칩. 회원 알림은 비워 둔다.
  category            NotificationCategory?
  // 주문이 없는 알림의 재처리 방지 열쇠(예: `affiliation:<id>:requested`). 같은 kind 에 같은 열쇠는 한 번만 들어간다.
  dedupe_key          String?
  kind                NotificationKind
  order_id            Uuid?
  order               Order?                 @relation(fields: [order_id], references: [id])
  reservation_id      Uuid?
  reservation         Reservation?           @relation(fields: [reservation_id], references: [id])
  payload             Json
  delivery_status     DeliveryStatus         @default(pending)
  // S7-1.6(발송 재시도 작업) — 발송 시도 기록. 시도는 처음 포함 최대 3번, 사이 간격 1분·5분(계약 15 §1-4 retry).
  attempt_count       Int                    @default(0)
  next_attempt_at     DateTime(as: temporal)?
  last_attempt_at     DateTime(as: temporal)?
  delivery_error_code String?
  delivered_at        DateTime(as: temporal)?
  read_at             DateTime(as: temporal)?
  created_at          DateTime(as: temporal) @default(now())
  // 이 알림으로 보낸 약관 변경 통지 — DB 칸이 아니라 관계다(S1-1.3).
  terms_change_notices TermsChangeNotice[]

  @@index([kind, order_id, recipient_member_id], unique: true, name: "uq_notifications_kind_order_recipient")
  @@index([recipient_member_id, created_at], name: "ix_notifications_recipient_created")
  @@check(expression: sql`num_nonnulls(recipient_member_id, recipient_staff_account_id) = 1`, name: "ck_notifications_one_recipient")
  // 열쇠가 있는 알림만 대상이다 — 기존 주문 알림(열쇠 없음)은 위 uq_notifications_kind_order_recipient 가 맡는다.
  @@index([kind, dedupe_key], unique: true, where: sql`(dedupe_key IS NOT NULL)`, name: "uq_notifications_dedupe")
  // 직원 알림함 목록(최신순). 설계는 created_at DESC 지만 btree 는 거꾸로도 읽으므로 오름차순으로 둔다(ix_audit_academy_time 과 같은 방식).
  @@index([recipient_staff_account_id, created_at], name: "ix_notifications_staff_created")
  @@check(expression: sql`attempt_count >= 0`, name: "ck_notifications_attempts")
  // 재시도 작업이 「기다림이 끝난 행」만 빨리 찾게 — retry_wait 인 행만 담는다
  @@index([next_attempt_at], where: sql`(delivery_status = 'retry_wait')`, name: "ix_notifications_retry")
  @@map("notifications")
}

// 정산 보류 적립 최소형(Q5 확정). 나머지 단계는 정산 원장(SCH-31)이 잇는다.
model SettlementEntry {
  id         Uuid                   @id
  order_id   Uuid
  order      Order                  @relation(fields: [order_id], references: [id])
  academy_id Uuid
  academy    Academy                @relation(fields: [academy_id], references: [id])
  kind       SettlementKind
  amount     Int
  status     SettlementStatus
  created_at DateTime(as: temporal) @default(now())

  @@check(expression: sql`amount >= 0`, name: "ck_settlement_entries_amount_nonneg")
  @@index([order_id, kind], unique: true, name: "uq_settlement_order_kind")
  @@map("settlement_entries")
}

// ───────────────────────── 19~20. 환불·환불 감사 로그 (이관 그대로) ─────────────────────────

// 환불 — 예약 하나에 살아 있는 환불은 한 건뿐(이중 환불 방지 핵심).
// 부분 유니크 충돌은 `ON CONFLICT DO NOTHING RETURNING` 이 0행으로 받는다(research R-07 실측 완료).
model Refund {
  id                         Uuid                   @id
  reservation_id             Uuid
  reservation                Reservation            @relation(fields: [reservation_id], references: [id], onDelete: Cascade)
  payment_id                 Uuid
  payment                    Payment                @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  idempotency_key            String(storage: varchar, length: 200)
  requested_amount           Int
  refunded_amount            Int                    @default(0)
  // 환불 비율. basis point 정수 0~10000(공유 계약 §4.4) — 퍼센트·소수를 쓰지 않는다.
  refund_rate_bp             Int
  status                     RefundStatus
  reason                     RefundReason
  // 가상계좌 환불은 별도 송금이라 환불 계좌가 필요하다. 카드는 원거래 취소라 전부 비어 있다.
  refund_account_bank_code   String(storage: varchar, length: 20)?
  refund_account_number      String(storage: varchar, length: 64)?
  refund_account_holder_name String(storage: varchar, length: 100)?
  gateway_refund_id          String(storage: varchar, length: 200)?
  failure_code               String(storage: varchar, length: 100)?
  failure_message            String(storage: varchar, length: 500)?
  // ── S4-1.5(수단별 환불 실행) — 환불 원인·실행 방식(data-model §9-3) ──
  // 옛 이관 취소(S0-5, lib/server/services/cancellation.ts)가 쓰는 행은 아래 칸이 모두 비어 있다(「옛 행」).
  // 그 경로를 걷어 내는 S4-1.9(옛 비율표 코드 걷어 내기)가 남은 옛 행을 정리하고 NOT NULL 로 조인다(추천안·사후 확인 2026-11-24).
  order_id                     Uuid?
  order                        Order?                 @relation(fields: [order_id], references: [id])
  // 대표가 승인한 환불 요청이 원인이면 그 요청. 휴강·일괄 취소 환불은 비어 있다.
  refund_request_id            Uuid?
  refund_request               RefundRequest?         @relation(fields: [refund_request_id], references: [id])
  // 왜 돌려주나 — 원인 종류와 그 원인 행의 id. 같은 원인으로 살아 있는 환불은 1건뿐이다(uq_refunds_basis_active, D13).
  basis_kind                   RefundBasisKind?
  basis_id                     Uuid?
  // 어떻게 돌려주나 — 카드·간편결제는 PG 부분 취소, 계좌 결제분은 대표가 은행에서 송금(FR-295).
  execution_kind               RefundExecutionKind?
  executed_by                  RefundExecutedBy?
  executed_by_staff_account_id Uuid?
  executed_by_staff_account    StaffAccount?          @relation(fields: [executed_by_staff_account_id], references: [id])
  // 계좌 결제분이 송금할 회원 계좌(평문 번호는 refund_accounts 에 암호화돼 있다).
  refund_account_id            Uuid?
  refund_account               RefundAccount?         @relation(fields: [refund_account_id], references: [id])
  // 취소 잔여금(M5 가 5:5 로 나눈다, FR-125e). 정규 환불은 0.
  cancel_fee_amount            Int                    @default(0)
  // 같은 원인의 몇 번째 시도인가. 실패한 시도는 남기고 다시 승인하면 다음 번호로 새 행을 만든다(FR-103).
  attempt_no                   Int                    @default(1)
  // 계좌분 송금 기한 = 승인 + 공지의 처리 기간(정규 기본 5영업일, D6). 카드분은 비어 있다.
  transfer_due_at              DateTime(as: temporal)?
  // ── S4-1.5a(계좌 환불 송금 완료·반송 처리 API) — 대표가 은행에서 보낸 뒤 누른 「송금 완료」, 또는 「다시 입력 요청」 ──
  // 송금 완료: 언제·누가 눌렀나. 이 두 칸이 차 있어야 계좌분이 succeeded 가 된다(ck_refunds_transfer_account).
  transfer_completed_at                  DateTime(as: temporal)?
  transfer_completed_by_staff_account_id Uuid?
  transfer_completed_by_staff_account    StaffAccount?          @relation("RefundTransferCompletedBy", fields: [transfer_completed_by_staff_account_id], references: [id])
  // 다시 입력 요청: 이름이 달랐거나 반송돼 이 시도를 failed 로 닫은 시각과 이유. 회원이 새 계좌를 넣으면 다음 시도 행이 생긴다.
  reinput_requested_at         DateTime(as: temporal)?
  reinput_reason               RefundReinputReason?
  created_at                 DateTime(as: temporal) @default(now())
  updated_at                 DateTime(as: temporal)

  @@check(expression: sql`requested_amount >= 0`, name: "ck_refunds_requested_amount")
  @@check(expression: sql`refunded_amount >= 0`, name: "ck_refunds_refunded_amount")
  @@check(expression: sql`refunded_amount <= requested_amount`, name: "ck_refunds_amount_order")
  @@check(expression: sql`refund_rate_bp >= 0 AND refund_rate_bp <= 10000`, name: "ck_refunds_refund_rate_bp")
  @@index([idempotency_key], unique: true, name: "uq_refunds_idempotency_key")
  // 원인 칸은 넷이 함께 차거나 함께 빈다(옛 행). 새 행은 주문을 꼭 가리킨다.
  @@check(
    expression: sql`(basis_kind IS NULL) = (basis_id IS NULL) AND (basis_kind IS NULL) = (execution_kind IS NULL) AND (basis_kind IS NULL) = (executed_by IS NULL) AND (basis_kind IS NULL OR order_id IS NOT NULL)`,
    name: "ck_refunds_basis_complete"
  )
  @@check(expression: sql`cancel_fee_amount >= 0`, name: "ck_refunds_cancel_fee")
  @@check(expression: sql`attempt_no >= 1`, name: "ck_refunds_attempt_no")
  // 대표가 실행한 환불이면 누가 했는지 남는다.
  @@check(expression: sql`executed_by IS DISTINCT FROM 'owner' OR executed_by_staff_account_id IS NOT NULL`, name: "ck_refunds_executed_by_owner")
  // 옛 「예약당 활성 환불 1건」은 옛 행에만 남긴다 — 새 행은 원인 기준(D13)이라 한 예약에 휴강 환불 뒤 중도 환불이 될 수 있다.
  @@index([reservation_id], unique: true, where: sql`(status <> 'failed' AND basis_kind IS NULL)`, name: "uq_refunds_reservation_id_active")
  // 같은 원인으로 살아 있는(실패 아닌) 환불은 1건(FR-102 · D13). 실패한 시도는 빠지므로 다시 시도할 수 있다.
  @@index([basis_kind, basis_id], unique: true, where: sql`(status <> 'failed')`, name: "uq_refunds_basis_active")
  @@index([payment_id], name: "ix_refunds_payment_id")
  @@index([order_id], name: "ix_refunds_order")
  // 계좌 환불 송금 목록(W31·O48C)과 기한 경과 작업이 실행 방식·상태·기한 순으로 훑는다.
  @@index([execution_kind, status, transfer_due_at], name: "ix_refunds_transfer_list")
  // 계좌분이 「돌려줬다」가 되려면 보낼 계좌와 송금 완료 시각·누른 사람이 있어야 한다(data-model §9-3)
  @@check(
    expression: sql`execution_kind IS DISTINCT FROM 'owner_bank_transfer' OR status <> 'succeeded' OR (refund_account_id IS NOT NULL AND transfer_completed_at IS NOT NULL AND transfer_completed_by_staff_account_id IS NOT NULL)`,
    name: "ck_refunds_transfer_account"
  )
  // 다시 입력 요청은 실패로 닫은 시도에만, 시각과 이유가 함께 찬다
  @@check(expression: sql`(reinput_requested_at IS NULL) = (reinput_reason IS NULL) AND (reinput_requested_at IS NULL OR status = 'failed')`, name: "ck_refunds_reinput")
  @@map("refunds")
}

// 환불 감사 로그 — 추가 전용(UPDATE·DELETE 하지 않는다). event_type 6종은 앱 상수(§4.2).
model RefundEvent {
  id         Uuid                   @id
  refund_id  Uuid
  refund     Refund                 @relation(fields: [refund_id], references: [id], onDelete: Cascade)
  event_type String(storage: varchar, length: 50)
  payload    Json                   @default(sql`'{}'::jsonb`)
  created_at DateTime(as: temporal) @default(now())

  @@index([refund_id], name: "ix_refund_events_refund_id")
  @@map("refund_events")
}

// ───────────────────────── 환불 계좌·환불 요청 (S4-1.1(환불 요청·환불 계좌 테이블), data-model §9-3) ─────────────────────────

// 환불 계좌 상태 — 새로 입력하면 옛 행은 superseded 로 바뀌고 새 행이 active 가 된다(지운 기록 없이 쌓는다).
enum RefundAccountStatus {
  @@type("pg/text@1")
  active     = "active"
  superseded = "superseded"
}

// 환불 요청 종류(data-model §9-6) — 정규는 문의 경로로 대표가 처리, 이벤트형은 취소 신청(수수료 표대로 계산).
enum RefundRequestKind {
  @@type("pg/text@1")
  regular = "regular"
  event   = "event"
}

// 환불 요청 상태(M-06) — 상태 4종(접수·처리 중·완료·거절) + 철회. 회원 화면 C15A·C15B 와 내 예약 카드가 같은 값을 본다.
// 「처리 대기 중」은 저장하지 않는다 — now > answer_due_at 이고 received·in_progress 이면 화면이 계산한다.
enum RefundRequestStatus {
  @@type("pg/text@1")
  received    = "received"
  in_progress = "in_progress"
  completed   = "completed"
  rejected    = "rejected"
  withdrawn   = "withdrawn"
}

// 환불 요청 이유 — 추천값(data-model §9-3 열린 점 ⑥, spec 에 값 목록이 없다).
enum RefundRequestReasonKind {
  @@type("pg/text@1")
  personal        = "personal"
  schedule_change = "schedule_change"
  other           = "other"
}

// 대표의 결정 — 승인·거절, 또는 처리 기한이 지나 시스템이 카드분을 자동 실행한 경우(auto).
enum RefundRequestDecisionKind {
  @@type("pg/text@1")
  approved = "approved"
  rejected = "rejected"
  auto     = "auto"
}

// 이벤트형 취소 수수료 구간 — 환불 공지 판본 feeTiers.window(§7-6) 와 같은 이름이다.
enum RefundRequestFeeWindow {
  @@type("pg/text@1")
  same_day            = "same_day"
  paid_within_7d_full = "paid_within_7d_full"
  d10_plus            = "d10_plus"
  d9_d7               = "d9_d7"
  d6_d3               = "d6_d3"
  d2_to_deadline      = "d2_to_deadline"
}

// 환불 계좌 — 회원이 입력한 「환불받을 계좌」(FR-295 · M-07). 계좌 결제분 환불은 대표가 이 계좌로 직접 송금한다.
// 계좌번호 원문은 앱에서 암호화한 바이트로만 둔다(FR-299). 화면·로그·감사에는 가린 번호(account_masked)만 쓴다.
// 고치지 않고 쌓는다: 다시 입력하면 한 트랜잭션에서 옛 행 superseded + 새 행 active.
model RefundAccount {
  id                      Uuid                   @id
  order_id                Uuid
  order                   Order                  @relation(fields: [order_id], references: [id])
  // 입력한 사람 = 주문한 회원
  member_id               Uuid
  member                  Member                 @relation(fields: [member_id], references: [id])
  bank_code               String
  account_number_enc      Bytes
  // 저장할 때 만든 가린 번호. 예: 국민은행 ****-**-7890
  account_masked          String
  // 예금주 이름 — 대표가 이체 화면의 받는 사람 이름과 대조하는 칸(FR-295)
  holder_name             String
  // 본인확인 이름과 예금주가 같은가. 앱이 비교해 넣고, false 는 DB 가 아예 받지 않는다(본인 명의 계좌만).
  holder_matches_identity Boolean
  status                  RefundAccountStatus    @default(active)
  superseded_at           DateTime(as: temporal)?
  created_at              DateTime(as: temporal) @default(now())

  // 본인 명의가 아닌 계좌는 저장 자체가 안 된다 — 앱 검사를 건너뛴 쓰기도 DB 가 막는다.
  @@check(expression: sql`holder_matches_identity = true`, name: "ck_refund_accounts_holder_match")
  // 예금주 이름은 앞뒤 공백 없이 1~100자. 빈 이름으로는 이체 대조를 할 수 없다.
  @@check(expression: sql`holder_name = btrim(holder_name) AND char_length(holder_name) BETWEEN 1 AND 100`, name: "ck_refund_accounts_holder_name")
  // 바뀐(superseded) 계좌에만 바뀐 시각이 있다 — 상태와 시각이 어긋난 행을 막는다.
  @@check(expression: sql`(status = 'superseded') = (superseded_at IS NOT NULL)`, name: "ck_refund_accounts_superseded")
  // 주문 하나에 쓰는(active) 계좌는 하나. 바뀐 옛 계좌는 몇 개든 남는다.
  @@index([order_id], unique: true, where: sql`(status = 'active')`, name: "uq_refund_accounts_order_active")
  @@index([member_id], name: "ix_refund_accounts_member")
  @@map("refund_accounts")
}

// 환불 요청 — 회원과 대표 사이의 「환불해 주세요 → 처리」 대화 한 건(FR-098b · FR-293 · M-06).
// 돈이 실제로 나가는 한 번의 시도는 refunds 가 따로 맡는다: 요청 하나가 실패한 시도를 여럿 가질 수 있고,
// 요청 없이 생기는 환불(휴강·일괄 취소)도 있기 때문이다(data-model §9-3).
// 상태 전이는 UPDATE … WHERE status IN (:from) 조건부 갱신으로만 한다(S4-1.2·S4-1.4 가 만든다).
model RefundRequest {
  id                          Uuid                       @id
  order_id                    Uuid
  order                       Order                      @relation(fields: [order_id], references: [id])
  reservation_id              Uuid
  reservation                 Reservation                @relation(fields: [reservation_id], references: [id])
  // 대표 조회 범위를 바로 거르려고 학원 id 를 사본으로 둔다(주문 → 수업을 매번 따라가지 않는다).
  academy_id                  Uuid
  academy                     Academy                    @relation(fields: [academy_id], references: [id])
  member_id                   Uuid
  member                      Member                     @relation(fields: [member_id], references: [id])
  kind                        RefundRequestKind
  status                      RefundRequestStatus        @default(received)
  reason_kind                 RefundRequestReasonKind
  reason_text                 String?
  // 「바라는 것」(C15B) — 회원이 원하는 처리를 글로 적는다
  desired_text                String?
  // 계좌 결제분이면 환불받을 계좌. 카드는 원거래 취소라 비어 있다.
  refund_account_id           Uuid?
  refund_account              RefundAccount?             @relation(fields: [refund_account_id], references: [id])
  // 주문이 동의한 환불 공지 판본의 사본 — 대표가 근거 항목을 이 판본에서 고른다.
  notice_version_id           Uuid
  notice_version              RefundNoticeVersion        @relation(fields: [notice_version_id], references: [id])
  received_at                 DateTime(as: temporal)     @default(now())
  // 처리 기한 — 정규 = 접수 + 3영업일(O-09 추천값), 이벤트형 = 접수 + 판본의 processingBusinessDays(상한 3)
  answer_due_at               DateTime(as: temporal)
  due_soon_notified_at        DateTime(as: temporal)?
  overdue_notified_at         DateTime(as: temporal)?
  in_progress_at              DateTime(as: temporal)?
  decision_kind               RefundRequestDecisionKind?
  decided_at                  DateTime(as: temporal)?
  decided_by_staff_account_id Uuid?
  decided_by_staff_account    StaffAccount?              @relation(fields: [decided_by_staff_account_id], references: [id])
  decided_amount              Int?
  // 근거가 된 공지 항목. 예: tier:before_one_third · no_refund_case · window:d9_d7
  notice_item_code            String?
  // 대표 한마디(회원에게 보인다)
  decision_note               String?
  // 공지 기준 %로 미리 채운 금액(정규) / 수수료 표로 계산한 금액(이벤트형)
  suggested_amount            Int?
  base_amount                 Int?
  cancel_fee_bp               Int?
  cancel_fee_amount           Int?
  fee_window                  RefundRequestFeeWindow?
  withdrawn_at                DateTime(as: temporal)?
  completed_at                DateTime(as: temporal)?
  // 시간·장소 변경 알림에서 들어온 요청이면 그 변경 기록 id(S4-3.6). 외래 키는 그 표가 확정된 뒤 건다.
  change_ref_id               Uuid?
  idempotency_key             String
  created_at                  DateTime(as: temporal)     @default(now())
  updated_at                  DateTime(as: temporal)     @default(now())

  // 끝난 상태에는 끝난 시각이 있다 — 완료·거절은 결정 시각, 완료는 완료 시각, 철회는 철회 시각.
  @@check(
    expression: sql`(status NOT IN ('completed', 'rejected') OR decided_at IS NOT NULL) AND (status <> 'completed' OR completed_at IS NOT NULL) AND (status <> 'withdrawn' OR withdrawn_at IS NOT NULL)`,
    name: "ck_refund_requests_decided"
  )
  // 이벤트형은 거절도 철회도 없다 — 대표는 환불액을 올리는 조정만 하고(FR-293), 취소는 자리를 바로 푼다.
  @@check(
    expression: sql`kind <> 'event' OR (decision_kind IS DISTINCT FROM 'rejected' AND status <> 'withdrawn')`,
    name: "ck_refund_requests_event_final"
  )
  // 정한 환불액은 0원 이상(결제액 상한은 S4-1.4 가 주문 금액과 비교해 막는다 — 행 사이 비교라 CHECK 로 못 건다).
  @@check(expression: sql`decided_amount IS NULL OR decided_amount >= 0`, name: "ck_refund_requests_amount")
  // 계산 보조 금액도 음수가 없고, 수수료 비율은 0~10000bp(1bp = 0.01%).
  @@check(
    expression: sql`(suggested_amount IS NULL OR suggested_amount >= 0) AND (base_amount IS NULL OR base_amount >= 0) AND (cancel_fee_amount IS NULL OR cancel_fee_amount >= 0) AND (cancel_fee_bp IS NULL OR cancel_fee_bp BETWEEN 0 AND 10000)`,
    name: "ck_refund_requests_calc_amounts"
  )
  // 거절해도 근거 공지 항목을 고른다(FR-293).
  @@check(expression: sql`decision_kind IS DISTINCT FROM 'rejected' OR notice_item_code IS NOT NULL`, name: "ck_refund_requests_reject_item")
  // 이벤트형은 계산값보다 올리기만 한다 — 앱 검사와 같은 식을 DB 가 한 번 더 막는다.
  @@check(
    expression: sql`kind <> 'event' OR decided_amount IS NULL OR suggested_amount IS NULL OR decided_amount >= suggested_amount`,
    name: "ck_refund_requests_event_amount"
  )
  // 글 칸은 500자 이하.
  @@check(
    expression: sql`(reason_text IS NULL OR char_length(reason_text) <= 500) AND (desired_text IS NULL OR char_length(desired_text) <= 500) AND (decision_note IS NULL OR char_length(decision_note) <= 500)`,
    name: "ck_refund_requests_text_len"
  )
  // 같은 회원이 같은 열쇠로 다시 보내면 같은 행이다(재생 = 한 번).
  @@index([member_id, idempotency_key], unique: true, name: "uq_refund_requests_idem")
  // 한 예약에 처리 전(접수·처리 중) 요청은 하나뿐이다.
  @@index([reservation_id], unique: true, where: sql`(status IN ('received', 'in_progress'))`, name: "uq_refund_requests_open")
  // 대표 목록·기한 재알림 작업이 학원·상태·기한 순으로 훑는다.
  @@index([academy_id, status, answer_due_at], name: "ix_refund_requests_academy_due")
  // 회원 내 요청 목록(최근순). 설계의 created_at DESC 는 계약 문법에 없어 오름차순으로 둔다 — btree 는 거꾸로도 읽는다.
  @@index([member_id, created_at], name: "ix_refund_requests_member")
  @@map("refund_requests")
}

// ───────────────────────── 21~23. 직원 계정·역할·감사 기록 (S0-2.2, data-model §7-2·§7-7) ─────────────────────────

// 계정 상태 — data-model §7-2. active → suspended(가입 거절·사후 해지) ↔ active / → withdrawn(끝).
enum StaffAccountStatus {
  @@type("pg/text@1")
  active    = "active"
  suspended = "suspended"
  withdrawn = "withdrawn"
}

// 역할 4종 중 직원 역할 3종. Dancer 는 members 행으로 갖는다(data-model §7-2) — FR-004(역할 구분).
// 직원 계정은 회원 계정과 다른 계정(FR-011a)이라 여기에 dancer 를 넣지 않는다.
// 한 계정이 여러 역할을 가질 수 있어 role_grants 에 행으로 둔다.
enum RoleName {
  @@type("pg/text@1")
  instructor = "instructor"
  owner      = "owner"
  admin      = "admin"
}

enum RoleGrantStatus {
  @@type("pg/text@1")
  active  = "active"
  revoked = "revoked"
}

// 감사 기록을 남긴 쪽 — 직원 계정 · 회원 · 시스템(스케줄러·플랫폼 스크립트).
enum AuditActorKind {
  @@type("pg/text@1")
  staff  = "staff"
  member = "member"
  system = "system"
}

// 직원 계정 — 강사·대표·운영자의 로그인 계정. 회원(members)과는 다른 계정이다(FR-011a: 앱 둘·서버 하나).
// 한 사람이 둘 다 가질 수 있어도 둘을 잇는 칸은 두지 않는다. 필요하면 identity_ci_hash 로 맞춘다.
model StaffAccount {
  id               Uuid                   @id
  // Better Auth 의 auth.user.id. 아이디는 Better Auth username 플러그인 칸이다.
  auth_user_id     String
  display_name     String
  // 본인확인 CI 해시 — 한 사람 한 강사 계정(FR-011). NULL 이면 아직 본인확인 전.
  identity_ci_hash String?
  birth_date       Date?
  phone_enc        Bytes?
  phone_masked     String?
  status           StaffAccountStatus     @default(active)
  created_at       DateTime(as: temporal) @default(now())
  updated_at       DateTime(as: temporal)
  role_grants      RoleGrant[]
  audit_logs       AuditLog[]
  platform_fee_rates PlatformFeeRate[]
  holidays           Holiday[]
  academy_owners          AcademyOwner[]
  instructor_affiliations InstructorAffiliation[]
  // 입점 신청 · 올린 파일 · 예금주를 확인한 정산 계좌 — DB 칸이 아니라 관계다(S1-1.2).
  merchant_applications   MerchantApplication[]
  uploaded_files          UploadedFile[]
  verified_payout_accounts AcademyPayoutAccount[]
  // 이 계정이 누른 입점 동의 — DB 칸이 아니라 관계다(S1-1.3).
  merchant_consents        MerchantConsent[]
  // 이 계정이 푼 학원 제한 — DB 칸이 아니라 관계다(S1-1.4).
  ended_restrictions       AcademyRestriction[]
  // 이 계정이 받은 직원 알림 — DB 칸이 아니라 관계다(S1-4.2).
  notifications            Notification[]
  // 이 계정이 정한 강사 몫 비율 — DB 칸이 아니라 관계다(S1-2.2).
  share_rates_created          InstructorShareRate[]
  share_rate_overrides_created InstructorShareRateOverride[]
  // 이 계정이 올린 환불·취소 공지 판본 — DB 칸이 아니라 관계다(S1-3.1).
  refund_notices_created       RefundNoticeVersion[]
  // 이 계정이 쓴 학원 공지 · 받은 학원 공지 — DB 칸이 아니라 관계다(S1-4.1).
  staff_notices_authored       AcademyStaffNotice[]
  staff_notices_received       AcademyStaffNoticeRecipient[]
  // 강사 프로필 · 활동 지역 · 자격 · 개인 일정 — DB 칸이 아니라 관계다(S2-1.1).
  instructor_profile           InstructorProfile?
  instructor_regions           InstructorRegion[]
  instructor_credentials       InstructorCredential[]
  instructor_personal_events   InstructorPersonalEvent[]
  // 직원 계정 가입 때 동의한 약관 판본 — 강사 가입의 필수 동의 둘(S2-1.2).
  staff_consents               StaffConsent[]
  // 강사가 낸 소속 해제 요청 · 대표가 처리(완료·거절)한 해제 요청 — DB 칸이 아니라 관계다(S2-1.4).
  release_requests_made        AffiliationReleaseRequest[] @relation(name: "release_request_requester")
  release_requests_resolved    AffiliationReleaseRequest[] @relation(name: "release_request_resolver")
  // 이 계정이 승인한 수업 · 이 계정이 남긴 수업 승인 기록 — DB 칸이 아니라 관계다(S2-2.1).
  classes_approved             Class[]                     @relation(name: "class_approver")
  class_approvals_made         ClassApproval[]
  // 담당 강사인 수업 · 올린 수업 · 가르치는 회차 — DB 칸이 아니라 관계다(S2-2.3).
  classes_instructing          Class[]                     @relation(name: "class_instructor")
  classes_created              Class[]                     @relation(name: "class_creator")
  sessions_instructing         ClassSession[]              @relation(name: "session_instructor")
  // 이 계정이 남긴 회차 변경 · 낸 대타 요청 · 수락한 대타 · 확인한 대타 · 후보로 받은 대타 — DB 칸이 아니라 관계다(S2-3.1).
  session_changes_made         SessionChange[]             @relation(name: "session_change_actor")
  substitute_requests_made     SubstituteRequest[]         @relation(name: "substitute_requester")
  substitute_requests_accepted SubstituteRequest[]         @relation(name: "substitute_accepted_candidate")
  substitute_requests_confirmed SubstituteRequest[]        @relation(name: "substitute_confirmer")
  substitute_candidacies       SubstituteRequestCandidate[] @relation(name: "substitute_candidate")
  // 이 계정이 쓴 강사 수업 공지 — DB 칸이 아니라 관계다(S2-3.5).
  class_announcements_written  ClassAnnouncement[]         @relation(name: "class_announcement_author")
  // 이 계정이 낸 · 결정한 공개 뒤 수업 수정 요청 — DB 칸이 아니라 관계다(S2-3.12).
  class_edit_requests_made     ClassEditRequest[]          @relation(name: "class_edit_requester")
  class_edit_requests_decided  ClassEditRequest[]          @relation(name: "class_edit_decider")
  // 이 계정이 올린 · 검토 끝을 누른 포스터 읽기 — DB 칸이 아니라 관계다(SX-2.3).
  poster_extractions_uploaded  PosterExtraction[]          @relation(name: "poster_uploader")
  poster_extractions_reviewed  PosterExtraction[]          @relation(name: "poster_reviewer")
  // 이 계정이 만든 홍보 이미지 · 날짜별 만든 횟수 — DB 칸이 아니라 관계다(SX-6.5).
  promo_image_generations      PromoImageGeneration[]
  promo_image_usage            PromoImageUsage[]
  // 이 계정이 받은 소개 문구 초안 — DB 칸이 아니라 관계다(SX-6.6).
  class_intro_drafts           ClassIntroDraft[]
  // 이 계정이 「검토 끝」을 누른 수업 홍보 자료 — DB 칸이 아니라 관계다(SX-6.7).
  class_promo_assets_reviewed  ClassPromoAsset[]
  // 이 계정의 휴대폰 알림 설정 · 기기 푸시 토큰 — DB 칸이 아니라 관계다(S7-1.2).
  staff_notification_settings  StaffNotificationSetting[]
  push_tokens                  PushToken[]
  // 이 계정이 쓴 문의 · 문의 글 · 낸 신고 · 처리한 신고 — DB 칸이 아니라 관계다(S7-2.1).
  inquiries                    Inquiry[]
  inquiry_messages             InquiryMessage[]
  reports_filed                Report[]                    @relation(name: "report_reporter")
  reports_resolved             Report[]                    @relation(name: "report_resolver")
  // 이 강사에게 열린 이용 제한 절차 · 이 운영자가 열거나 닫은 절차 — DB 칸이 아니라 관계다(S7-2.6).
  restriction_cases_subject    RestrictionCase[]           @relation(name: "restriction_subject_staff")
  restriction_cases_opened     RestrictionCase[]           @relation(name: "restriction_opened_by")
  restriction_explanations     RestrictionExplanation[]
  restriction_cases_closed     RestrictionCase[]           @relation(name: "restriction_closed_by")
  // 이 강사가 매긴 평가 레벨 · 보낸 레벨 제안 — DB 칸이 아니라 관계다(S6-3.1).
  level_evaluations            InstructorLevelEvaluation[]
  level_offers                 LevelOffer[]

  @@index([auth_user_id], unique: true, name: "uq_staff_accounts_auth_user_id")
  // NULL 은 여러 개여도 되고, 값이 있으면 한 사람 한 계정이다.
  @@index([identity_ci_hash], unique: true, where: sql`(identity_ci_hash IS NOT NULL)`, name: "uq_staff_accounts_ci")
  @@map("staff_accounts")
}

// 역할 부여 — 계정 하나에 역할 여러 개. 취소해도 지우지 않고 revoked 로 남긴다(이력).
// 부여 경로: instructor = 강사 가입 · owner = 입점 승인 · admin = 플랫폼 스크립트만(API 없음, FR-303).
model RoleGrant {
  id                    Uuid                   @id
  staff_account_id      Uuid
  staff_account         StaffAccount           @relation(fields: [staff_account_id], references: [id])
  role                  RoleName
  status                RoleGrantStatus        @default(active)
  // NULL = 시스템·플랫폼이 부여.
  granted_by_account_id Uuid?
  granted_at            DateTime(as: temporal) @default(now())
  revoked_at            DateTime(as: temporal)?

  // 취소(revoked)했으면 취소 시각이 있고, 아직 active 면 없다 — 서로 짝이 맞아야 한다.
  @@check(expression: sql`(status = 'revoked') = (revoked_at IS NOT NULL)`, name: "ck_role_grants_revoked")
  // 같은 계정에 같은 역할이 동시에 둘 active 일 수 없다(취소된 행은 몇 개든 된다).
  @@index([staff_account_id, role], unique: true, where: sql`(status = 'active')`, name: "uq_role_grants_active")
  @@map("role_grants")
}

// 감사 기록 — 추가 전용. 수정·삭제는 DB 트리거가 막는다(마이그레이션 rawSql, 계약으로는 표현되지 않는다).
// 수행자·시각·대상·전후 값을 남긴다(플랜 6-6). 감사 대상 테이블을 바꾸는 쓰기는 같은 트랜잭션에서 1행을 쓴다.
model AuditLog {
  id                     Uuid                   @id
  occurred_at            DateTime(as: temporal) @default(now())
  actor_kind             AuditActorKind
  actor_staff_account_id Uuid?
  actor_staff_account    StaffAccount?          @relation(fields: [actor_staff_account_id], references: [id])
  actor_member_id        Uuid?
  actor_member           Member?                @relation(fields: [actor_member_id], references: [id])
  // 그때 쓴 역할(예: owner). 시스템 행은 NULL.
  actor_role             String?
  academy_id             Uuid?
  action                 String
  target_table           String
  target_id              Uuid
  before                 Json?
  after                  Json?
  reason                 String?
  request_id             String?
  ip_hash                String?

  // 수행자 종류와 id 칸의 짝이 맞아야 한다: staff 면 직원 id 만, member 면 회원 id 만, system 이면 둘 다 비어 있다.
  @@check(
    expression: sql`(actor_kind = 'staff' AND actor_staff_account_id IS NOT NULL AND actor_member_id IS NULL) OR (actor_kind = 'member' AND actor_member_id IS NOT NULL AND actor_staff_account_id IS NULL) OR (actor_kind = 'system' AND actor_staff_account_id IS NULL AND actor_member_id IS NULL)`,
    name: "ck_audit_actor"
  )
  @@index([academy_id, occurred_at], name: "ix_audit_academy_time")
  @@index([target_table, target_id], name: "ix_audit_target")
  @@map("audit_logs")
}

// 플랫폼 수수료율 분류 — 일반 수업·행사 / 개인 레슨(data-model §7-8b, 결정 12·13).
enum PlatformFeeCategory {
  @@type("pg/text@1")
  general        = "general"
  private_lesson = "private_lesson"
}

// 플랫폼 수수료율 표 — 분류별 요율을 시작일(effective_from)마다 한 행씩 쌓는다. 칸만 만들고 쓰는 곳은 S5-1(정산)이다.
// 요율은 만분율(bp)이다: 500 = 5%, 100 = 1%. 시드(일반 500·개인 레슨 100)는 마이그레이션 안에 들어 있다.
// onboarding_exemption_applies: 입점 1년 면제를 이 분류에 적용하나 — 일반은 true, 개인 레슨은 false(결정 13).
model PlatformFeeRate {
  id                          Uuid                   @id
  fee_category                PlatformFeeCategory
  rate_bp                     Int
  onboarding_exemption_applies Boolean
  effective_from              DateTime(as: temporal)
  // 운영자가 바꾼 행이면 그 직원 계정. 시드 행은 NULL.
  created_by_account_id       Uuid?
  created_by_account          StaffAccount?          @relation(fields: [created_by_account_id], references: [id])
  created_at                  DateTime(as: temporal) @default(now())

  @@check(expression: sql`rate_bp BETWEEN 0 AND 10000`, name: "ck_platform_fee_bp")
  // 같은 분류에 같은 시작일 행은 둘일 수 없다.
  @@index([fee_category, effective_from], unique: true, name: "uq_platform_fee")
  @@map("platform_fee_rates")
}

// 공휴일 종류 — 법정 공휴일 / 대체 공휴일 / 임시 공휴일(data-model §10-13).
enum HolidayKind {
  @@type("pg/text@1")
  holiday            = "holiday"
  substitute_holiday = "substitute_holiday"
  temporary_holiday  = "temporary_holiday"
}

// 공휴일 줄의 출처 — 특일 정보 API 자동 수집(api) / 운영자가 직접 넣음(operator).
enum HolidaySource {
  @@type("pg/text@1")
  api      = "api"
  operator = "operator"
}

// 공휴일 표 — 영업일 계산(S0-4.8)이 읽는 유일한 원천이다(data-model §10-13, Q35(정산일이 주말·공휴일일 때)).
// 자동 수집(S0-4.10)이 하루 한 번 채우고, 임시공휴일처럼 API 가 못 주는 날은 운영자가 넣는다(P9).
// 운영자 줄은 지울 때 행을 없애지 않고 deleted_at 을 채운다 — 언제 무엇이 공휴일이었는지 기록이 남아야 지난 기한 계산을 다시 설명할 수 있다.
model Holiday {
  id                    Uuid                   @id
  date                  Date
  name                  String
  kind                  HolidayKind
  source                HolidaySource
  // 운영자가 넣은 줄이면 그 직원 계정. 자동 수집 줄은 NULL.
  created_by_account_id Uuid?
  created_by_account    StaffAccount?          @relation(fields: [created_by_account_id], references: [id])
  created_at            DateTime(as: temporal) @default(now())
  updated_at            DateTime(as: temporal) @default(now())
  deleted_at            DateTime(as: temporal)?

  // 운영자 줄에는 넣은 사람이 꼭 있고, 자동 줄에는 없다 — 출처와 계정 칸이 짝이 맞아야 한다.
  @@check(expression: sql`(source = 'operator') = (created_by_account_id IS NOT NULL)`, name: "ck_holidays_operator")
  // 자동 수집 줄은 지울 수 없다(고치기 금지는 API 가 409 HOLIDAY_NOT_EDITABLE 로 막는다).
  @@check(expression: sql`source <> 'api' OR deleted_at IS NULL`, name: "ck_holidays_api_not_deleted")
  // 살아 있는 줄 중에서는 한 날짜에 한 줄뿐이다. 지운(deleted_at 이 찬) 줄은 같은 날짜에 몇 개든 남는다.
  @@index([date], unique: true, where: sql`(deleted_at IS NULL)`, name: "uq_holidays_date")
  @@map("holidays")
}

// 공휴일 자동 수집 결과 — 성공 / 실패(data-model §10-13).
enum HolidaySyncStatus {
  @@type("pg/text@1")
  success = "success"
  failed  = "failed"
}

// 공휴일 자동 수집 기록 — 추가 전용(data-model §10-13, S0-4.10(특일 정보 수집 작업)).
// 하루 한 번 도는 작업이 연도마다 한 줄을 남긴다. P9 상단 「마지막 자동 수집 … 성공/실패」가 이 표를 읽는다.
// 실패하면 holidays 는 그대로 두고 이 줄(status=failed, error_code)만 남긴다 — 운영자가 실패를 알아챌 수 있는 기록이다.
model HolidaySyncRun {
  id            Uuid                   @id
  ran_at        DateTime(as: temporal) @default(now())
  // 출처는 지금 하나뿐이다 — 공공데이터포털 「한국천문연구원 특일 정보」.
  source        String                 @default("kasi_special_days")
  year          Int
  status        HolidaySyncStatus
  // 이 회차에 새로 넣거나 이름·종류가 바뀐 공휴일 줄 수. 실패면 0.
  rows_upserted Int                    @default(0)
  // 실패 원인 코드(예: HTTP_ERROR). 성공이면 비어 있고, 실패면 꼭 있다.
  error_code    String?

  @@check(expression: sql`source = 'kasi_special_days'`, name: "ck_holiday_sync_source")
  @@check(expression: sql`(status = 'failed') = (error_code IS NOT NULL)`, name: "ck_holiday_sync_error")
  @@check(expression: sql`rows_upserted >= 0 AND (status = 'success' OR rows_upserted = 0)`, name: "ck_holiday_sync_rows")
  @@index([ran_at], name: "ix_holiday_sync_ran")
  @@map("holiday_sync_runs")
}

// ───────────────────────── 가드용 학원·대표·소속·위임 최소 테이블 (S0-3.5a, data-model §7-3·§7-5) ─────────────────────────
// requireStaff 가드(S0-3.6)는 권한을 세션에 복사하지 않고 요청마다 이 표들을 읽는다(data-model §7 머리 — O-11(위임 끄면 즉시 차단)).
// 그래서 가드보다 먼저 표가 있어야 한다. 학원(academies)은 S0-2.1 이 이미 만들었고, 입점 칸 추가는 S1-1.1 이 한다.
// 이 절은 §7-3 academy_owners 와 §7-5 instructor_affiliations·instructor_invites·instructor_delegations 의 칸·제약을 그대로 옮긴다.

// 학원 대표 자리 상태 — 지금 대표(active) / 물러난 대표(ended). 행을 지우지 않고 끝내서 이력을 남긴다.
enum AcademyOwnerStatus {
  @@type("pg/text@1")
  active = "active"
  ended  = "ended"
}

// 소속 상태 — data-model §7-5. pending → active(대표 승인) · rejected(사유 필수) · withdrawn(강사 취소) / active → released.
// 초대 링크로 들어와도 pending 으로 시작한다(2026-11-19 결정 3). 끝난 뒤 다시 신청하면 새 행이다.
enum AffiliationStatus {
  @@type("pg/text@1")
  pending   = "pending"
  active    = "active"
  rejected  = "rejected"
  withdrawn = "withdrawn"
  released  = "released"
}

// 소속 경로 — 강사가 직접 신청(application) / 대표가 보낸 초대 링크(invite).
enum AffiliationSource {
  @@type("pg/text@1")
  application = "application"
  invite      = "invite"
}

// 소속 거절 사유 — FR-071(소속 강사 관리).
enum AffiliationRejectReason {
  @@type("pg/text@1")
  not_recruiting = "not_recruiting"
  genre_mismatch = "genre_mismatch"
  info_needed    = "info_needed"
  other          = "other"
}

// 소속 해제를 누가 시작했나 — 대표(owner) / 강사 본인(instructor). FR-082(소속 해제).
enum AffiliationReleaseInitiator {
  @@type("pg/text@1")
  owner      = "owner"
  instructor = "instructor"
}

// 강사가 시작한 소속 해제 요청의 상태 — data-model §8-7(S2-1.4).
// requested(대기) → completed(대표가 해제를 끝냄) · withdrawn(강사가 취소) · declined(대표가 거절).
enum AffiliationReleaseRequestStatus {
  @@type("pg/text@1")
  requested = "requested"
  completed = "completed"
  withdrawn = "withdrawn"
  declined  = "declined"
}

// 위임 3종 — 관리자 웹 2종(FR-081a(위임 가능한 관리 권한)) + 앱 1종, 2026-11-20 사용자 결정 D3.
//   roster_manage = 예약·명단(전체 수강생 조회 + 인원 관리) · class_manage = 수업·포스터 등록(수업 등록과 취소).
//   class_submit  = 앱 수업 등록 권한(O31·O38) — 웹 메뉴를 열지 않는 별개 권한이다(S1-2.9(위임 권한 켜고 끄기 API)).
// 매출·정산·금액 위임은 값 자체를 두지 않는다. 앱 쪽 짝은 lib/domain/permissions.ts 의
// DELEGATION_PERMISSIONS(웹 2종) · APP_DELEGATION_PERMISSIONS(앱 1종) 다.
enum DelegationPermission {
  @@type("pg/text@1")
  roster_manage = "roster_manage"
  class_manage  = "class_manage"
  class_submit  = "class_submit"
}

// 학원 ↔ 대표 — data-model §7-3. 감사 ○.
// 가드가 「이 직원이 이 학원의 대표인가」를 이 표의 active 행으로 판정한다.
// 학원당 active 대표는 한 명뿐이다(7-12 ④ 확정). 대표가 바뀌면 옛 행을 ended 로 닫고 새 행을 연다.
model AcademyOwner {
  id               Uuid                    @id
  academy_id       Uuid
  academy          Academy                 @relation(fields: [academy_id], references: [id])
  staff_account_id Uuid
  staff_account    StaffAccount            @relation(fields: [staff_account_id], references: [id])
  status           AcademyOwnerStatus      @default(active)
  started_at       DateTime(as: temporal)  @default(now())
  ended_at         DateTime(as: temporal)?

  // 학원 하나에 active 대표는 하나. ended 행은 몇 개든 남는다.
  @@index([academy_id], unique: true, where: sql`(status = 'active')`, name: "uq_academy_owners_active")
  // 가드가 「이 계정이 대표인 학원 목록」을 찾을 때 쓰는 색인.
  @@index([staff_account_id, status], name: "ix_academy_owners_account")
  @@map("academy_owners")
}

// 강사 초대 링크 — data-model §7-5. 감사 ○(만들기·폐기).
// 링크 원문 토큰은 저장하지 않고 sha256 해시만 둔다(DB 가 새도 링크를 못 쓴다).
// 유효 = used_at IS NULL AND revoked_at IS NULL AND expires_at > now(). 7일·1회용은 추천값이라 앱이 정한다.
model InstructorInvite {
  id                    Uuid                    @id
  academy_id            Uuid
  academy               Academy                 @relation(fields: [academy_id], references: [id])
  created_by_account_id Uuid
  token_hash            String
  expires_at            DateTime(as: temporal)
  used_at               DateTime(as: temporal)?
  used_by_account_id    Uuid?
  revoked_at            DateTime(as: temporal)?
  created_at            DateTime(as: temporal)  @default(now())
  affiliations          InstructorAffiliation[]

  // 썼으면 쓴 사람과 시각이 둘 다 있고, 안 썼으면 둘 다 없다.
  @@check(expression: sql`(used_at IS NULL) = (used_by_account_id IS NULL)`, name: "ck_invites_used")
  // 만료 시각은 만든 시각보다 뒤여야 한다.
  @@check(expression: sql`expires_at > created_at`, name: "ck_invites_expiry")
  @@index([token_hash], unique: true, name: "uq_invites_token_hash")
  @@map("instructor_invites")
}

// 강사 소속 — data-model §7-5. 감사 ○.
// 가드는 status = 'active' 인 행만 「그 학원 소속」으로 본다. 대기·거절·해제 행은 권한을 주지 않는다.
model InstructorAffiliation {
  id                    Uuid                         @id
  academy_id            Uuid
  academy               Academy                      @relation(fields: [academy_id], references: [id])
  instructor_account_id Uuid
  instructor_account    StaffAccount                 @relation(fields: [instructor_account_id], references: [id])
  status                AffiliationStatus            @default(pending)
  source                AffiliationSource
  invite_id             Uuid?
  invite                InstructorInvite?            @relation(fields: [invite_id], references: [id])
  applicant_message     String?
  // 학원 직원 강사 표시(FR-127) — 켜면 강사 몫이 학원 매출로 들어간다(정산 영향).
  is_academy_employee   Boolean                      @default(false)
  requested_at          DateTime(as: temporal)       @default(now())
  decided_at            DateTime(as: temporal)?
  decided_by_account_id Uuid?
  reject_reason_code    AffiliationRejectReason?
  reject_reason_text    String?
  released_at           DateTime(as: temporal)?
  release_initiated_by  AffiliationReleaseInitiator?
  // 열린 해제 요청이 있는지 한눈에 보려는 비정규 칸(S2-1.4). 원본은 affiliation_release_requests 다.
  release_requested_at  DateTime(as: temporal)?
  // 학원 색(S2-1.9, I12·I9E) — 12색 팔레트의 번호 0~11 만 저장한다. 이름·값은 앱 상수(lib/domain/academy-colors.ts).
  // 강사 본인 화면에만 쓰인다. 승인(active) 때 그 강사가 아직 안 쓴 가장 작은 번호가 들어간다(추천안).
  calendar_color_index  Int?
  created_at            DateTime(as: temporal)       @default(now())
  updated_at            DateTime(as: temporal)
  delegations           InstructorDelegation[]
  // 강사가 시작한 해제 요청들 — DB 칸이 아니라 관계다(S2-1.4).
  release_requests      AffiliationReleaseRequest[]
  // 강사 몫 비율 판본 · 수업별 예외 — DB 칸이 아니라 관계다(S1-2.2).
  share_rates           InstructorShareRate[]
  share_rate_overrides  InstructorShareRateOverride[]

  // 초대로 들어온 행에는 초대 id 가 꼭 있고, 직접 신청 행에는 없다.
  @@check(expression: sql`(source = 'invite') = (invite_id IS NOT NULL)`, name: "ck_aff_source_invite")
  // 거절 행에는 정해진 사유 코드가 꼭 있다.
  @@check(expression: sql`(status = 'rejected') = (reject_reason_code IS NOT NULL)`, name: "ck_aff_rejected")
  // 학원 색 번호는 12색 범위 안(0~11)이거나 비어 있다.
  @@check(expression: sql`calendar_color_index IS NULL OR calendar_color_index BETWEEN 0 AND 11`, name: "ck_aff_color")
  // 같은 학원·같은 강사에 열린(대기·소속) 행은 하나뿐이다. 끝난 행은 몇 개든 남는다.
  @@index([academy_id, instructor_account_id], unique: true, where: sql`(status IN ('pending', 'active'))`, name: "uq_affiliations_open")
  @@index([academy_id, status], name: "ix_aff_academy_status")
  @@index([instructor_account_id, status], name: "ix_aff_instructor")
  @@map("instructor_affiliations")
}

// 강사 위임 — data-model §7-5. 감사 ○(전후 값 = 권한 집합).
// 「지금 켜진 위임」만 둔다. 끄면 행을 지우고, 이력은 audit_logs 에 남긴다.
// 행이 지워지면 다음 요청부터 가드가 막는다 — 세션에 복사해 두지 않기 때문이다.
model InstructorDelegation {
  affiliation_id        Uuid
  affiliation           InstructorAffiliation  @relation(fields: [affiliation_id], references: [id])
  permission            DelegationPermission
  granted_at            DateTime(as: temporal) @default(now())
  granted_by_account_id Uuid

  // 한 소속에 같은 위임은 한 번만 켠다.
  @@id([affiliation_id, permission])
  @@map("instructor_delegations")
}

// ───────────────────────── 강사 몫 비율 (S1-2.2(강사 몫 비율 테이블), data-model §7-5, 결정 11) ─────────────────────────
// 대표가 소속 강사마다 「수업료 중 강사에게 가는 몫」을 정한다. 비율은 만분율(bp)이다: 10000 = 100%, 6000 = 60%.
// 두 표 모두 행을 고치지 않고 쌓는다(판본). 비율을 바꾸면 더 늦은 시작일(effective_from) 행을 하나 더 넣는다.
// 결제 하나에 맞는 비율 = 그 결제 시각(orders.paid_at) 이전에 시작한 행 중 가장 늦은 것.
// 그래서 「바꾼 뒤 결제분부터 새 비율」이 되고, 이미 계산한 지급액은 그대로 남는다.
// 표만 여기서 만들고, 쓰는 곳은 소속 승인(첫 행 만들기, S1-2)과 정산(S5-1)이다.

// 강사 기본 몫 비율 — 소속 하나에 판본 여러 개. 기본값은 두지 않는다(승인 트랜잭션이 첫 행을 꼭 만든다).
model InstructorShareRate {
  id                    Uuid                   @id
  affiliation_id        Uuid
  affiliation           InstructorAffiliation  @relation(fields: [affiliation_id], references: [id])
  rate_bp               Int
  effective_from        DateTime(as: temporal)
  // 비율을 정한 사람(대표 또는 위임받은 직원) — 감사 기록 share_rate.changed 와 짝이다.
  created_by_account_id Uuid
  created_by_account    StaffAccount           @relation(fields: [created_by_account_id], references: [id])
  created_at            DateTime(as: temporal) @default(now())

  // 비율은 0%~100% 사이만 된다.
  @@check(expression: sql`rate_bp BETWEEN 0 AND 10000`, name: "ck_share_rate_bp")
  // 한 소속에 같은 시작일 판본은 하나뿐이다. 이 유니크 색인이 「결제 시각에 맞는 판본 찾기」 조회도 맡는다.
  // 설계는 ix_share_rates_aff_from (affiliation_id, effective_from DESC) 를 따로 두지만, 계약 문법에 정렬 방향 인자가 없고
  // PostgreSQL 은 B-tree 를 거꾸로도 읽으므로 같은 칸의 색인을 하나 더 만들 까닭이 없다(ix_bsc_academy_checked 와 같은 방식).
  @@index([affiliation_id, effective_from], unique: true, name: "uq_share_rates_aff_from")
  @@map("instructor_share_rates")
}

// 수업별 예외 비율 — 개인 레슨도 classes 의 한 행(class_kind = 'private_lesson')이라 같은 표에 둔다.
// 판정: 그 수업의 예외가 결제 시각에 있으면 그 값, 없으면 위 기본 비율. 수업이 생기는 M2 부터 쓴다.
model InstructorShareRateOverride {
  id                    Uuid                   @id
  affiliation_id        Uuid
  affiliation           InstructorAffiliation  @relation(fields: [affiliation_id], references: [id])
  class_id              Uuid
  class                 Class                  @relation(fields: [class_id], references: [id])
  // NULL = 「이 판본부터는 예외 없음, 기본 비율을 따른다」(계약 08 §4-1 의 rateBp: null — S1-2.10).
  // 예외를 끌 때 옛 행을 지우면 끄기 전 결제분까지 기본 비율로 계산돼 버린다. 그래서 지우지 않고 NULL 판본을 쌓는다.
  rate_bp               Int?
  effective_from        DateTime(as: temporal)
  created_by_account_id Uuid
  created_by_account    StaffAccount           @relation(fields: [created_by_account_id], references: [id])
  created_at            DateTime(as: temporal) @default(now())

  @@check(expression: sql`rate_bp IS NULL OR rate_bp BETWEEN 0 AND 10000`, name: "ck_share_override_bp")
  // 한 소속·한 수업에 같은 시작일 판본은 하나뿐이다. 조회(ix_share_overrides_lookup)도 이 색인이 맡는다 — 위와 같은 까닭.
  @@index([affiliation_id, class_id, effective_from], unique: true, name: "uq_share_overrides")
  @@map("instructor_share_rate_overrides")
}

// ───────────────────────── DB 환경 표식 (S0-6.3(DB 환경 표식 대조), 플랜 S0-6 수용 ③) ─────────────────────────
// 베타와 운영은 한 기계에 DB 만 나눠 둔다(플랜 10-3 ⑪). DATABASE_URL 한 줄만 잘못 적어도 베타 서버가 운영 DB 에 붙는다.
// 그래서 DB 마다 「나는 어느 환경 DB 다」를 한 줄 적어 두고, 서버가 시작할 때 자기 설정(KDANCE_ENV)과 맞춰 본다
// (lib/server/db-environment.ts). 마이그레이션은 표만 만들고 줄은 넣지 않는다 — 같은 마이그레이션이 세 환경에 다 돌기 때문이다.
// 줄은 그 DB 를 처음 준비할 때 `npm run db:mark-env -- <환경>` 으로 한 번 적는다.

// 배포 환경 이름 — lib/server/env.ts 의 DEPLOY_ENVIRONMENTS 가 값의 원본이다.
enum DeployEnvironment {
  @@type("pg/text@1")
  development = "development"
  beta        = "beta"
  production  = "production"
}

// 표식은 DB 하나에 한 줄뿐이다(id 는 언제나 1).
model DeploymentMarker {
  id          Int                    @id
  environment DeployEnvironment
  marked_at   DateTime(as: temporal) @default(now())

  @@check(expression: sql`id = 1`, name: "ck_deployment_marker_single")
  @@map("deployment_marker")
}

// ───────────────────────── 학원 입점 칸·지점 (S1-1.1(학원·대표·지점 테이블 묶음), data-model §7-3·§7-9) ─────────────────────────
// academy_owners(학원당 활성 대표 1명)는 S0-3.5a 가 이미 만들었다. 이 절은 academies 입점 칸의 값 집합과 지점 표를 더한다.

// 학원 상태 — data-model §7-9. active → restricted(게시 제한) ↔ active / active → termination_requested → terminated.
// 전이 조건(해지)은 S7 몫이라 여기서는 값만 둔다.
enum AcademyStatus {
  @@type("pg/text@1")
  active                = "active"
  restricted            = "restricted"
  termination_requested = "termination_requested"
  terminated            = "terminated"
}

// 학원 등록 형태 — FR-085(학원 등록 형태·증빙). 증빙이 없는 형태(unregistered)는 엄격 환불 기준을 받는다(FR-087).
enum AcademyRegistrationType {
  @@type("pg/text@1")
  academy         = "academy"
  tutoring_center = "tutoring_center"
  sports_facility = "sports_facility"
  unregistered    = "unregistered"
}

// 학원 지점 — data-model §7-3. 입점 승인 트랜잭션이 첫 지점 한 줄을 함께 만든다(계약 07 「승인 트랜잭션」).
// 수업·강의실(rooms, S1-2)은 지점을 가리킨다. 운영시간·시설·주차·접근성은 W2b·W22 처럼 자유 글로 둔다(구조화는 필요해질 때).
model AcademyBranch {
  id            Uuid                   @id
  academy_id    Uuid
  academy       Academy                @relation(fields: [academy_id], references: [id])
  name          String
  address       String
  region_sido   String
  region_gu     String
  phone         String?
  opening_hours String?
  facilities    String?
  parking       String?
  accessibility String?
  created_at    DateTime(as: temporal) @default(now())
  updated_at    DateTime(as: temporal)
  rooms         Room[]

  // 한 학원 안에서 지점 이름은 겹치지 않는다(회원 화면에서 「어느 지점」인지 이름으로 고른다).
  @@index([academy_id, name], unique: true, name: "uq_branches_academy_name")
  @@map("academy_branches")
}

// ───────────────────────── 강의실 (S1-2.3(강의실 테이블), data-model §7-3) ─────────────────────────
// 지점 하나에 강의실 여러 개. M1 에서는 대표가 목록을 보고, 추가하고, 보관만 한다.
// 「같은 시간에 같은 강의실을 두 수업이 쓰는」 겹침은 여기서 막지 않는다 — 수업 회차(class_sessions)가 생기는
// M2(S2-2)에서 class_sessions 에 EXCLUDE USING gist 로 건다(data-model §8 결정 ②, 2026-11-21 사용자 결정).

// 강의실 상태 — 쓰는 중(active) / 보관(archived). 지난 수업 기록이 강의실을 가리키므로 지우지 않고 보관한다.
enum RoomStatus {
  @@type("pg/text@1")
  active   = "active"
  archived = "archived"
}

model Room {
  id            Uuid                   @id
  branch_id     Uuid
  branch        AcademyBranch          @relation(fields: [branch_id], references: [id])
  name          String
  // 넓이(㎡)·기본 정원·시설은 모를 수도 있어 비워 둘 수 있다.
  size_sqm      Int?
  base_capacity Int?
  facilities    String?
  status        RoomStatus             @default(active)
  created_at    DateTime(as: temporal) @default(now())
  updated_at    DateTime(as: temporal)
  // 이 홀을 기본 홀로 쓰는 수업 · 이 홀에서 하는 회차 — DB 칸이 아니라 관계다(S2-2.3).
  classes       Class[]
  sessions      ClassSession[]

  // 기본 정원을 적었다면 1명 이상이어야 한다(0명·음수 정원은 말이 안 된다).
  @@check(expression: sql`base_capacity > 0`, name: "ck_rooms_base_capacity")
  // 한 지점 안에서 쓰는 강의실 이름은 겹치지 않는다. 보관한 강의실은 빼고 본다 —
  // 그래야 옛 「A홀」을 보관한 뒤 같은 이름으로 새 강의실을 만들 수 있다.
  @@index([branch_id, name], unique: true, where: sql`(status = 'active')`, name: "uq_rooms_branch_name")
  @@map("rooms")
}

// ───────────────────────── 입점 신청·증빙 파일·정산 계좌 (S1-1.2(입점 신청·증빙·정산 계좌 테이블 묶음), data-model §7-3·§7-9) ─────────────────────────
// 입점 흐름: 대표가 신청서(merchant_applications)를 쓰고 → 증빙 파일(uploaded_files)을 올려 신청에 붙이고
// (merchant_application_documents) → 운영자가 승인하면 그때 academies·academy_payout_accounts 가 생긴다(계약 07 「승인 트랜잭션」).

// 입점 신청 상태 — draft → submitted → in_review → approved · rejected / draft·submitted → withdrawn.
// 거절 뒤 재신청은 같은 행을 되살리지 않고 새 행을 만든다(FR-250).
enum MerchantApplicationStatus {
  @@type("pg/text@1")
  draft     = "draft"
  submitted = "submitted"
  in_review = "in_review"
  approved  = "approved"
  rejected  = "rejected"
  withdrawn = "withdrawn"
}

// 입점 거절 사유 4종 — FR-250 「정해진 사유」. 자유 글은 reject_reason_text 에 따로 둔다.
enum MerchantRejectReason {
  @@type("pg/text@1")
  info_mismatch        = "info_mismatch"
  registration_missing = "registration_missing"
  prior_termination    = "prior_termination"
  trust_violation      = "trust_violation"
}

// 신청에 붙이는 증빙 종류 — 사업자등록증은 모든 등록 형태 필수, 나머지는 등록 형태별 1종(FR-085·FR-250).
enum MerchantDocumentKind {
  @@type("pg/text@1")
  business_registration  = "business_registration"
  academy_registration   = "academy_registration"
  tutoring_center_report = "tutoring_center_report"
  sports_facility_report = "sports_facility_report"
}

// 올린 파일의 쓰임새 — 지금은 입점 증빙·학원 사진 둘(§7-9). 뒤 슬라이스가 값을 더한다(통합 목록 §14-2).
enum UploadedFilePurpose {
  @@type("pg/text@1")
  merchant_evidence = "merchant_evidence"
  academy_photo     = "academy_photo"
  // 강사 사업자등록증(S2-1.2b, data-model §8 · 계약 11 §2-2). 개인정보라 언제나 비공개다.
  business_registration_evidence = "business_registration_evidence"
  // 강사 프로필 사진(S2-1.6, data-model §8 · 계약 11 §2-1). 회원 화면에 보이는 사진이라 언제나 공개다.
  instructor_photo = "instructor_photo"
  // 수업 포스터(S2-2.8, data-model §8 · 계약 11 §4-6). 회원 화면에 보이는 그림이라 공개로 받는다.
  poster = "poster"
  // AI 가 만든 수업 홍보 이미지(SX-6.5, data-model §13-6). 만들 때는 비공개, 수업이 게시될 때 S2-2.7 이 공개로 바꾼다.
  class_promo_image = "class_promo_image"
  // 문의 첨부 · 신고 첨부 · 이용 제한 소명 첨부(S7-2.7, data-model §12 · 계약 15 §0-1). 당사자와 받는 쪽만 여는 비공개 파일이다.
  inquiry_attachment      = "inquiry_attachment"
  report_attachment       = "report_attachment"
  restriction_explanation = "restriction_explanation"
}

// 파일 공개 범위 — private 은 올린 사람·운영자 등 정해진 사람만, public 은 회원 화면에 보인다.
enum UploadedFileVisibility {
  @@type("pg/text@1")
  private = "private"
  public  = "public"
}

// 정산 계좌 상태 — active → replaced(끝). 바꾸면 옛 행을 replaced 로 닫고 새 행을 연다.
enum PayoutAccountStatus {
  @@type("pg/text@1")
  active   = "active"
  replaced = "replaced"
}

// 예금주 확인 상태 — S1-1.22(예금주 확인 상태와 지급 금지 판정), data-model §10-5.
// awaiting_proof(통장 사본 올리기 전) → pending(사본 올림, 운영자 대조 대기) → verified(이름 같음) · rejected(반려).
// verified 가 아닌 계좌로는 돈을 보내지 않는다(R15 — 예금주 확인은 운영자가 통장 사본을 보고 하는 수동 확인뿐).
enum PayoutVerificationStatus {
  @@type("pg/text@1")
  awaiting_proof = "awaiting_proof"
  pending        = "pending"
  verified       = "verified"
  rejected       = "rejected"
}

// 예금주 확인 반려 사유 — 사본의 이름이 다름 / 사본을 읽을 수 없음 / 그 밖(글로 적는다). 13 §10-2.
enum PayoutAccountRejectReason {
  @@type("pg/text@1")
  name_mismatch   = "name_mismatch"
  file_unreadable = "file_unreadable"
  other           = "other"
}

// 입점 신청 — data-model §7-3. 감사 ○.
// 승인 전 학원 정보는 여기에만 있다. 승인되면 이 값들을 academies 로 옮겨 적고 academy_id 를 채운다.
// 초안(draft)은 적다 만 상태라 판매자 칸이 비어 있어도 된다(NULL 허용). 제출할 때 앱이 전부 찼는지 검사한다.
model MerchantApplication {
  id                           Uuid                       @id
  applicant_account_id         Uuid
  applicant_account            StaffAccount               @relation(fields: [applicant_account_id], references: [id])
  status                       MerchantApplicationStatus  @default(draft)
  academy_name                 String?
  branch_name                  String?
  business_name                String?
  representative_name          String?
  business_registration_number String?
  mail_order_report_number     String?
  business_address             String?
  region_sido                  String?
  region_gu                    String?
  phone                        String?
  registration_type            AcademyRegistrationType?
  industry_code                String?
  // 정산 받을 계좌 — 번호 원문은 암호화해 두고(account_enc), 화면에는 끝 4자리만 보인다.
  payout_bank_code             String?
  payout_account_enc           Bytes?
  payout_account_last4         String?
  payout_holder_name           String?
  reject_reason_code           MerchantRejectReason?
  reject_reason_text           String?
  // 심사한 운영자. NULL = 아직 아무도 심사하지 않았다.
  reviewed_by_account_id       Uuid?
  submitted_at                 DateTime(as: temporal)?
  review_started_at            DateTime(as: temporal)?
  decided_at                   DateTime(as: temporal)?
  // 승인 때 만든 학원. 승인 전에는 비어 있다.
  academy_id                   Uuid?
  academy                      Academy?                   @relation(fields: [academy_id], references: [id])
  created_at                   DateTime(as: temporal)     @default(now())
  updated_at                   DateTime(as: temporal)
  documents                    MerchantApplicationDocument[]
  // 이 신청에서 받은 항목별 동의(S1-1.3).
  consents                     MerchantConsent[]

  // 거절한 신청에만 정해진 사유 코드가 있다 — 사유 없이 거절할 수 없고, 거절 아닌 신청에 사유가 남지 않는다.
  @@check(expression: sql`(status = 'rejected') = (reject_reason_code IS NOT NULL)`, name: "ck_merchant_app_rejected")
  // 승인한 신청에만 만들어진 학원이 있다.
  @@check(expression: sql`(status = 'approved') = (academy_id IS NOT NULL)`, name: "ck_merchant_app_approved")
  // 한 계정은 열린(초안·제출·심사 중) 신청을 하나만 가진다. 끝난 신청(승인·거절·철회)은 몇 개든 남는다.
  @@index([applicant_account_id], unique: true, where: sql`(status IN ('draft', 'submitted', 'in_review'))`, name: "uq_merchant_app_open")
  // 운영자 심사 목록(상태별 · 제출 순)을 찾는 색인.
  @@index([status, submitted_at], name: "ix_merchant_app_status_submitted")
  @@map("merchant_applications")
}

// 올린 파일 — data-model §7-3, 파일 저장 경계(플랜 6-8).
// 파일 본체는 저장소(로컬 디스크 → 나중에 객체 저장소)에 있고, 이 표는 그 파일의 신분증이다.
// storage_key 는 서버가 지은 이름이다. 사용자가 보낸 파일 이름(display_name)은 화면 표시용으로만 써서 경로 조작을 막는다.
model UploadedFile {
  id                  Uuid                   @id
  // 올린 사람 — 직원 계정이나 회원 둘 중 정확히 하나(ck_files_uploader). 회원은 문의·신고 첨부만 올린다(S7-2.7 — 추천안·사후 확인 2026-11-24).
  uploader_account_id Uuid?
  uploader_account    StaffAccount?          @relation(fields: [uploader_account_id], references: [id])
  uploader_member_id  Uuid?
  uploader_member     Member?                @relation(fields: [uploader_member_id], references: [id])
  purpose             UploadedFilePurpose
  visibility          UploadedFileVisibility
  storage_key         String
  mime_type           String
  size_bytes          Int
  sha256              String
  display_name        String
  // 어딘가(신청 증빙·학원 사진)에 붙은 시각. NULL 이면 아직 주인 없는 파일이다.
  attached_at         DateTime(as: temporal)?
  created_at          DateTime(as: temporal) @default(now())
  application_documents MerchantApplicationDocument[]
  payout_account_proofs AcademyPayoutAccount[]
  // 이 파일을 등록 형태 변경 증빙으로 가리키는 학원 — DB 칸이 아니라 관계다(S1-1.17).
  registration_change_academies Academy[]
  // 이 파일을 앱 학원 페이지 사진으로 쓰는 자리 — DB 칸이 아니라 관계다(S1-1.20). file_id 유니크라 많아야 1행이다.
  academy_photos                AcademyPhoto[]
  // 이 파일을 강사 프로필 사진 · 사업자등록증으로 쓰는 프로필 — DB 칸이 아니라 관계다(S2-1.1).
  instructor_profile_photos     InstructorProfile[] @relation(name: "instructor_profile_photo")
  instructor_profile_brn_files  InstructorProfile[] @relation(name: "instructor_profile_brn_file")
  // 이 파일을 포스터로 쓰는 수업 — DB 칸이 아니라 관계다(S2-2.8).
  class_posters                 Class[]             @relation(name: "class_poster")
  // 이 파일을 원본으로 읽은 포스터 읽기(많아야 1행 — uq_poster_source_file). DB 칸이 아니라 관계다(SX-2.3).
  poster_extractions            PosterExtraction[]
  // 이 파일을 결과 그림으로 가진 홍보 이미지 만들기(많아야 1행). DB 칸이 아니라 관계다(SX-6.5).
  promo_image_generations       PromoImageGeneration[]
  // 이 파일을 붙인 문의 글·신고·소명(많아야 1행 — uq_attachment_file). DB 칸이 아니라 관계다(S7-2.7).
  attachment_links              AttachmentLink[]
  // 이 파일을 홍보 표지 사진으로 쓰는 수업 홍보 자료 — DB 칸이 아니라 관계다(SX-6.7).
  class_promo_photos            ClassPromoAsset[]

  // 받는 형식은 사진 3종과 PDF 뿐이다(계약 07 FILE_TYPE_NOT_ALLOWED 와 같은 목록).
  @@check(expression: sql`mime_type IN ('image/jpeg', 'image/png', 'image/webp', 'application/pdf')`, name: "ck_files_mime")
  // 빈 파일은 받지 않고, 한 장 10MB(10,485,760바이트)까지다 — 10MB 는 추천값(플랜 6-8).
  @@check(expression: sql`size_bytes BETWEEN 1 AND 10485760`, name: "ck_files_size")
  // 입점 증빙(사업자등록증 등)·강사 사업자등록증은 개인정보라 공개(public)로 둘 수 없다 — 앱이 실수해도 DB 가 막는다(S1-1 수용 ⑥ · S2-1.2b).
  // 문의·신고·소명 첨부도 당사자와 받는 쪽만 보므로 언제나 비공개다(S7-2.7).
  @@check(expression: sql`purpose NOT IN ('merchant_evidence', 'business_registration_evidence', 'inquiry_attachment', 'report_attachment', 'restriction_explanation') OR visibility = 'private'`, name: "ck_files_evidence_private")
  // 올린 사람은 직원·회원 중 정확히 하나(S7-2.7). 회원이 올린 파일은 첨부 목적만 된다 — 앱 경로가 먼저 막고 DB 가 한 번 더 막는다.
  @@check(expression: sql`num_nonnulls(uploader_account_id, uploader_member_id) = 1`, name: "ck_files_uploader")
  @@check(expression: sql`uploader_member_id IS NULL OR purpose IN ('inquiry_attachment', 'report_attachment', 'restriction_explanation')`, name: "ck_files_member_purpose")
  @@index([storage_key], unique: true, name: "uq_files_storage_key")
  // 24시간 지나도 주인 없는 파일을 지우는 정리 작업(플랜 6-7)이 쓰는 색인.
  @@index([created_at], where: sql`(attached_at IS NULL)`, name: "ix_files_unattached")
  @@map("uploaded_files")
}

// 앱 학원 페이지 사진 — data-model §7-3 · 계약 07 §4(S1-1.20(학원 앱 페이지 API)) · FR-070 W22.
// 회원 앱 학원 상세에 보이는 순서대로 position 0, 1, 2 … 를 붙인다. 한 학원에 최대 10장(앱이 검사 — 11장은 422).
// 한 파일은 한 자리에만 쓴다(uq_academy_photos_file) — 같은 사진을 두 번 넣거나 남의 학원 사진을 가져오지 못하게.
// 대표가 앱 페이지를 저장할 때마다 이 학원 행을 모두 지우고 새 순서로 다시 넣는다(전체 교체).
model AcademyPhoto {
  academy_id Uuid
  academy    Academy      @relation(fields: [academy_id], references: [id])
  file_id    Uuid
  file       UploadedFile @relation(fields: [file_id], references: [id])
  position   Int

  @@id([academy_id, position])
  @@index([file_id], unique: true, name: "uq_academy_photos_file")
  @@map("academy_photos")
}

// 신청에 붙인 증빙 — data-model §7-3. 한 신청에 같은 종류 증빙은 한 장, 한 파일은 한 신청에만 붙는다.
model MerchantApplicationDocument {
  application_id Uuid
  application    MerchantApplication    @relation(fields: [application_id], references: [id])
  doc_kind       MerchantDocumentKind
  file_id        Uuid
  file           UploadedFile           @relation(fields: [file_id], references: [id])
  created_at     DateTime(as: temporal) @default(now())

  @@id([application_id, doc_kind])
  @@index([file_id], unique: true, name: "uq_app_docs_file")
  @@map("merchant_application_documents")
}

// 학원 정산 계좌 — data-model §7-3. 감사 ○(번호는 가린 값으로).
// 고치지 않고 쌓는다: 계좌를 바꾸면 옛 행 replaced + 새 행 active 를 한 트랜잭션에서 쓴다.
// 그래야 지난 지급이 어느 계좌로 갔는지 남는다(FR-139).
model AcademyPayoutAccount {
  id                            Uuid                   @id
  academy_id                    Uuid
  academy                       Academy                @relation(fields: [academy_id], references: [id])
  bank_code                     String
  // 계좌번호 원문은 암호화한 바이트로만 둔다. 화면·감사 기록에는 끝 4자리(account_last4)만 쓴다.
  account_enc                   Bytes
  account_last4                 String
  holder_name                   String
  // 예금주 확인 — 운영자가 통장 사본을 보고 이름을 대조한다(R15 확정: manual_document 만).
  holder_verified_at            DateTime(as: temporal)?
  holder_verify_method          String?
  holder_proof_file_id          Uuid?
  holder_proof_file             UploadedFile?          @relation(fields: [holder_proof_file_id], references: [id])
  holder_verified_by_account_id Uuid?
  holder_verified_by_account    StaffAccount?          @relation(fields: [holder_verified_by_account_id], references: [id])
  // 예금주 확인 상태(S1-1.22). 새 계좌는 늘 「사본 올리기 전」에서 시작한다. 지급 가능 판정은 이 칸만 본다(isPayableAccount).
  verification_status           PayoutVerificationStatus @default(awaiting_proof)
  proof_uploaded_at             DateTime(as: temporal)?
  reject_reason_code            PayoutAccountRejectReason?
  reject_reason_text            String?
  status                        PayoutAccountStatus    @default(active)
  created_by_account_id         Uuid
  created_at                    DateTime(as: temporal) @default(now())
  replaced_at                   DateTime(as: temporal)?

  // 끝 4자리는 숫자 4개뿐이다.
  @@check(expression: sql`account_last4 ~ '^[0-9]{4}$'`, name: "ck_payout_accounts_last4")
  // 「확인됨」 상태와 확인 시각은 함께 있거나 함께 없다 — 시각만 찍히고 상태가 대기인 계좌(또는 그 반대)를 DB 가 막는다.
  @@check(expression: sql`(verification_status = 'verified') = (holder_verified_at IS NOT NULL)`, name: "ck_payout_accounts_verified")
  // 반려면 사유 코드가 있고, 사유가 「그 밖」이면 글도 있다. 반려가 아니면 사유 칸은 비어 있다.
  @@check(
    expression: sql`((verification_status = 'rejected') = (reject_reason_code IS NOT NULL)) AND (reject_reason_code IS DISTINCT FROM 'other' OR reject_reason_text IS NOT NULL)`,
    name: "ck_payout_accounts_rejected"
  )
  // 대기·확인 상태는 통장 사본이 올라온 뒤에만 될 수 있다.
  @@check(
    expression: sql`verification_status NOT IN ('pending', 'verified') OR holder_proof_file_id IS NOT NULL`,
    name: "ck_payout_accounts_proof"
  )
  // 학원 하나에 쓰는(active) 계좌는 하나. 바뀐(replaced) 옛 계좌는 몇 개든 남는다.
  @@index([academy_id], unique: true, where: sql`(status = 'active')`, name: "uq_payout_accounts_active")
  @@map("academy_payout_accounts")
}

// ── 약관·동의(S1-1.3(약관·동의 테이블 묶음), data-model §7-4) ──

// 약관 판본의 종류 — 입점 약관·개인정보 수집 동의와 입점 고지 항목들(§7-9).
// 고지 항목도 판본으로 둔다. 그래야 「그때 동의한 판본 전문」을 항목마다 다시 열 수 있다(O35).
// 회원 약관 값(member_terms 등, §12-9)은 그 값을 쓰는 뒤 슬라이스가 더한다.
enum TermsKind {
  @@type("pg/text@1")
  merchant_terms              = "merchant_terms"
  merchant_privacy_collection = "merchant_privacy_collection"
  privacy_policy              = "privacy_policy"
  platform_fee_notice         = "platform_fee_notice"
  card_fee_notice             = "card_fee_notice"
  content_license             = "content_license"
  one_plus_one_notice         = "one_plus_one_notice"
}

// 동의가 어디서 생겼나 — 입점 신청 때(application) / 약관이 바뀌어 다시 동의(re_consent).
enum MerchantConsentSource {
  @@type("pg/text@1")
  application = "application"
  re_consent  = "re_consent"
}

// 직원 동의가 어디서 생겼나 — 지금은 강사 가입 하나뿐이다(data-model §8-3 staff_consents.source).
enum StaffConsentSource {
  @@type("pg/text@1")
  instructor_signup = "instructor_signup"
}

// 약관 판본 — data-model §7-4. 판본은 고치지 않고 새 판본을 더한다(옛 판본도 지우지 않는다, FR-244).
// 한 판본이 언제까지 쓰였는지(종료 시각)는 칸으로 두지 않는다. 같은 kind 의 다음 판본 effective_at 이 곧 끝이다 —
// 칸으로 따로 두면 새 판본을 낼 때마다 옛 행을 고쳐야 하고, 둘이 어긋날 수 있다.
// 「같은 kind 의 두 번째 판본부터 시행일은 발행 30일 뒤 이상」은 행 사이 비교라 CHECK 로 못 건다 → 발행 API(S1-1.23)가 검사한다.
model TermsVersion {
  id             Uuid                   @id
  kind           TermsKind
  version        String
  // 약관 전문 — 동의한 사람이 나중에 그 판본 그대로 다시 볼 수 있어야 한다.
  body           String
  published_at   DateTime(as: temporal)
  effective_at   DateTime(as: temporal)
  created_at     DateTime(as: temporal) @default(now())
  consents       MerchantConsent[]
  staff_consents StaffConsent[]
  // 회원이 이 판본에 한 동의 — 회원 약관 판본은 S7-3.1 이 만든다(그 전에는 비어 있다).
  member_consents MemberConsent[]
  change_notices TermsChangeNotice[]

  // 같은 종류에 같은 판본 번호는 하나뿐이다.
  @@index([kind, version], unique: true, name: "uq_terms_kind_version")
  // 시행일이 발행일보다 앞설 수 없다 — 아직 알리지도 않은 약관이 이미 시행 중인 상태를 DB 가 막는다.
  @@check(expression: sql`effective_at >= published_at`, name: "ck_terms_effective_after_published")
  @@map("terms_versions")
}

// 입점 동의 기록 — data-model §7-4. 이 표 자체가 추가 전용 기록이라 따로 감사하지 않는다.
// 항목마다 1행. 철회해도 지우지 않고 withdrawn_at 만 채운다.
// agreed_at 은 서버 시각이다(요청 본문의 시각을 믿지 않는다 — 앱이 now() 를 넣는다).
model MerchantConsent {
  id               Uuid                   @id
  application_id   Uuid
  application      MerchantApplication    @relation(fields: [application_id], references: [id])
  // 승인 때 만든 학원. 승인 전에는 비어 있다(승인 트랜잭션이 채운다, 계약 07).
  academy_id       Uuid?
  academy          Academy?               @relation(fields: [academy_id], references: [id])
  // 동의를 누른 사람.
  staff_account_id Uuid
  staff_account    StaffAccount           @relation(fields: [staff_account_id], references: [id])
  terms_version_id Uuid
  terms_version    TermsVersion           @relation(fields: [terms_version_id], references: [id])
  // 그 판본의 kind 사본 — 학원별 「무슨 항목에 동의했나」를 판본 표를 거치지 않고 바로 찾으려고 둔다.
  item             TermsKind
  agreed_at        DateTime(as: temporal)
  withdrawn_at     DateTime(as: temporal)?
  source           MerchantConsentSource

  // 한 신청이 같은 판본에 두 번 동의할 수 없다 — 제출을 두 번 눌러도 동의는 1건이다.
  @@index([application_id, terms_version_id], unique: true, name: "uq_consents_app_version")
  // 학원 설정의 약관 요약·카드 결제 여부(FR-125b)가 학원별·항목별로 찾는 색인.
  @@index([academy_id, item], name: "ix_consents_academy")
  @@map("merchant_consents")
}

// 약관 변경 개별 통지 — data-model §7-4, FR-259(변경 30일 전 개별 통지).
// 새 판본을 발행하는 트랜잭션이 그때 active 인 모든 학원에 1행씩 쓴다(S1-1.23).
model TermsChangeNotice {
  id               Uuid                   @id
  terms_version_id Uuid
  terms_version    TermsVersion           @relation(fields: [terms_version_id], references: [id])
  academy_id       Uuid
  academy          Academy                @relation(fields: [academy_id], references: [id])
  notified_at      DateTime(as: temporal)
  // 같이 보낸 앱 안 알림 한 건.
  notification_id  Uuid
  notification     Notification           @relation(fields: [notification_id], references: [id])
  // 대표가 읽음을 누른 시각(O35). NULL 이면 아직 안 읽었다.
  read_at          DateTime(as: temporal)?

  // 한 판본을 한 학원에 두 번 통지하지 않는다 — 발행을 다시 돌려도 학원마다 1행이다.
  @@index([terms_version_id, academy_id], unique: true, name: "uq_terms_notice")
  @@map("terms_change_notices")
}

// ── 사업자 상태 확인·학원 제한(S1-1.4(사업자 상태 확인·학원 제한 테이블), data-model §7-3b) ──
// 흐름: 국세청 상태조회 결과를 business_status_checks 에 한 줄씩 쌓고(매일 1회 + 정산일 지급 직전),
// 휴업·폐업이 처음 나오면 academy_restrictions 에 「새 결제 막음」·「지급 보류」 두 행을 연다(FR-250·FR-252·FR-254).
// 결제 시작·정산 지급 코드는 국세청 API 를 부르지 않고, academy_restrictions 에 열린 행이 있는지만 읽는다.

// 무엇이 조회를 시작했나 — 입점 심사 / 매일 점검 / 정산 지급 직전 / 운영자 수동.
enum BusinessCheckTrigger {
  @@type("pg/text@1")
  onboarding = "onboarding"
  daily      = "daily"
  pre_payout = "pre_payout"
  manual     = "manual"
}

// 조회 결과 — 계속·휴업·폐업·미등록·조회 실패.
// error 는 조치하지 않는다(조회 실패를 폐업으로 오판하지 않으려고). 다음 점검에서 다시 본다.
enum BusinessCheckStatus {
  @@type("pg/text@1")
  active    = "active"
  suspended = "suspended"
  closed    = "closed"
  not_found = "not_found"
  error     = "error"
}

// 학원 제한의 종류 — 새 결제 막음 / 정산 지급 보류 / 앱 게시 중단.
// 휴업·폐업이면 앞의 둘을 열고, 7일 안에 소명으로 풀리지 않으면 listing_suspended 를 연다(FR-254).
enum AcademyRestrictionKind {
  @@type("pg/text@1")
  new_sales_blocked = "new_sales_blocked"
  payout_hold       = "payout_hold"
  listing_suspended = "listing_suspended"
}

// 사업자 상태 확인 기록 — data-model §7-3b. 감사 ○. 고치지 않고 쌓는다(언제 무슨 결과였는지가 제한의 근거다).
model BusinessStatusCheck {
  id           Uuid                   @id
  academy_id   Uuid
  academy      Academy                @relation(fields: [academy_id], references: [id])
  checked_at   DateTime(as: temporal)
  trigger      BusinessCheckTrigger
  // 그때 조회한 사업자등록번호 — 학원 칸이 나중에 바뀌어도 무엇을 조회했는지 남는다.
  business_no  String
  status       BusinessCheckStatus
  // 폐업일(폐업일 때만 국세청이 준다).
  closed_on    Date?
  tax_type     String?
  // 국세청 응답 원문 — 나중에 판정이 맞았는지 다시 볼 수 있게 그대로 둔다.
  raw_response Json
  restrictions AcademyRestriction[]
  // 이 조회가 연 이용 제한 절차 — DB 칸이 아니라 관계다(S7-2.6).
  restriction_cases RestrictionCase[]

  // 학원별 최근 조회 결과 찾기 — `WHERE academy_id = ? ORDER BY checked_at DESC LIMIT 1`.
  // 설계는 (academy_id, checked_at DESC) 인데, 계약 문법에 정렬 방향 인자가 없다.
  // PostgreSQL 은 B-tree 를 거꾸로도 읽으므로 오름차순 색인으로 같은 조회가 된다.
  @@index([academy_id, checked_at], name: "ix_bsc_academy_checked")
  @@map("business_status_checks")
}

// 학원 제한 — data-model §7-3b. 연 행은 지우지 않고 ended_at 을 채워 닫는다(언제부터 언제까지 막혔는지 남긴다).
// 열린 행 = ended_at IS NULL. 결제·지급·게시 코드는 이것만 본다.
model AcademyRestriction {
  id                  Uuid                   @id
  academy_id          Uuid
  academy             Academy                @relation(fields: [academy_id], references: [id])
  kind                AcademyRestrictionKind
  reason              String
  // 사업자 점검이 연 제한이면 그 조회 기록. 신고·운영자 수동으로 연 것은 비어 있다.
  source_check_id     Uuid?
  source_check        BusinessStatusCheck?   @relation(fields: [source_check_id], references: [id])
  // 이용 제한 절차(restriction_cases)가 연 제한이면 그 절차(S7-2.6, data-model §12-3). 사업자 점검만으로 연 것은 비어 있다.
  source_case_id      Uuid?
  source_case         RestrictionCase?       @relation(fields: [source_case_id], references: [id])
  started_at          DateTime(as: temporal) @default(now())
  ended_at            DateTime(as: temporal)?
  // 제한을 푼 운영자. 자동으로 풀린 것은 비어 있다.
  ended_by_account_id Uuid?
  ended_by_account    StaffAccount?          @relation(fields: [ended_by_account_id], references: [id])

  // 끝난 시각이 시작보다 앞설 수 없다.
  @@check(expression: sql`ended_at IS NULL OR ended_at >= started_at`, name: "ck_restrictions_ended_after_started")
  // 열린 제한 조회 색인 — 「이 학원에 지금 열린 결제 막음이 있나」를 바로 찾는다.
  // 같은 종류의 열린 제한은 학원당 하나다: 매일 점검이 같은 폐업을 다시 봐도 행이 겹쳐 쌓이지 않는다.
  @@index([academy_id, kind], unique: true, where: sql`(ended_at IS NULL)`, name: "uq_restrictions_open")
  @@map("academy_restrictions")
}

// ───────────────────────── 학원 공지·받는 사람 (S1-4.1(학원 공지·받는 사람 테이블 묶음), data-model §7-6 끝) ─────────────────────────
// 대표가 소속 강사에게만 보내는 학원 공지(FR-063a·FR-078, 계약 09 「학원 공지」). 회원에게는 보이지 않는다.
// 흐름: 대표가 초안(draft)을 쓰고 → 올리면(published) 그 순간 active 소속 강사를 받는 사람 표에 고정한다.
// 올린 공지는 고치거나 지우지 않는다(2026-11-19 확정 — 고칠 일이 있으면 새로 올린다).

// 학원 공지 분류 — 휴강 / 수업 변경 / 학원 일정 / 기타(data-model §3 값 집합 표).
enum StaffNoticeCategory {
  @@type("pg/text@1")
  class_cancelled  = "class_cancelled"
  class_changed    = "class_changed"
  academy_schedule = "academy_schedule"
  other            = "other"
}

// 학원 공지 상태 — draft(초안) → published(올림, 끝). 되돌아가는 길은 없다.
enum StaffNoticeStatus {
  @@type("pg/text@1")
  draft     = "draft"
  published = "published"
}

model AcademyStaffNotice {
  id                Uuid                   @id
  academy_id        Uuid
  academy           Academy                @relation(fields: [academy_id], references: [id])
  // 쓴 사람(대표 또는 위임 직원).
  author_account_id Uuid
  author_account    StaffAccount           @relation(fields: [author_account_id], references: [id])
  category          StaffNoticeCategory
  title             String
  body              String
  status            StaffNoticeStatus      @default(draft)
  // 올린 시각 — 초안이면 비어 있고, 올린 공지는 반드시 있다(아래 ck_staff_notice_published).
  published_at      DateTime(as: temporal)?
  // 올린 순간 받는 사람 수(W5 「강사 3명에게 보냄」). 초안이면 비어 있다.
  recipient_count   Int?
  created_at        DateTime(as: temporal) @default(now())
  updated_at        DateTime(as: temporal)
  // 받는 사람 목록 — DB 칸이 아니라 관계다.
  recipients        AcademyStaffNoticeRecipient[]

  // 상태와 올린 시각이 어긋나지 않게 DB 가 막는다: published 면 시각이 있고, draft 면 시각이 없다.
  // 앱이 실수로 「올렸는데 시각 없음」·「초안인데 시각 있음」 행을 만들면 저장이 거부된다.
  @@check(expression: sql`(status = 'published') = (published_at IS NOT NULL)`, name: "ck_staff_notice_published")
  // 제목은 1~100자(100 은 2026-11-19 확정 값).
  @@check(expression: sql`char_length(title) BETWEEN 1 AND 100`, name: "ck_staff_notice_title_length")
  // 학원별 최근 공지 목록 — 설계는 (academy_id, published_at DESC) 인데 계약 문법에 정렬 방향 인자가 없어
  // 오름차순으로 둔다. PostgreSQL 은 B-tree 를 거꾸로도 읽는다(ix_bsc_academy_checked 와 같은 방식).
  @@index([academy_id, published_at], name: "ix_staff_notices_academy_pub")
  @@map("academy_staff_notices")
}

// 공지를 받는 사람 — 올리는 순간의 active 소속 강사로 고정한다(뒤에 소속된 강사는 옛 공지를 받지 않는다).
// 강사 쪽 조회는 지금도 active 인 소속의 공지만 보여 준다(I39) — 그 거르기는 조회 API 가 맡는다.
model AcademyStaffNoticeRecipient {
  notice_id             Uuid
  notice                AcademyStaffNotice     @relation(fields: [notice_id], references: [id])
  instructor_account_id Uuid
  instructor_account    StaffAccount           @relation(fields: [instructor_account_id], references: [id])
  // 강사가 읽은 시각. 안 읽었으면 비어 있다.
  read_at               DateTime(as: temporal)?

  // 한 공지에 같은 강사는 한 번만 들어간다.
  @@id([notice_id, instructor_account_id])
  @@map("academy_staff_notice_recipients")
}

// ───────────────────────── 강사 프로필·활동 지역·자격·개인 일정 (S2-1.1(강사 테이블), data-model §8-3) ─────────────────────────
// 강사 가입(S2-1.2)과 프로필 저장(S2-1.6)이 쓰는 표 네 개다. 이 Task 는 표만 만들고, 쓰는 API 는 뒤 Task 가 만든다.
// 강사 계정 자체는 staff_accounts 다 — 본인확인 CI(identity_ci_hash)와 「한 사람 한 강사 계정」(uq_staff_accounts_ci)은
// 거기에 이미 있다(S0-2.2). 여기서는 계정 하나에 붙는 강사 쪽 정보만 둔다.
// 「가능 시간」(FR-053)은 주간 가능 시간표가 아니라 개인 일정(I36)으로 정했다(계약 11 열린 점 ③, 2026-11-20 임시 확정).
// 그래서 학원에는 「불가 시간」으로만 보이는 개인 일정 표가 그 자리를 맡는다.

// 강사 자격·대회 이력의 종류 — 자격증 / 대회 수상(보드 I40 의 두 목록).
enum InstructorCredentialKind {
  @@type("pg/text@1")
  qualification = "qualification"
  competition   = "competition"
}

// 개인 일정 반복 — 한 번 / 매주 / 매일. 반복 일정은 한 행이고 읽을 때 날짜 범위로 펼친다.
enum PersonalEventRepeat {
  @@type("pg/text@1")
  none   = "none"
  weekly = "weekly"
  daily  = "daily"
}

// 강사 프로필 — 강사 계정 하나에 한 행(기본 키가 곧 계정 id). 감사 ○(사업자 정보·활동 장르 최초 저장).
model InstructorProfile {
  staff_account_id             Uuid                   @id
  staff_account                StaffAccount           @relation(fields: [staff_account_id], references: [id])
  // 활동 장르는 하나뿐이고 가입 때만 정한다(FR-011b). 고치기 요청은 앱이 422 로 거부한다 — DB 트리거로 막지는 않는다.
  activity_genre               Genre
  // 소개 글(I40 「44 / 500」) · 경력 연수.
  bio                          String?
  career_years                 Int?
  photo_file_id                Uuid?
  photo_file                   UploadedFile?          @relation(name: "instructor_profile_photo", fields: [photo_file_id], references: [id])
  // 사업자등록번호는 선택이다(수용 ⑤) — 비워도 가입되고 나중에 마이에서 넣는다. 숫자 10자리만 저장한다(하이픈 없이).
  business_registration_number String?
  business_registration_file_id Uuid?
  business_registration_file   UploadedFile?          @relation(name: "instructor_profile_brn_file", fields: [business_registration_file_id], references: [id])
  // 광고성 알림 선택 동의 시각(FR-146). NULL = 동의 안 함.
  marketing_opt_in_at          DateTime(as: temporal)?
  signup_completed_at          DateTime(as: temporal)
  created_at                   DateTime(as: temporal) @default(now())
  updated_at                   DateTime(as: temporal)

  // 소개 글은 500자까지.
  @@check(expression: sql`bio IS NULL OR char_length(bio) <= 500`, name: "ck_instr_profiles_bio")
  // 경력은 0~80년(80 은 추천값).
  @@check(expression: sql`career_years IS NULL OR career_years BETWEEN 0 AND 80`, name: "ck_instr_profiles_career")
  // 사업자등록번호는 숫자 10자리만 — 하이픈·공백이 섞인 값이 들어오면 DB 가 거부한다.
  @@check(expression: sql`business_registration_number IS NULL OR business_registration_number ~ '^[0-9]{10}$'`, name: "ck_instr_profiles_brn")
  // 등록증 파일만 있고 번호가 없는 상태는 안 된다(번호 없이 증빙만 올라가는 일을 막는다).
  @@check(expression: sql`business_registration_file_id IS NULL OR business_registration_number IS NOT NULL`, name: "ck_instr_profiles_brn_file")
  @@map("instructor_profiles")
}

// 강사 활동 지역 — 시·도 + 구 묶음 여러 개. 모양은 회원 관심 지역(member_regions)과 같다.
model InstructorRegion {
  staff_account_id Uuid
  staff_account    StaffAccount @relation(fields: [staff_account_id], references: [id])
  region_sido      String
  region_gu        String

  @@id([staff_account_id, region_sido, region_gu])
  @@map("instructor_regions")
}

// 강사 자격·대회 이력 — 종류마다 화면 순서(position)대로. 한 사람 최대 20개는 앱이 검사한다(추천값).
model InstructorCredential {
  id               Uuid                     @id
  staff_account_id Uuid
  staff_account    StaffAccount             @relation(fields: [staff_account_id], references: [id])
  kind             InstructorCredentialKind
  title            String
  position         Int
  created_at       DateTime(as: temporal)   @default(now())

  // 이름은 1~100자.
  @@check(expression: sql`char_length(title) BETWEEN 1 AND 100`, name: "ck_instr_cred_title")
  // 한 강사·한 종류 안에서 같은 순서 번호는 하나뿐이다.
  @@index([staff_account_id, kind, position], unique: true, name: "uq_instr_cred_position")
  @@map("instructor_credentials")
}

// 강사 개인 일정(FR-053 강사 가능 시간 · 보드 I36) — 강사 본인만 제목을 보고, 학원에는 「불가 시간」으로만 보인다.
// 수업 등록을 막지는 않는다(겹치면 알리기만). 감사 ×.
model InstructorPersonalEvent {
  id               Uuid                   @id
  staff_account_id Uuid
  staff_account    StaffAccount           @relation(fields: [staff_account_id], references: [id])
  title            String
  starts_at        DateTime(as: temporal)
  ends_at          DateTime(as: temporal)
  repeat_rule      PersonalEventRepeat    @default(none)
  // 반복이 끝나는 날(KST 달력). NULL 이면 지울 때까지 계속 반복한다(추천안 — 보드가 끝나는 날을 받지 않는다).
  repeat_until     Date?
  created_at       DateTime(as: temporal) @default(now())

  // 끝이 시작보다 뒤여야 한다.
  @@check(expression: sql`ends_at > starts_at`, name: "ck_personal_time")
  // 제목은 1~50자(50 은 추천값).
  @@check(expression: sql`char_length(title) BETWEEN 1 AND 50`, name: "ck_personal_title")
  // 반복하지 않는 일정에는 반복 끝 날짜가 없다.
  @@check(expression: sql`repeat_rule <> 'none' OR repeat_until IS NULL`, name: "ck_personal_repeat")
  // 「이 강사의 이 기간 일정」 조회(겹침 판정 S2-1.5 · 일정 화면)가 쓰는 색인.
  @@index([staff_account_id, starts_at], name: "ix_personal_account_time")
  @@map("instructor_personal_events")
}

// 직원 가입 동의 기록 — data-model §8-3(S2-1.2 강사 가입). 추가 전용 기록이라 따로 감사하지 않는다.
// 입점 동의(merchant_consents)는 입점 신청 단위(application_id 필수)라 신청서가 없는 강사 가입에는 쓰지 못한다 — 그래서 따로 둔다.
// 항목마다 1행. 철회해도 지우지 않고 withdrawn_at 만 채운다. agreed_at 은 서버 시각이다.
model StaffConsent {
  id               Uuid                   @id
  staff_account_id Uuid
  staff_account    StaffAccount           @relation(fields: [staff_account_id], references: [id])
  terms_version_id Uuid
  terms_version    TermsVersion           @relation(fields: [terms_version_id], references: [id])
  // 그 판본의 kind 사본 — 「이 사람이 무슨 항목에 동의했나」를 판본 표를 거치지 않고 바로 찾으려고 둔다.
  item             TermsKind
  agreed_at        DateTime(as: temporal)
  withdrawn_at     DateTime(as: temporal)?
  source           StaffConsentSource
  created_at       DateTime(as: temporal) @default(now())

  // 한 사람이 같은 판본에 두 번 동의할 수 없다 — 가입을 두 번 눌러도 동의는 1건이다.
  @@index([staff_account_id, terms_version_id], unique: true, name: "uq_staff_consents")
  // 「이 사람의 이 항목 동의」 조회(동의 기록 화면·재동의)가 쓰는 색인.
  @@index([staff_account_id, item], name: "ix_staff_consents_account")
  @@map("staff_consents")
}

// 회원 가입 동의 항목(S3-1.1(회원 동의 기록 테이블), spec FR-249(약관 동의 기록) · 보드 C14A · M-01(가입 동의 항목)).
//   필수 넷: member_terms(이용약관) · member_privacy_collection(개인정보 수집·이용) · academy_sharing(학원에 개인정보 제공)
//            · age_19_plus(만 19세 이상 확인 — 문서가 아니라 확인 체크라 약관 판본이 없다)
//   선택 둘: marketing_consent(광고성 알림) · location_info(위치 정보)
//   이름은 S7-3 이 terms_versions.kind 에 더할 회원 약관 종류(data-model §12-9)와 같게 맞췄다 — 판본이 생기면 item = kind 사본이 된다.
enum MemberConsentItem {
  @@type("pg/text@1")
  member_terms              = "member_terms"
  member_privacy_collection = "member_privacy_collection"
  academy_sharing           = "academy_sharing"
  age_19_plus               = "age_19_plus"
  marketing_consent         = "marketing_consent"
  location_info             = "location_info"
}

// 회원 동의가 어디서 생겼나 — 가입 때(signup) / 마이 › 알림 설정에서 다시 켬(settings) / 약관이 바뀌어 다시 동의(re_consent, S7-3).
enum MemberConsentSource {
  @@type("pg/text@1")
  signup     = "signup"
  settings   = "settings"
  re_consent = "re_consent"
}

// 회원 동의 기록 — 추가 전용(감사 ×, 이 표 자체가 기록이다). 한 줄 = 「이 회원이 이 항목에 언제 동의했고, 언제 철회했나」.
// 철회하면 있던 줄을 고치지 않고, 원래 동의의 항목·판본·동의 시각을 옮겨 적고 withdrawn_at 을 채운 철회 줄을 더한다
// (S3-1.4(광고성 동의 철회), lib/server/services/member-consent-withdrawal.ts). 철회 뒤 다시 동의하면 또 새 줄을 더한다 — 그래서
// 같은 항목의 줄이 여럿 쌓이고, 「지금 동의 상태」는 그 항목의 가장 최근 줄(agreed_at 이 가장 늦은 줄, 같으면 created_at·id 가
// 늦은 줄)이 정한다(data-model §12-4 notification_settings 「마지막 줄이 권위」).
// 같은 항목에 한 줄만 허락하는 유일 제약은 두지 않는다 — 다시 동의·재동의(S7-3)가 새 줄을 써야 하기 때문이다.
// agreed_at · withdrawn_at 은 서버 시각이다(요청 본문의 시각을 믿지 않는다).
model MemberConsent {
  id               Uuid                   @id
  member_id        Uuid
  member           Member                 @relation(fields: [member_id], references: [id])
  item             MemberConsentItem
  // 동의한 약관 판본. 회원 약관 판본(S7-3.1)이 생기기 전과 판본이 없는 항목(age_19_plus)은 비어 있다.
  terms_version_id Uuid?
  terms_version    TermsVersion?          @relation(fields: [terms_version_id], references: [id])
  agreed_at        DateTime(as: temporal)
  withdrawn_at     DateTime(as: temporal)?
  source           MemberConsentSource
  created_at       DateTime(as: temporal) @default(now())

  // 철회 시각이 동의 시각보다 앞설 수 없다 — 시계가 거꾸로 간 기록을 DB 가 막는다.
  @@check(expression: sql`withdrawn_at IS NULL OR withdrawn_at >= agreed_at`, name: "ck_member_consents_withdrawn_after_agreed")
  // 「이 회원의 이 항목 최신 줄」 조회(가입 판정·알림 발송 전 광고성 동의 확인·마이 화면)가 쓰는 색인.
  @@index([member_id, item, agreed_at], name: "ix_member_consents_member_item")
  @@map("member_consents")
}

// 강사가 시작하는 소속 해제 요청 — data-model §8-3(S2-1.4(강사 쪽 해제 요청), FR-082 · 보드 I28·I28B). 감사 ○.
// 요청만 기록한다. 소속은 그대로 active 이고, 해제는 대표가 계약 11 §9 의 release 로 끝낸다(S2-3).
// 강사가 고른 회차·수강권 처리 값은 대표 화면(W3b·O39) 선택칸에 미리 채우는 「의향」일 뿐이다.
model AffiliationReleaseRequest {
  id                      Uuid                            @id
  affiliation_id          Uuid
  affiliation             InstructorAffiliation           @relation(fields: [affiliation_id], references: [id])
  requested_by_account_id Uuid
  requested_by            StaffAccount                    @relation(name: "release_request_requester", fields: [requested_by_account_id], references: [id])
  status                  AffiliationReleaseRequestStatus @default(requested)
  // [{sessionId, action}] — action: substitute · cancel_session · close
  session_choices         Json                            @default(sql`'[]'::jsonb`)
  // [{passId, action}] — action: finish_first · refund · handover
  private_lesson_choices  Json                            @default(sql`'[]'::jsonb`)
  note                    String?
  requested_at            DateTime(as: temporal)
  resolved_at             DateTime(as: temporal)?
  resolved_by_account_id  Uuid?
  resolved_by             StaffAccount?                   @relation(name: "release_request_resolver", fields: [resolved_by_account_id], references: [id])
  idempotency_key         String(storage: varchar, length: 200)

  // 끝난 요청(완료·취소·거절)에만 처리 시각이 있다.
  @@check(expression: sql`(status <> 'requested') = (resolved_at IS NOT NULL)`, name: "ck_release_req_resolved")
  // 한마디는 200자까지(추천값 — 소속 신청 한마디와 같은 길이).
  @@check(expression: sql`note IS NULL OR char_length(note) <= 200`, name: "ck_release_req_note")
  // 한 소속에 열린 요청은 하나뿐이다. 끝난 요청은 몇 개든 남는다.
  @@index([affiliation_id], unique: true, where: sql`(status = 'requested')`, name: "uq_release_req_open")
  // 같은 강사가 같은 Idempotency-Key 로 다시 보내면 처음 요청을 돌려준다.
  @@index([requested_by_account_id, idempotency_key], unique: true, name: "uq_release_req_idem")
  @@index([affiliation_id], name: "ix_release_req_affiliation")
  @@map("affiliation_release_requests")
}

// ───────────────────────── 개인 레슨 상품·수강권 (S2-4.1(개인 레슨 상품·수강권 테이블), data-model §8-6·§8-7) ─────────────────────────
// 강사가 소속 학원을 골라 「10회 수강권」 같은 개인 레슨 상품을 열고(products), 레슨 모집 시간을 내고(slots),
// 회원이 산 수강권(passes)에서 회차를 하나씩 잡는다(bookings).
//
// 왜 수강권을 주문(orders)에 묶지 않고 따로 두나 — 마스터 플랜 S2-4 열린 점의 추천안(data-model §8-6):
//   수강권 하나 안에서 회차마다 시간·상태·차감이 따로 바뀐다. 주문은 「돈이 오간 기록」으로만 단순하게 두고,
//   남은 횟수·유효기간처럼 쓰면서 바뀌는 값은 이 표들이 맡는다.
// 개인 레슨은 대표에게 보이지 않는다(FR-052c) — 대표 권한 경로는 이 표들(private_lesson_*)을 읽지 않는다.
// 수수료 1% 는 platform_fee_rates 에서 읽으므로 이 표들에는 수수료 칸이 없다(D12).

// 개인 레슨 상품 상태 — open(판매 중) · closed(닫음)
enum PrivateLessonProductStatus {
  @@type("pg/text@1")
  open   = "open"
  closed = "closed"
}

// 레슨 모집 시간 상태(data-model §8-7)
//   open(레슨 모집) ─회원이 결제 시작─▶ held(결제 대기, held_until 까지) ─결제 확정─▶ booked(예약됨)
//   held ─기한 지남·결제 실패─▶ open / booked ─기한 전 회원 취소─▶ open · 강사 사정·늦은 취소─▶ closed
enum PrivateLessonSlotStatus {
  @@type("pg/text@1")
  open   = "open"
  held   = "held"
  booked = "booked"
  closed = "closed"
}

// 회원 수강권 상태 — pending_payment → active → completed(횟수 소진) · expired(기한) / active → refunded(대표 환불, S4)
enum PrivateLessonPassStatus {
  @@type("pg/text@1")
  pending_payment = "pending_payment"
  active          = "active"
  completed       = "completed"
  expired         = "expired"
  refunded        = "refunded"
}

// 잡은 회차 상태. 차감 여부는 상태가 정한다(아래 ck_pl_booking_deduct):
//   돌려줌(차감 없음) = cancelled_instructor(강사 사정) · cancelled_member_free(기한 전 회원 취소)
//   차감 = done(마침) · cancelled_member_late(기한 지난 회원 취소) · no_show(오지 않음)
enum PrivateLessonBookingStatus {
  @@type("pg/text@1")
  booked                = "booked"
  done                  = "done"
  cancelled_instructor  = "cancelled_instructor"
  cancelled_member_free = "cancelled_member_free"
  cancelled_member_late = "cancelled_member_late"
  no_show               = "no_show"
}

// 회차를 누가 잡았나 — 강사가 대신 잡거나(I20B) 회원이 직접 잡는다
enum PrivateLessonBookedBy {
  @@type("pg/text@1")
  instructor = "instructor"
  member     = "member"
}

// 강사×학원 개인 레슨 취소·환불 규칙 판본(I20C) — 추가 전용(고치지 않고 새 판본을 쌓는다).
// 수강권은 만들어질 때의 판본 id 를 가리키므로, 규칙을 바꿔도 이미 산 수강권은 그때 규칙 그대로다.
// 「기한 지난 취소·노쇼 = 1회 차감, 강사 사정 취소 = 회차 복구」는 칸 없이 고정이고, 남은 회차 환불 금액은 대표가 정한다.
model PrivateLessonRuleVersion {
  id                    Uuid                   @id
  academy_id            Uuid
  academy               Academy                @relation(fields: [academy_id], references: [id])
  instructor_account_id Uuid
  instructor            StaffAccount           @relation(fields: [instructor_account_id], references: [id])
  version               Int
  // 레슨 시작 몇 시간 전까지 바꾸거나 취소하면 차감하지 않나(기본 24시간, FR-052c)
  change_deadline_hours Int                    @default(24)
  // 수강권 유효기간(개월, 기본 3개월). 결제일부터 센다(data-model §8-11 ⑧).
  validity_months       Int                    @default(3)
  created_at            DateTime(as: temporal) @default(now())

  // 고를 수 있는 값은 화면(I20C)의 칩 셋뿐이다.
  @@check(expression: sql`change_deadline_hours IN (12, 24, 48)`, name: "ck_pl_rule_deadline")
  @@check(expression: sql`validity_months IN (2, 3, 6)`, name: "ck_pl_rule_validity")
  @@check(expression: sql`version >= 1`, name: "ck_pl_rule_version")
  // 한 강사·한 학원 안에서 판본 번호는 하나뿐이다. 「최신 판본」 조회도 이 색인을 거꾸로 읽는다.
  @@index([academy_id, instructor_account_id, version], unique: true, name: "uq_pl_rule")
  @@map("private_lesson_rule_versions")
}

// 개인 레슨 상품 = classes 의 한 행(class_kind = 'private_lesson')의 짝. 기본 키가 곧 classes.id 다.
// 판매자는 classes.academy_id(개설할 때 고른 학원) — 그 학원이 결제를 받고 정산한다(FR-135a, S2-4 수용 ①).
// 중복 개설은 classes.uq_classes_creator_idempotency 가 막는다. 감사 대상(개설·닫기).
model PrivateLessonProduct {
  class_id                 Uuid                       @id
  class                    Class                      @relation(fields: [class_id], references: [id])
  // 회원이 종목을 고르는 범위(라틴·스탠다드 등). 장르에 세부가 없으면 NULL.
  sub_genre                ClassSubGenre?
  // 한 번 레슨 길이(분) — 50분 또는 80분(I10B)
  lesson_minutes           Int
  // 수강권 한 장의 횟수(기본 10회 — 화면의 −·+ 로 바꾼다. 상한 50 은 앱 추천값)
  session_count            Int                        @default(10)
  price_amount             Int
  status                   PrivateLessonProductStatus @default(open)
  // 개설할 때 붙인 강사 규칙 판본(필수)
  rule_version_id          Uuid
  rule_version             PrivateLessonRuleVersion   @relation(fields: [rule_version_id], references: [id])
  // 학원의 개인 레슨 환불 양식(refund_notice_versions.notice_kind = 'private_lesson')이 있으면 그 판본 id(S2-4.4, 열린 점 ⑨)
  refund_notice_version_id Uuid?
  refund_notice_version    RefundNoticeVersion?       @relation(fields: [refund_notice_version_id], references: [id])
  idempotency_key          String(storage: varchar, length: 200)
  created_at               DateTime(as: temporal)     @default(now())
  updated_at               DateTime(as: temporal)

  @@check(expression: sql`lesson_minutes IN (50, 80)`, name: "ck_pl_product_minutes")
  @@check(expression: sql`session_count >= 1`, name: "ck_pl_product_count")
  @@check(expression: sql`price_amount >= 0`, name: "ck_pl_product_price")
  @@map("private_lesson_products")
}

// 레슨 모집 시간(「레슨 모집」으로 회원에게 보이는 시간). 같은 강사·같은 강의실의 살아 있는 시간끼리 겹치면
// DB 가 거부한다(ex_pl_slots_instructor · ex_pl_slots_room — 계약 문법에 EXCLUDE 가 없어 마이그레이션의 rawSql 로 넣는다).
// 단체 수업 회차(class_sessions)와의 겹침은 테이블이 달라 EXCLUDE 로 못 묶으므로 같은 강사의 어드바이저리 잠금 안에서 앱이 본다(data-model §8 머리).
model PrivateLessonSlot {
  id                    Uuid                    @id
  product_class_id      Uuid
  product               PrivateLessonProduct    @relation(fields: [product_class_id], references: [class_id])
  academy_id            Uuid
  academy               Academy                 @relation(fields: [academy_id], references: [id])
  instructor_account_id Uuid
  instructor            StaffAccount            @relation(fields: [instructor_account_id], references: [id])
  room_id               Uuid?
  room                  Room?                   @relation(fields: [room_id], references: [id])
  starts_at             DateTime(as: temporal)
  ends_at               DateTime(as: temporal)
  status                PrivateLessonSlotStatus @default(open)
  // 결제 대기(held)로 잡아 둔 기한(I10 「결제 대기 · 10/17 23:59까지」). 지나면 시간 작업이 open 으로 돌린다(S2-4.9).
  held_until            DateTime(as: temporal)?
  // 「매주 반복」으로 한꺼번에 만든 시간을 묶는 값. 한 번만 만든 시간은 NULL.
  repeat_group_id       Uuid?
  created_at            DateTime(as: temporal)  @default(now())

  @@check(expression: sql`ends_at > starts_at`, name: "ck_pl_slot_time")
  // 결제 대기에만 기한이 있고, 다른 상태에는 없다.
  @@check(expression: sql`(status = 'held') = (held_until IS NOT NULL)`, name: "ck_pl_slot_held")
  // 상품별 열린 시간을 시간순으로(회원이 첫 시간을 고르는 화면)
  @@index([product_class_id, starts_at], where: sql`(status = 'open')`, name: "ix_pl_slots_product_time")
  @@map("private_lesson_slots")
}

// 회원의 수강권. 남은 횟수 = sessions_total − sessions_used.
// 결제 전(pending_payment)에는 결제 시각·유효기간이 없고, 결제되면 valid_until = paid_at + 규칙의 validity_months 다.
// 구매 흐름(회원 M15B)과 주문 연결은 M3 가 붙인다(열린 점 ⑫) — 그래서 order_id 는 비어 있을 수 있다.
model PrivateLessonPass {
  id               Uuid                     @id
  product_class_id Uuid
  product          PrivateLessonProduct     @relation(fields: [product_class_id], references: [class_id])
  member_id        Uuid
  member           Member                   @relation(fields: [member_id], references: [id])
  order_id         Uuid?
  order            Order?                   @relation(fields: [order_id], references: [id])
  // 이 수강권을 만들 때의 규칙 판본 — 나중에 규칙이 바뀌어도 이 수강권은 이 판본을 따른다
  rule_version_id  Uuid
  rule_version     PrivateLessonRuleVersion @relation(fields: [rule_version_id], references: [id])
  // 회원이 고른 종목(상품의 sub_genre 범위 안 — 앱 검사)
  discipline       ClassDiscipline?
  status           PrivateLessonPassStatus  @default(pending_payment)
  sessions_total   Int
  // 차감된 수 = 마친 회차 + 늦은 취소 + 오지 않음
  sessions_used    Int                      @default(0)
  paid_at          DateTime(as: temporal)?
  valid_until      DateTime(as: temporal)?
  created_at       DateTime(as: temporal)   @default(now())
  updated_at       DateTime(as: temporal)

  // 설계에 없던 방어선 하나: 0회 수강권은 말이 안 된다(상품의 session_count >= 1 과 같은 기준).
  @@check(expression: sql`sessions_total >= 1`, name: "ck_pl_pass_total")
  // 차감 수는 0 과 전체 횟수 사이 — 횟수보다 많이 차감되지 않는다.
  @@check(expression: sql`sessions_used BETWEEN 0 AND sessions_total`, name: "ck_pl_pass_used")
  // 쓰는 중·다 쓴·기한 지난 수강권에는 결제 시각과 유효기간이 꼭 있다.
  @@check(expression: sql`status NOT IN ('active', 'completed', 'expired') OR (valid_until IS NOT NULL AND paid_at IS NOT NULL)`, name: "ck_pl_pass_active")
  // 주문 하나 = 수강권 하나
  @@index([order_id], unique: true, where: sql`(order_id IS NOT NULL)`, name: "uq_pl_pass_order")
  @@index([member_id, status], name: "ix_pl_pass_member")
  // 강사 화면의 상품별 수강생 목록(I20)
  @@index([product_class_id, status], name: "ix_pl_pass_product")
  @@map("private_lesson_passes")
}

// 수강권에서 잡은 회차 하나. 차감 여부(deducted)는 상태와 짝이 맞아야 한다(ck_pl_booking_deduct).
// 24시간 규칙 판정(S2-4.3)은 slot.starts_at − now() 가 규칙의 기한 이상이면 cancelled_member_free, 아니면 cancelled_member_late.
model PrivateLessonBooking {
  id            Uuid                       @id
  pass_id       Uuid
  pass          PrivateLessonPass          @relation(fields: [pass_id], references: [id])
  slot_id       Uuid
  slot          PrivateLessonSlot          @relation(fields: [slot_id], references: [id])
  status        PrivateLessonBookingStatus @default(booked)
  booked_by     PrivateLessonBookedBy
  deducted      Boolean                    @default(false)
  cancel_reason String?
  cancelled_at  DateTime(as: temporal)?
  created_at    DateTime(as: temporal)     @default(now())
  updated_at    DateTime(as: temporal)

  // 취소 상태(cancelled_*)에만 취소 시각이 있다.
  @@check(expression: sql`(status LIKE 'cancelled\_%') = (cancelled_at IS NOT NULL)`, name: "ck_pl_booking_cancel")
  // 강사 사정·기한 전 회원 취소는 돌려주고(차감 없음), 마침·늦은 취소·노쇼는 차감한다.
  @@check(
    expression: sql`(status NOT IN ('cancelled_instructor', 'cancelled_member_free') OR deducted = false) AND (status NOT IN ('cancelled_member_late', 'no_show', 'done') OR deducted = true)`,
    name: "ck_pl_booking_deduct"
  )
  // 한 시간에 살아 있는 레슨은 하나뿐이다. 취소된 회차는 몇 개든 남는다.
  @@index([slot_id], unique: true, where: sql`(status = 'booked')`, name: "uq_pl_booking_slot_live")
  @@index([pass_id, status], name: "ix_pl_booking_pass")
  @@map("private_lesson_bookings")
}

// ---- MX(AI 트랙) · SX-2(포스터 읽기·수업 초안) — data-model §13-3 · §13-5 · 계약 16 §4-6 · §7 --------------------------

// 에이전트에게 맡긴 비동기 작업의 종류(§13-8). 포스터 읽기 · 홍보 이미지 · FAQ 초안.
enum AiJobKind {
  @@type("pg/text@1")
  poster_extract = "poster_extract"
  promo_image    = "promo_image"
  faq_draft      = "faq_draft"
}

// 작업 상태(계약 16 §9). queued → running → succeeded · failed · timed_out · cancelled
enum AiJobStatus {
  @@type("pg/text@1")
  queued    = "queued"
  running   = "running"
  succeeded = "succeeded"
  failed    = "failed"
  timed_out = "timed_out"
  cancelled = "cancelled"
}

// 작업 실패 이유(§13-8)
enum AiJobErrorCode {
  @@type("pg/text@1")
  EXTRACTION_FAILED        = "EXTRACTION_FAILED"
  PROVIDER_QUOTA_EXHAUSTED = "PROVIDER_QUOTA_EXHAUSTED"
  PROVIDER_ERROR           = "PROVIDER_ERROR"
  INVALID_RESULT           = "INVALID_RESULT"
  AGENT_UNAVAILABLE        = "AGENT_UNAVAILABLE"
  TIMEOUT                  = "TIMEOUT"
}

// 에이전트에게 맡긴 작업 한 건(data-model §13-3). 결과는 kind 마다 다른 표(포스터 → poster_extractions)에 쓴다.
// subject_id 는 kind 마다 다른 표를 가리켜 FK 를 걸 수 없다 — 대신 그 표가 job_id 로 이 행을 가리키고, 결과 전달 서비스가 짝을 확인한다.
model AiJob {
  id          Uuid                    @id
  kind        AiJobKind
  status      AiJobStatus             @default(queued)
  subject_id  Uuid
  deadline_at DateTime(as: temporal)
  // 에이전트가 202 를 준 때. NULL 이면 아직 에이전트가 받지 않았다(sweep 이 기한 뒤 닫는다)
  accepted_at DateTime(as: temporal)?
  finished_at DateTime(as: temporal)?
  error_code  AiJobErrorCode?
  created_at  DateTime(as: temporal)  @default(now())
  // 이 작업이 채우는 포스터 읽기 — DB 칸이 아니라 관계다.
  poster_extractions PosterExtraction[]
  // 이 작업이 채우는 홍보 이미지 만들기(SX-6.5) — DB 칸이 아니라 관계다.
  promo_image_generations PromoImageGeneration[]

  // 끝난 작업(succeeded·failed·timed_out·cancelled)은 끝난 때가 있다.
  @@check(expression: sql`status NOT IN ('succeeded', 'failed', 'timed_out', 'cancelled') OR finished_at IS NOT NULL`, name: "ck_ai_jobs_done")
  // 실패·기한 초과에는 이유가 있다.
  @@check(expression: sql`status NOT IN ('failed', 'timed_out') OR error_code IS NOT NULL`, name: "ck_ai_jobs_error")
  // 한 행에 작업 하나 — 다시 읽기는 새 행(새 포스터 읽기)이다.
  @@index([kind, subject_id], unique: true, name: "uq_ai_jobs_subject")
  // sweep 이 기한 지난 열린 작업을 훑는다.
  @@index([deadline_at], where: sql`(status IN ('queued', 'running'))`, name: "ix_ai_jobs_open_deadline")
  @@map("ai_jobs")
}

// 포스터 읽기 대상(§13-8). 칸 키는 지금 정규 수업 기준(계약 16 열린 점 ⑬)이다.
enum PosterTargetKind {
  @@type("pg/text@1")
  class       = "class"
  party       = "party"
  performance = "performance"
  competition = "competition"
}

// 포스터 읽기 상태(계약 16 §9). ready ↔ reviewed(PATCH 하면 ready 로) → submitted. 검토 끝 없이 submitted 로 갈 길은 없다(FR-074)
enum PosterExtractionStatus {
  @@type("pg/text@1")
  queued    = "queued"
  running   = "running"
  ready     = "ready"
  failed    = "failed"
  reviewed  = "reviewed"
  submitted = "submitted"
  abandoned = "abandoned"
}

enum PosterFailureCode {
  @@type("pg/text@1")
  EXTRACTION_FAILED = "EXTRACTION_FAILED"
  AGENT_UNAVAILABLE = "AGENT_UNAVAILABLE"
  TIMEOUT           = "TIMEOUT"
  INVALID_RESULT    = "INVALID_RESULT"
}

// 포스터 칸 키 14개(계약 16 §4-6 · §13-8). agent-server/app/poster/field_rules.py 의 POSTER_FIELD_KEYS 와 같은 글자다.
enum PosterFieldKey {
  @@type("pg/text@1")
  genre           = "genre"
  genre_detail    = "genre_detail"
  title           = "title"
  weekday         = "weekday"
  start_time      = "start_time"
  end_time        = "end_time"
  // 기간 칸 3개(SX-2.6, spec FR-073 하위 불릿 2026-11-24) — 개강일 · 종료일 · 회차 수. 비면 검토에서 채워야 제출할 수 있다
  start_date      = "start_date"
  end_date        = "end_date"
  session_count   = "session_count"
  room_name       = "room_name"
  price_amount    = "price_amount"
  capacity_male   = "capacity_male"
  capacity_female = "capacity_female"
  capacity_total  = "capacity_total"
  instructor_name = "instructor_name"
  level           = "level"
  class_kind      = "class_kind"
}

// 칸 값을 누가 채웠나 — AI(「AI 생성」 표시, FR-258) · 사람 · AI 값을 사람이 고침
enum PosterValueSource {
  @@type("pg/text@1")
  ai        = "ai"
  user      = "user"
  ai_edited = "ai_edited"
}

// 포스터 한 장의 읽기·검토·제출 상태(data-model §13-5). 감사: 검토 끝·제출.
model PosterExtraction {
  id                           Uuid                    @id
  academy_id                   Uuid
  academy                      Academy                 @relation(fields: [academy_id], references: [id])
  uploaded_by_staff_account_id Uuid
  uploaded_by                  StaffAccount            @relation(name: "poster_uploader", fields: [uploaded_by_staff_account_id], references: [id])
  source_file_id               Uuid
  source_file                  UploadedFile            @relation(fields: [source_file_id], references: [id])
  target_kind                  PosterTargetKind
  status                       PosterExtractionStatus  @default(queued)
  // 값을 고칠 때마다 +1(낙관 잠금 — 계약 16 §4-6 PATCH)
  revision                     Int                     @default(1)
  overall_confidence           Float?
  failure_code                 PosterFailureCode?
  job_id                       Uuid?
  job                          AiJob?                  @relation(fields: [job_id], references: [id])
  model                        String?
  elapsed_ms                   Int?
  reviewed_at                  DateTime(as: temporal)?
  reviewed_by_staff_account_id Uuid?
  reviewed_by                  StaffAccount?           @relation(name: "poster_reviewer", fields: [reviewed_by_staff_account_id], references: [id])
  submitted_class_id           Uuid?
  submitted_class              Class?                  @relation(fields: [submitted_class_id], references: [id])
  submitted_at                 DateTime(as: temporal)?
  created_at                   DateTime(as: temporal)  @default(now())
  updated_at                   DateTime(as: temporal)
  fields                       PosterExtractionField[]

  @@check(expression: sql`revision >= 1`, name: "ck_poster_revision")
  @@check(expression: sql`overall_confidence IS NULL OR (overall_confidence >= 0 AND overall_confidence <= 1)`, name: "ck_poster_confidence")
  // 검토 끝 표시 없이 reviewed·submitted 가 될 수 없다 — FR-074(검토를 건너뛰는 경로 없음)의 DB 쪽 방어선.
  // 아직 검토 전(queued·running·ready·failed)이면 검토 칸은 비어 있다(PATCH 가 reviewed → ready 로 돌리며 비운다).
  @@check(
    expression: sql`(status NOT IN ('reviewed', 'submitted') OR (reviewed_at IS NOT NULL AND reviewed_by_staff_account_id IS NOT NULL)) AND (status NOT IN ('queued', 'running', 'ready', 'failed') OR reviewed_at IS NULL)`,
    name: "ck_poster_reviewed"
  )
  // 제출(submitted)과 만든 수업 id 는 함께 있거나 함께 없다.
  @@check(expression: sql`(status = 'submitted') = (submitted_class_id IS NOT NULL)`, name: "ck_poster_submitted")
  // 실패(failed)와 실패 이유는 함께 있거나 함께 없다.
  @@check(expression: sql`(status = 'failed') = (failure_code IS NOT NULL)`, name: "ck_poster_failed")
  // 올린 파일 하나에 읽기 하나 — 다시 읽으려면 다시 올린다.
  @@index([source_file_id], unique: true, name: "uq_poster_source_file")
  // 한 수업은 한 포스터에서만 만들어진다.
  @@index([submitted_class_id], unique: true, where: sql`(submitted_class_id IS NOT NULL)`, name: "uq_poster_submitted_class")
  @@index([academy_id, status, created_at], name: "ix_poster_academy_status")
  // 위임 강사는 자기가 올린 것만 본다(W30).
  @@index([uploaded_by_staff_account_id, created_at], name: "ix_poster_uploader")
  @@map("poster_extractions")
}

// 칸별 읽은 값·신뢰도·확인필요·AI/사람 표시(data-model §13-5). 값 모양은 칸마다 앱(lib/domain/poster-extraction.ts)이 zod 로 본다.
model PosterExtractionField {
  extraction_id Uuid
  extraction    PosterExtraction       @relation(fields: [extraction_id], references: [id])
  field_key     PosterFieldKey
  value         Json?
  confidence    Float?
  needs_check   Boolean
  value_source  PosterValueSource      @default(ai)
  confirmed_at  DateTime(as: temporal)?
  updated_at    DateTime(as: temporal)

  @@id([extraction_id, field_key])
  @@check(expression: sql`confidence IS NULL OR (confidence >= 0 AND confidence <= 1)`, name: "ck_poster_field_conf")
  // 사람이 손댄 칸은 확인필요가 아니다.
  @@check(expression: sql`value_source NOT IN ('user', 'ai_edited') OR needs_check = false`, name: "ck_poster_field_user_checked")
  // AI 가 못 읽은 칸(값 없음)은 반드시 확인필요다 — FR-075. 사람이 검토에서 「비어 있는 게 맞다」고 확인한 칸(confirmed_at)만 예외다
  // (data-model §13-5 원문은 confirmed_at 예외가 없어 빈 칸을 확인할 길이 막혔다 — SX-2.3 에서 더했다, EVIDENCE.md 기록).
  @@check(expression: sql`value_source <> 'ai' OR value IS NOT NULL OR needs_check OR confirmed_at IS NOT NULL`, name: "ck_poster_field_null_flagged")
  @@map("poster_extraction_fields")
}

// ───────────────────────── 12-4. 알림 설정·푸시 (S7-1.2(푸시 토큰·알림 설정 테이블)) ─────────────────────────
// 설계 원본: data-model §12-4 「알림 설정·푸시」 · §12-9 값 집합. 보드 C1A(회원 알림 설정) · O34(직원 휴대폰 알림).
// 세 표 모두 「푸시를 보낼까」만 정한다. 앱 알림함(notifications) 행은 설정과 상관없이 늘 쓴다(15 §1 「알림함은 항상」).

// 수업 전 알림을 언제 받을지 — 하루 전 / 2시간 전 / 1시간 전 / 30분 전(보드 C1A). 기본은 1시간 전.
enum PreClassLead {
  @@type("pg/text@1")
  day_before = "day_before"
  two_hours  = "two_hours"
  one_hour   = "one_hour"
  thirty_min = "thirty_min"
}

// 직원(대표·강사)이 휴대폰 푸시를 끌 수 있는 주제 5개(O34). 수업 승인 / 행사 정원 / 문의 / 일정·연습실 / 플랫폼 공지.
// 끌 수 없는 주제(환불 요청·결제 실패·정산 승인)는 일부러 여기에 없다 — 행을 만들 자리 자체가 없어 DB 가 「끄기」를 막는다.
enum StaffNotificationTopic {
  @@type("pg/text@1")
  class_approval  = "class_approval"
  event_capacity  = "event_capacity"
  inquiry         = "inquiry"
  schedule_room   = "schedule_room"
  platform_notice = "platform_notice"
}

// 푸시 토큰을 낸 기기 종류. 베타는 안드로이드만 낸다(배포 정책) — iOS 를 열 때 값을 더한다.
enum PushPlatform {
  @@type("pg/text@1")
  android = "android"
}

// 기기의 알림 권한 상태 — 허용 / 거부 / 아직 모름(권한 창을 안 띄웠다). 거부면 푸시를 건너뛰고 사유를 no_permission 으로 남긴다.
enum PushPermissionState {
  @@type("pg/text@1")
  granted = "granted"
  denied  = "denied"
  unknown = "unknown"
}

// 회원 알림 설정 — 회원당 한 줄(감사 ×, 본인 설정). 행이 없으면 읽을 때 기본값(1시간 전·쿠폰 켬·대기 켬)을 쓰고,
// 회원이 처음 바꿀 때 행을 만든다(data-model 열린 점 ⑩ 임시 확정). 그래서 기본값을 바꿀 때 마이그레이션이 없어도 된다.
// 광고성 알림 동의는 이 표에 두지 않는다 — 동의·철회 시각이 쌓여야 해서 member_consents(marketing_consent)가 권위다(FR-249).
model NotificationSetting {
  member_id            Uuid                   @id
  member               Member                 @relation(fields: [member_id], references: [id])
  pre_class_lead       PreClassLead           @default(one_hour)
  coupon_expiry_notice Boolean                @default(true)
  waitlist_notice      Boolean                @default(true)
  updated_at           DateTime(as: temporal)

  @@map("notification_settings")
}

// 직원 휴대폰 알림 설정 — (계정, 주제) 한 줄(O34). 행이 없으면 켜짐이다. 끄는 것은 휴대폰 푸시뿐이고 알림함 행은 계속 쓴다.
model StaffNotificationSetting {
  staff_account_id Uuid
  staff_account    StaffAccount           @relation(fields: [staff_account_id], references: [id])
  topic            StaffNotificationTopic
  phone_enabled    Boolean                @default(true)
  updated_at       DateTime(as: temporal)

  @@id([staff_account_id, topic])
  @@map("staff_notification_settings")
}

// 기기 푸시 토큰 — 한 줄 = 「이 기기의 이 토큰은 지금 이 계정 것」. 주인은 회원이나 직원 둘 중 정확히 하나다.
// 같은 기기에서 다른 계정으로 로그인하면 옛 줄을 revoked_at 으로 닫고 새 줄을 쓴다 — 지우지 않아 「언제 누구 기기였나」가 남는다.
// 토큰 값은 비밀은 아니지만 계정과 묶여 있어 응답·로그에 내리지 않는다(로그에는 앞 6자만).
model PushToken {
  id               Uuid                   @id
  member_id        Uuid?
  member           Member?                @relation(fields: [member_id], references: [id])
  staff_account_id Uuid?
  staff_account    StaffAccount?          @relation(fields: [staff_account_id], references: [id])
  platform         PushPlatform           @default(android)
  token            String
  device_id        String
  permission_state PushPermissionState
  last_seen_at     DateTime(as: temporal) @default(now())
  revoked_at       DateTime(as: temporal)?
  created_at       DateTime(as: temporal) @default(now())

  // 주인은 회원·직원 중 정확히 하나 — 둘 다 비거나 둘 다 차면 어느 계정에 보낼지 모른다.
  @@check(expression: sql`num_nonnulls(member_id, staff_account_id) = 1`, name: "ck_push_tokens_one_owner")
  // 빈 토큰·빈 기기 번호는 보낼 곳이 없는 줄이라 막는다(추천안 — 설계에 없던 CHECK, EVIDENCE.md 기록).
  @@check(expression: sql`char_length(token) > 0 AND char_length(device_id) > 0`, name: "ck_push_tokens_not_blank")
  // 닫는 시각은 만든 시각보다 앞설 수 없다(추천안 — 설계에 없던 CHECK).
  @@check(expression: sql`revoked_at IS NULL OR revoked_at >= created_at`, name: "ck_push_tokens_revoked_after_created")
  // 같은 토큰은 살아 있는 줄 하나에만 — 한 기기 알림이 두 계정으로 가지 않게 한다. 닫힌 줄은 몇 개든 이력으로 남는다.
  @@index([token], unique: true, where: sql`(revoked_at IS NULL)`, name: "uq_push_tokens_token")
  // 「이 회원·이 직원에게 보낼 살아 있는 토큰」 조회(발송 작업)가 쓰는 색인.
  @@index([member_id], where: sql`(revoked_at IS NULL)`, name: "ix_push_tokens_member")
  @@index([staff_account_id], where: sql`(revoked_at IS NULL)`, name: "ix_push_tokens_staff")
  @@map("push_tokens")
}

// ───────────────────────── 12-5. 문의·신고 (S7-2.1(문의·답변·신고 테이블)) ─────────────────────────
// 설계 원본: data-model §12 「문의 (S7-2)」·「신고·이용 제한 (S7-2 · S7-4)」 · §12-9 값 집합 · 계약 15-ops §2.
// 이 Task 는 표 세 개만 만든다 — inquiries(문의 한 건) · inquiry_messages(그 문의 안의 글, 추가 전용) · reports(신고).
// 이용 제한 절차(restriction_cases)는 S7-2.6, 첨부(attachment_links)는 S7-2.7 이 만든다. reports.restriction_case_id 의 FK 는
// S7-2.6 이 표를 만들 때 붙였다(refund_request_id 는 아직 칸만 — 환불 요청 표와 잇는 일은 S7-2.4).

// 문의를 받는 곳 — 학원(대표가 답함) / 플랫폼(운영자가 답함). 대표는 자기 학원 academy 문의만, 운영자는 system 문의만 본다(FR-204).
enum InquiryKind {
  @@type("pg/text@1")
  academy = "academy"
  system  = "system"
}

// 문의를 쓴 사람의 종류 — 회원 / 강사 / 대표. 회원이면 asker_member_id, 강사·대표면 asker_staff_account_id 를 채운다.
enum InquiryAskerKind {
  @@type("pg/text@1")
  member     = "member"
  instructor = "instructor"
  owner      = "owner"
}

// 문의가 들어온 길 — 처음부터 사람에게(human) / AI 상담에서 사람에게 넘어옴(ai_handoff, SX-3).
enum InquiryRoute {
  @@type("pg/text@1")
  human      = "human"
  ai_handoff = "ai_handoff"
}

// 문의 상태 — 답변 대기 / 답변함 / 닫힘 / AI 가 답함(MX 가 쓴다). 지금은 닫는 경로가 없다(data-model 12-11 ①).
enum InquiryStatus {
  @@type("pg/text@1")
  answer_waiting = "answer_waiting"
  answered       = "answered"
  closed         = "closed"
  ai_answered    = "ai_answered"
}

// 문의 종류 칩 — 세 무리의 값을 한 집합으로 둔다(§12-9). 어느 무리에서 고를 수 있는지는 앱이 (asker_kind, kind) 짝으로 본다.
//   회원 → 학원: class · refund · schedule · other
//   강사 → 학원: settlement_basis(정산 금액 근거) · capacity(정원) · absence(결석, D10) · other
//   플랫폼:     account · app_error · payment_outage · membership · other
enum InquiryCategory {
  @@type("pg/text@1")
  class            = "class"
  refund           = "refund"
  schedule         = "schedule"
  settlement_basis = "settlement_basis"
  capacity         = "capacity"
  absence          = "absence"
  account          = "account"
  app_error        = "app_error"
  payment_outage   = "payment_outage"
  membership       = "membership"
  other            = "other"
}

// 문의 글을 쓴 쪽 — 문의자 / 학원 대표 / 운영자 / AI.
enum InquiryMessageSenderKind {
  @@type("pg/text@1")
  asker         = "asker"
  academy_owner = "academy_owner"
  operator      = "operator"
  ai            = "ai"
}

// 신고한 사람의 종류 — 문의자 종류와 같은 세 값이다.
enum ReportReporterKind {
  @@type("pg/text@1")
  member     = "member"
  instructor = "instructor"
  owner      = "owner"
}

// 신고 대상 — 학원 / 강사 / 수업 / 회원. 대상 id(target_id)는 종류마다 다른 표를 가리켜 FK 를 걸지 않는다.
enum ReportTargetKind {
  @@type("pg/text@1")
  academy    = "academy"
  instructor = "instructor"
  class      = "class"
  member     = "member"
}

// 신고 진행 — 접수 / 검토 중 / 처리 끝.
enum ReportStatus {
  @@type("pg/text@1")
  received  = "received"
  in_review = "in_review"
  resolved  = "resolved"
}

// 신고 처리 결과 — 기각(dismissed) / 인정(upheld). 인정하고 조치가 필요하면 이용 제한 절차(S7-2.6)를 연다.
enum ReportOutcome {
  @@type("pg/text@1")
  dismissed = "dismissed"
  upheld    = "upheld"
}

// 신고 사유 — 플랫폼 밖 결제 유도(FR-255) / 정보 불일치 / 괴롭힘 / 불법·위험 / 기타.
enum ReportReasonCode {
  @@type("pg/text@1")
  off_platform_payment = "off_platform_payment"
  info_mismatch        = "info_mismatch"
  harassment           = "harassment"
  illegal_dangerous    = "illegal_dangerous"
  other                = "other"
}

// 문의 한 건 — 「누가 · 어디에 · 무슨 종류로 · 지금 어떤 상태인지」만 담는다. 실제 글은 inquiry_messages 에 쌓인다.
// 감사 기록을 따로 남기지 않는다 — 이 표와 inquiry_messages 자체가 기록이다. 보존은 분쟁 처리 기록으로 3년.
model Inquiry {
  id                     Uuid                   @id
  kind                   InquiryKind
  asker_kind             InquiryAskerKind
  asker_member_id        Uuid?
  asker_member           Member?                @relation(fields: [asker_member_id], references: [id])
  asker_staff_account_id Uuid?
  asker_staff_account    StaffAccount?          @relation(fields: [asker_staff_account_id], references: [id])
  // 받는 학원. 플랫폼 문의(system)는 비어 있다.
  academy_id             Uuid?
  academy                Academy?               @relation(fields: [academy_id], references: [id])
  category               InquiryCategory
  // 회원이 「이 예약에 대해」 물을 때만 채운다(강사·대표 문의에는 예약이 없다).
  reservation_id         Uuid?
  reservation            Reservation?           @relation(fields: [reservation_id], references: [id])
  offering_id            Uuid?
  offering               ClassOffering?         @relation(fields: [offering_id], references: [id])
  // S4-1 의 환불 요청과 잇는 칸(S7-2.4). 환불 요청 표가 아직 없어 FK 없이 둔다.
  refund_request_id      Uuid?
  // 강사의 「정산 금액 근거」 문의가 가리키는 정산 줄(M5). 표가 여럿이라 FK 를 걸지 않는다.
  related_settlement_ref Uuid?
  route                  InquiryRoute           @default(human)
  ai_conversation_id     String?
  status                 InquiryStatus          @default(answer_waiting)
  // 첫 답변 기한(1영업일, ops_settings inquiry.response_business_days). 넘기면 재알림 작업(S7-2.3)이 대표에게 다시 알린다.
  first_response_due_at  DateTime(as: temporal)
  overdue_reminded_at    DateTime(as: temporal)?
  last_message_at        DateTime(as: temporal) @default(now())
  closed_at              DateTime(as: temporal)?
  // 같은 요청을 두 번 보내도 문의가 한 건만 생기게 하는 열쇠(헤더 Idempotency-Key).
  idempotency_key        String(storage: varchar, length: 200)
  created_at             DateTime(as: temporal) @default(now())
  messages               InquiryMessage[]

  // 문의자는 회원이나 직원 둘 중 정확히 하나 — 회원 문의는 회원 번호만, 강사·대표 문의는 직원 계정 번호만 찬다.
  @@check(
    expression: sql`(asker_kind = 'member' AND asker_member_id IS NOT NULL AND asker_staff_account_id IS NULL) OR (asker_kind <> 'member' AND asker_staff_account_id IS NOT NULL AND asker_member_id IS NULL)`,
    name: "ck_inquiries_asker"
  )
  // 학원 문의에는 받는 학원이 꼭 있고, 플랫폼 문의에는 학원이 없다 — 대표 조회 범위가 이 칸 하나로 갈린다.
  @@check(expression: sql`(kind = 'academy') = (academy_id IS NOT NULL)`, name: "ck_inquiries_target")
  // 예약을 가리키는 문의는 회원 문의뿐이다.
  @@check(expression: sql`reservation_id IS NULL OR asker_kind = 'member'`, name: "ck_inquiries_reservation_member")
  // 닫힌 문의만 닫은 시각이 있다(추천안 — 설계에 없던 CHECK, 증거 EVIDENCE.md 기록).
  @@check(expression: sql`(status = 'closed') = (closed_at IS NOT NULL)`, name: "ck_inquiries_closed")
  // 빈 열쇠는 「같은 요청」을 가려내지 못한다(추천안).
  @@check(expression: sql`char_length(idempotency_key) > 0`, name: "ck_inquiries_idempotency_key")
  // 같은 사람이 같은 열쇠로 두 번 보내면 두 번째는 거부된다. 회원·직원 중 한쪽이 늘 NULL 이라 부분 UNIQUE 두 개로 나눈다.
  @@index([asker_member_id, idempotency_key], unique: true, where: sql`(asker_member_id IS NOT NULL)`, name: "uq_inquiries_idem_member")
  @@index([asker_staff_account_id, idempotency_key], unique: true, where: sql`(asker_staff_account_id IS NOT NULL)`, name: "uq_inquiries_idem_staff")
  // 대표 문의함(학원별 · 상태별 · 최근 순). 설계는 created_at DESC 지만 계약 문법에 정렬 방향 인자가 없어 오름차순으로 둔다
  // — btree 는 거꾸로도 읽으므로 「최근 순」 조회가 같은 색인을 탄다(다른 표와 같은 방식).
  @@index([academy_id, status, created_at], where: sql`(academy_id IS NOT NULL)`, name: "ix_inquiries_academy_status")
  // 「내 문의」 목록(회원 · 직원).
  @@index([asker_member_id, created_at], name: "ix_inquiries_asker_member")
  @@index([asker_staff_account_id, created_at], name: "ix_inquiries_asker_staff")
  // 응답 기한 재알림 작업 전용 — 아직 답이 없고 재알림도 안 한 건만 담는다.
  @@index([first_response_due_at], where: sql`(status = 'answer_waiting' AND overdue_reminded_at IS NULL)`, name: "ix_inquiries_overdue")
  @@map("inquiries")
}

// 문의 안의 글 한 줄 — 문의자의 첫 글·추가 글, 대표·운영자 답변, AI 답변이 모두 여기에 쌓인다.
// 추가 전용: 고치거나 지우면 DB 트리거가 거부한다(마이그레이션 rawSql, audit_logs 와 같은 방식 — 계약으로는 표현되지 않는다).
model InquiryMessage {
  id                      Uuid                     @id
  inquiry_id              Uuid
  inquiry                 Inquiry                  @relation(fields: [inquiry_id], references: [id])
  sender_kind             InquiryMessageSenderKind
  sender_member_id        Uuid?
  sender_member           Member?                  @relation(fields: [sender_member_id], references: [id])
  sender_staff_account_id Uuid?
  sender_staff_account    StaffAccount?            @relation(fields: [sender_staff_account_id], references: [id])
  body                    String
  // 답변·추가 글 경로의 Idempotency-Key(S7-2.3 — 추천안·사후 확인 2026-11-24). 첫 글은 inquiries.idempotency_key 가 맡아 비워 둔다.
  idempotency_key         String(storage: varchar, length: 200)?
  created_at              DateTime(as: temporal)   @default(now())

  // 보낸 쪽과 번호 칸이 짝이 맞아야 한다.
  //   asker: 회원·직원 번호 중 정확히 하나(문의자 종류와 같은 쪽인지는 표 사이 비교라 앱이 본다)
  //   academy_owner·operator: 직원 번호만 · ai: 둘 다 비어 있다
  @@check(
    expression: sql`(sender_kind = 'asker' AND num_nonnulls(sender_member_id, sender_staff_account_id) = 1) OR (sender_kind IN ('academy_owner', 'operator') AND sender_staff_account_id IS NOT NULL AND sender_member_id IS NULL) OR (sender_kind = 'ai' AND sender_member_id IS NULL AND sender_staff_account_id IS NULL)`,
    name: "ck_inquiry_messages_sender"
  )
  // 글은 1~2000자(임시 확정 2026-11-20 — 추천안, 사후 확인).
  @@check(expression: sql`char_length(body) BETWEEN 1 AND 2000`, name: "ck_inquiry_messages_body")
  // 문의 하나의 대화를 시간 순으로 읽는 색인.
  @@index([inquiry_id, created_at], name: "ix_inquiry_messages_inquiry")
  // 같은 문의에 같은 열쇠로 두 번 답하면 두 번째는 첫 글을 돌려준다(재생). 빈 열쇠는 받지 않는다.
  @@check(expression: sql`idempotency_key IS NULL OR char_length(idempotency_key) > 0`, name: "ck_inquiry_messages_idempotency_key")
  @@index([inquiry_id, idempotency_key], unique: true, where: sql`(idempotency_key IS NOT NULL)`, name: "uq_inquiry_messages_idem")
  @@map("inquiry_messages")
}

// 신고 한 건 — 누가 무엇을 어떤 사유로 신고했고, 운영자가 어떻게 처리했는지. 처리 결과는 감사 기록에도 남긴다(S7-2.5).
// 신고받은 상대에게는 신고자 정보를 내리지 않는다(앱 규칙). 처리 뒤 3년 보존.
model Report {
  id                        Uuid                   @id
  reporter_kind             ReportReporterKind
  reporter_member_id        Uuid?
  reporter_member           Member?                @relation(fields: [reporter_member_id], references: [id])
  reporter_staff_account_id Uuid?
  reporter_staff_account    StaffAccount?          @relation(name: "report_reporter", fields: [reporter_staff_account_id], references: [id])
  target_kind               ReportTargetKind
  target_id                 Uuid
  reason_code               ReportReasonCode
  detail                    String?
  status                    ReportStatus           @default(received)
  outcome                   ReportOutcome?
  outcome_note              String?
  resolved_by_account_id    Uuid?
  resolved_by               StaffAccount?          @relation(name: "report_resolver", fields: [resolved_by_account_id], references: [id])
  // 인정된 신고가 연 이용 제한 절차(S7-2.6 에서 FK 를 붙였다).
  restriction_case_id       Uuid?
  restriction_case          RestrictionCase?       @relation(name: "report_restriction_case", fields: [restriction_case_id], references: [id])
  // 이 신고를 출처로 연 절차(restriction_cases.source_report_id) — DB 칸이 아니라 관계다.
  restriction_cases_sourced RestrictionCase[]      @relation(name: "restriction_source_report")
  idempotency_key           String(storage: varchar, length: 200)
  received_at               DateTime(as: temporal) @default(now())
  reviewed_at               DateTime(as: temporal)?
  resolved_at               DateTime(as: temporal)?

  // 신고자는 회원이나 직원 둘 중 정확히 하나(문의와 같은 규칙).
  @@check(
    expression: sql`(reporter_kind = 'member' AND reporter_member_id IS NOT NULL AND reporter_staff_account_id IS NULL) OR (reporter_kind <> 'member' AND reporter_staff_account_id IS NOT NULL AND reporter_member_id IS NULL)`,
    name: "ck_reports_reporter"
  )
  // 처리 끝(resolved)이면 결과와 처리 시각이 반드시 있고, 처리 전이면 둘 다 없다.
  @@check(
    expression: sql`(status = 'resolved') = (outcome IS NOT NULL AND resolved_at IS NOT NULL) AND (status = 'resolved' OR (outcome IS NULL AND resolved_at IS NULL))`,
    name: "ck_reports_resolved"
  )
  @@check(expression: sql`char_length(idempotency_key) > 0`, name: "ck_reports_idempotency_key")
  // 같은 사람이 같은 대상을 같은 사유로 신고한 건이 처리 전이면 하나만 — 회원·직원 중 한쪽이 늘 NULL 이라 둘로 나눈다
  // (설계의 NULLS NOT DISTINCT 한 개와 같은 뜻. 추천안 — 계약으로 표현할 수 있는 모양으로 바꿨다).
  @@index([reporter_member_id, target_kind, target_id, reason_code], unique: true, where: sql`(status <> 'resolved' AND reporter_member_id IS NOT NULL)`, name: "uq_reports_open_member")
  @@index([reporter_staff_account_id, target_kind, target_id, reason_code], unique: true, where: sql`(status <> 'resolved' AND reporter_staff_account_id IS NOT NULL)`, name: "uq_reports_open_staff")
  @@index([reporter_member_id, idempotency_key], unique: true, where: sql`(reporter_member_id IS NOT NULL)`, name: "uq_reports_idem_member")
  @@index([reporter_staff_account_id, idempotency_key], unique: true, where: sql`(reporter_staff_account_id IS NOT NULL)`, name: "uq_reports_idem_staff")
  // 운영자 신고 목록(상태별 · 들어온 순).
  @@index([status, received_at], name: "ix_reports_status")
  @@map("reports")
}

// 문의 글·신고·소명에 붙은 파일 한 장(S7-2.7(문의·신고 첨부 파일), data-model §12 「attachment_links」).
// 한 파일은 한 곳에만 붙는다(uq_attachment_file). 누가 열 수 있는지는 GET /api/files/{fileId} 의 판정 함수 하나가 owner_kind 별로 정한다:
//   inquiry_message — 문의자 · 받는 쪽(학원 문의 = 그 학원 대표, 시스템 문의 = 운영자) / report — 신고자 · 운영자
// owner_id 는 owner_kind 에 따라 다른 표를 가리켜 FK 를 걸지 않는다. 붙이는 처리기가 같은 트랜잭션에서 주인 행을 만든 뒤 잇는다.
enum AttachmentOwnerKind {
  @@type("pg/text@1")
  inquiry_message         = "inquiry_message"
  report                  = "report"
  restriction_explanation = "restriction_explanation"
}

model AttachmentLink {
  id         Uuid                   @id
  owner_kind AttachmentOwnerKind
  owner_id   Uuid
  file_id    Uuid
  file       UploadedFile           @relation(fields: [file_id], references: [id])
  // 화면에 보이는 순서(0부터).
  position   Int
  created_at DateTime(as: temporal) @default(now())

  @@index([file_id], unique: true, name: "uq_attachment_file")
  @@index([owner_kind, owner_id, position], unique: true, name: "uq_attachment_position")
  @@index([owner_kind, owner_id], name: "ix_attachment_owner")
  @@check(expression: sql`position >= 0`, name: "ck_attachment_position")
  @@map("attachment_links")
}

// ───────────────────────── 12-6. 이용 제한 절차 (S7-2.6(이용 제한 절차)) ─────────────────────────
// 설계 원본: data-model §12 「restriction_cases」 · 12-5 전이표 · 12-9 값 집합 · 계약 15-ops §2-8 · spec FR-254(이용 제한 절차).
// 운영자가 회원·강사·학원의 이용을 제한할 때 「누구를 · 왜(사유) · 어떤 조치를 · 언제」 한 행으로 남긴다.
// 흐름: 사유 통지(notice_sent) → 소명(explained) → 조치 확정(measure_applied) → 해제(lifted) / 기각(dismissed).
// 긴급(urgent)이면 조치를 먼저 하고 바로 알린다 — measure_applied 로 시작한다.
// 소명 글(restriction_explanations)은 소명 경로를 만드는 Task 가 만든다(추천안·사후 확인 2026-11-24, S7-2.6 — EVIDENCE.md).
// 환불 경로는 이 표를 읽지 않는다 — 이용이 정지돼도 기존 결제 환불 청구권은 막지 않는다(FR-254).

// 제한 대상의 종류 — 회원 / 강사 / 학원. 종류마다 대상 칸이 하나씩 있다(ck_restriction_subject).
enum RestrictionSubjectKind {
  @@type("pg/text@1")
  member     = "member"
  instructor = "instructor"
  academy    = "academy"
}

// 절차를 연 길 — 신고 처리 / 사업자 점검 / 운영자가 직접.
enum RestrictionSource {
  @@type("pg/text@1")
  report          = "report"
  business_status = "business_status"
  operator_manual = "operator_manual"
}

// 조치 — 경고 / 기능 제한 / 수업 게시 제한 / 정산 보류 / 이용 정지 / 해지(FR-254).
enum RestrictionMeasure {
  @@type("pg/text@1")
  warning       = "warning"
  feature_limit = "feature_limit"
  listing_limit = "listing_limit"
  payout_hold   = "payout_hold"
  suspension    = "suspension"
  termination   = "termination"
}

// 절차 단계 — 사유 통지 / 소명 들어옴 / 조치 확정 / 해제 / 기각.
enum RestrictionState {
  @@type("pg/text@1")
  notice_sent     = "notice_sent"
  explained       = "explained"
  measure_applied = "measure_applied"
  lifted          = "lifted"
  dismissed       = "dismissed"
}

// 이용 제한 절차 한 건 — 감사 ○(열기·조치·해제마다 audit_logs 1행).
model RestrictionCase {
  id                       Uuid                    @id
  subject_kind             RestrictionSubjectKind
  subject_member_id        Uuid?
  subject_member           Member?                 @relation(fields: [subject_member_id], references: [id])
  subject_staff_account_id Uuid?
  subject_staff_account    StaffAccount?           @relation(name: "restriction_subject_staff", fields: [subject_staff_account_id], references: [id])
  subject_academy_id       Uuid?
  subject_academy          Academy?                @relation(fields: [subject_academy_id], references: [id])
  source                   RestrictionSource
  // 신고 처리에서 열었으면 그 신고, 사업자 점검에서 열었으면 그 조회 기록.
  source_report_id         Uuid?
  source_report            Report?                 @relation(name: "restriction_source_report", fields: [source_report_id], references: [id])
  source_check_id          Uuid?
  source_check             BusinessStatusCheck?    @relation(fields: [source_check_id], references: [id])
  // 사유 — 코드(신고 사유 값과 같은 집합을 쓴다)와 대상에게 보여 줄 글. 「사유와 함께 기록된다」의 두 칸이다.
  reason_code              String
  reason_text              String
  planned_measure          RestrictionMeasure?
  measure                  RestrictionMeasure?
  state                    RestrictionState
  urgent                   Boolean                 @default(false)
  notice_sent_at           DateTime(as: temporal)
  explanation_due_at       DateTime(as: temporal)?
  measure_applied_at       DateTime(as: temporal)?
  lifted_at                DateTime(as: temporal)?
  // 연 운영자(자동 점검이 연 것은 비어 있다) · 닫은 운영자.
  opened_by_account_id     Uuid?
  opened_by                StaffAccount?           @relation(name: "restriction_opened_by", fields: [opened_by_account_id], references: [id])
  closed_by_account_id     Uuid?
  closed_by                StaffAccount?           @relation(name: "restriction_closed_by", fields: [closed_by_account_id], references: [id])
  // 운영자가 POST /api/admin/restrictions 로 열 때의 Idempotency-Key. 신고 처리·점검이 연 것은 비어 있다(추천안·사후 확인 2026-11-24).
  idempotency_key          String(storage: varchar, length: 200)?
  created_at               DateTime(as: temporal)  @default(now())
  updated_at               DateTime(as: temporal)
  // 이 절차를 가리키는 신고(reports.restriction_case_id) · 이 절차가 연 학원 제한 행 — DB 칸이 아니라 관계다.
  reports                  Report[]                @relation(name: "report_restriction_case")
  academy_restrictions     AcademyRestriction[]
  explanations             RestrictionExplanation[]

  // 대상 종류와 대상 칸이 짝 — 회원이면 회원 칸만, 강사면 직원 칸만, 학원이면 학원 칸만 채운다.
  @@check(
    expression: sql`(subject_kind = 'member' AND subject_member_id IS NOT NULL AND subject_staff_account_id IS NULL AND subject_academy_id IS NULL) OR (subject_kind = 'instructor' AND subject_staff_account_id IS NOT NULL AND subject_member_id IS NULL AND subject_academy_id IS NULL) OR (subject_kind = 'academy' AND subject_academy_id IS NOT NULL AND subject_member_id IS NULL AND subject_staff_account_id IS NULL)`,
    name: "ck_restriction_subject"
  )
  // 조치 확정 단계면 어떤 조치를 언제 했는지가 반드시 있다(lifted 는 조치 없는 해제도 있어 묻지 않는다).
  @@check(expression: sql`state <> 'measure_applied' OR (measure IS NOT NULL AND measure_applied_at IS NOT NULL)`, name: "ck_restriction_state_measure")
  // 사유 글은 비울 수 없다 — 대상이 무엇 때문에 제한되는지 알아야 소명할 수 있다.
  @@check(expression: sql`char_length(btrim(reason_text)) > 0 AND char_length(reason_code) > 0`, name: "ck_restriction_reason")
  @@check(expression: sql`idempotency_key IS NULL OR char_length(idempotency_key) > 0`, name: "ck_restriction_idempotency_key")
  // 같은 대상·같은 출처로 열린 절차는 하나 — 설계의 NULLS NOT DISTINCT 한 개를 대상 종류별 부분 UNIQUE 셋으로 나눴다(신고 표와 같은 방식).
  @@index([subject_member_id, source], unique: true, where: sql`(state IN ('notice_sent', 'explained', 'measure_applied') AND subject_member_id IS NOT NULL)`, name: "uq_restriction_open_member")
  @@index([subject_staff_account_id, source], unique: true, where: sql`(state IN ('notice_sent', 'explained', 'measure_applied') AND subject_staff_account_id IS NOT NULL)`, name: "uq_restriction_open_staff")
  @@index([subject_academy_id, source], unique: true, where: sql`(state IN ('notice_sent', 'explained', 'measure_applied') AND subject_academy_id IS NOT NULL)`, name: "uq_restriction_open_academy")
  // 같은 운영자가 같은 열쇠로 두 번 열면 처음 것을 돌려준다.
  @@index([opened_by_account_id, idempotency_key], unique: true, where: sql`(idempotency_key IS NOT NULL)`, name: "uq_restriction_idem")
  // P11 목록(단계별 · 소명 기한 순) · 학원별 절차 찾기.
  @@index([state, explanation_due_at], name: "ix_restriction_state")
  @@index([subject_academy_id], name: "ix_restriction_subject_academy")
  @@map("restriction_cases")
}

// 소명 글 — data-model §12 「restriction_explanations」(추가 전용). 제한 대상(회원 본인·강사 본인·학원 대표)이 낸 설명 한 건이 한 행이다.
// S1-1.29(소명 기한 지남 → 운영자 게시 중단)가 P11 의 「소명이 있나」 판정(accept-explanation 의 409 NO_EXPLANATION)에 쓰려고 표를 먼저 만들었다.
// 소명을 내는 경로(15-ops §2-8 POST /api/restrictions/{caseId}/explanations)와 첨부(attachment_links)는 그 경로를 만드는 Task 몫이다.
model RestrictionExplanation {
  id                            Uuid                   @id
  case_id                       Uuid
  restriction_case              RestrictionCase        @relation(fields: [case_id], references: [id])
  // 낸 사람 — 회원이면 회원 칸, 강사·대표면 직원 칸. 둘 중 하나만 찬다.
  submitted_by_member_id        Uuid?
  submitted_by_member           Member?                @relation(fields: [submitted_by_member_id], references: [id])
  submitted_by_staff_account_id Uuid?
  submitted_by_staff_account    StaffAccount?          @relation(fields: [submitted_by_staff_account_id], references: [id])
  body                          String
  created_at                    DateTime(as: temporal) @default(now())

  @@check(expression: sql`num_nonnulls(submitted_by_member_id, submitted_by_staff_account_id) = 1`, name: "ck_explanation_submitter")
  // 빈 소명은 소명이 아니다 — 운영자가 받아들일 근거가 없다.
  @@check(expression: sql`char_length(btrim(body)) > 0`, name: "ck_explanation_body")
  @@index([case_id, created_at], name: "ix_explanations_case")
  @@map("restriction_explanations")
}

// ---- SX-6.5(하루 횟수·생성 요청 API) — 홍보 이미지 만들기(data-model §13-6, 계약 16 §4-7) ----

// 홍보 이미지 만들기 상태. queued → running → succeeded · failed(횟수 원복 1회). 끝 상태에서는 안 바뀐다.
enum PromoImageGenerationStatus {
  @@type("pg/text@1")
  queued    = "queued"
  running   = "running"
  succeeded = "succeeded"
  failed    = "failed"
}

// 홍보 이미지 실패 이유(§13-8). 이 이유로 failed 가 되면 그날 횟수를 1 돌려준다.
enum PromoImageFailureCode {
  @@type("pg/text@1")
  PROVIDER_QUOTA_EXHAUSTED = "PROVIDER_QUOTA_EXHAUSTED"
  PROVIDER_ERROR           = "PROVIDER_ERROR"
  AGENT_UNAVAILABLE        = "AGENT_UNAVAILABLE"
  TIMEOUT                  = "TIMEOUT"
  INVALID_RESULT           = "INVALID_RESULT"
}

// 홍보 이미지 만들기 한 번 — 입력(칩·문장·조건)·상태·결과 그림·횟수 원복을 한 줄에 둔다.
// 막는 입력(SX-6.3)은 이 행을 만들지 않는다(횟수 불변 — 422 로 끝). 다시 만들기도 새 행 하나(= 1번)다.
model PromoImageGeneration {
  id                Uuid                        @id
  staff_account_id  Uuid
  staff_account     StaffAccount                @relation(fields: [staff_account_id], references: [id])
  class_id          Uuid
  class             Class                       @relation(fields: [class_id], references: [id])
  // 수업에서 가져온 장르 사본(잠긴 칩)
  genre             Genre
  // {who,mood,place,color} — 값은 칩 낱말 또는 {"custom":"…"}
  chips             Json
  sentence          String
  // 실제로 붙인 자동 조건 id(no_text 포함, 설정 순서). data-model 의 text[] 대신 jsonb 배열(추천안·사후 확인 2026-11-24)
  auto_condition_ids Json                       @default(sql`'[]'::jsonb`)
  // 고른 엔진 id(FR-061a 「엔진 이름 기록」). 만들 때 적는다 — data-model 의 NULL 허용보다 좁혔다(추천안·사후 확인 2026-11-24)
  engine            String
  // 번역 기록 — 앱에는 안 보인다
  english_prompt    String?
  // 횟수를 차감한 KST 날짜. 원복도 이 날짜 줄에서 한다(자정을 넘겨 실패해도 차감한 날로 돌려준다)
  usage_date        Date
  status            PromoImageGenerationStatus  @default(queued)
  image_file_id     Uuid?
  image_file        UploadedFile?               @relation(fields: [image_file_id], references: [id])
  model             String?
  failure_code      PromoImageFailureCode?
  quota_refunded_at DateTime(as: temporal)?
  idempotency_key   String
  job_id            Uuid?
  job               AiJob?                      @relation(fields: [job_id], references: [id])
  ai_generated      Boolean                     @default(true)
  created_at        DateTime(as: temporal)      @default(now())
  finished_at       DateTime(as: temporal)?
  // 이 그림을 표지로 고른 수업 홍보 자료 — DB 칸이 아니라 관계다(SX-6.7).
  promo_assets      ClassPromoAsset[]

  @@check(expression: sql`char_length(sentence) BETWEEN 1 AND 200`, name: "ck_promo_gen_sentence")
  // AI 가 만든 것이라는 표시(FR-258)는 끌 수 없다.
  @@check(expression: sql`ai_generated = true`, name: "ck_promo_gen_ai")
  // 성공과 결과 그림은 함께 있거나 함께 없다.
  @@check(expression: sql`(status = 'succeeded') = (image_file_id IS NOT NULL)`, name: "ck_promo_gen_succeeded_image")
  // 실패와 실패 이유는 함께 있거나 함께 없다.
  @@check(expression: sql`(status = 'failed') = (failure_code IS NOT NULL)`, name: "ck_promo_gen_failed")
  // 성공한 생성은 횟수를 돌려주지 않는다 — 원복 표시는 실패에만 있다.
  @@check(expression: sql`quota_refunded_at IS NULL OR status = 'failed'`, name: "ck_promo_gen_refund")
  // 끝난 생성(succeeded·failed)에는 끝난 때가 있다.
  @@check(expression: sql`status NOT IN ('succeeded', 'failed') OR finished_at IS NOT NULL`, name: "ck_promo_gen_done")
  // 같은 직원의 같은 멱등 키는 한 번만 — 다시 오면 처음 생성을 돌려준다(횟수 다시 차감하지 않음).
  @@index([staff_account_id, idempotency_key], unique: true, name: "uq_promo_gen_staff_idem")
  // 지난 입력 불러오기(본인 것 최신순).
  @@index([staff_account_id, created_at], name: "ix_promo_gen_staff_created")
  // 이달 무료량 셈(SX-6.8).
  @@index([created_at], where: sql`(status IN ('queued', 'running', 'succeeded'))`, name: "ix_promo_gen_month")
  @@map("promo_image_generations")
}

// 직원 × KST 날짜의 홍보 이미지 만든 횟수. 상한은 설정값(베타 3)이라 CHECK 가 아니라 조건부 UPDATE(WHERE used_count < :limit)가 권위다.
model PromoImageUsage {
  staff_account_id Uuid
  staff_account    StaffAccount @relation(fields: [staff_account_id], references: [id])
  usage_date       Date
  used_count       Int          @default(0)

  @@id([staff_account_id, usage_date])
  @@check(expression: sql`used_count >= 0`, name: "ck_promo_usage_nonneg")
  @@map("promo_image_usage")
}

// 엔진 × KST 날짜의 전체 생성 요청 수 — 무료 엔진의 하루 한도를 사람 수와 상관없이 지킨다(spec FR-061a 「엔진별 전체 하루 한도」).
// 사람 횟수와 달리 실패해도 돌려주지 않는다(요청을 보냈으면 공급자 무료량을 썼을 수 있다). 추천안·사후 확인 2026-11-24
model PromoImageEngineUsage {
  engine     String
  usage_date Date
  used_count Int    @default(0)

  @@id([engine, usage_date])
  @@check(expression: sql`used_count >= 0`, name: "ck_promo_engine_usage_nonneg")
  @@map("promo_image_engine_usage")
}

// 소개 문구 초안 기록(SX-6.6(소개 문구 초안), data-model §13-6 class_intro_drafts). 다시 만들 때마다 새 행이다.
// body 의 시간·가격·회차는 모델이 쓴 것이 아니라 facts(수업 데이터) 값을 자리에 채운 것이다.
// model 은 틀을 쓴 대화 모델 이름 — 모델 틀이 두 번 다 거부돼 기본 문장을 쓴 행은 NULL 이다(추천안·사후 확인 2026-11-24).
model ClassIntroDraft {
  id               Uuid                   @id
  staff_account_id Uuid
  staff_account    StaffAccount           @relation(fields: [staff_account_id], references: [id])
  class_id         Uuid
  class            Class                  @relation(fields: [class_id], references: [id])
  emphasis         String?
  body             String
  facts            Json
  model            String?
  ai_generated     Boolean                @default(true)
  created_at       DateTime(as: temporal) @default(now())
  // 이 초안을 소개 문구로 고른 수업 홍보 자료 — DB 칸이 아니라 관계다(SX-6.7).
  promo_assets     ClassPromoAsset[]

  @@check(expression: sql`emphasis IS NULL OR char_length(emphasis) <= 60`, name: "ck_intro_emphasis_len")
  // AI 기능으로 만든 초안이라는 표시(FR-258)는 끌 수 없다.
  @@check(expression: sql`ai_generated = true`, name: "ck_intro_ai")
  @@check(expression: sql`char_length(body) BETWEEN 1 AND 600`, name: "ck_intro_body_len")
  @@index([class_id, created_at], name: "ix_intro_class_created")
  @@map("class_intro_drafts")
}

// ---- SX-6.7(검토 후 게시 경로) — 수업 홍보 표지·소개 문구(data-model §13-6 class_promo_assets, 계약 16 §4-7) ----

// 표지가 어디서 왔나. 올린 사진이 있으면 언제나 uploaded_photo(사진이 먼저).
enum PromoCoverSource {
  @@type("pg/text@1")
  uploaded_photo = "uploaded_photo"
  ai_image       = "ai_image"
}

// 소개 문구가 어디서 왔나. ai = 초안 그대로 · ai_edited = 초안을 고침 · user = 직접 씀.
enum PromoIntroSource {
  @@type("pg/text@1")
  ai        = "ai"
  ai_edited = "ai_edited"
  user      = "user"
}

// 수업 하나의 홍보 표지·소개 문구와 「검토 끝」 확인. PUT 전체 교체라 저장할 때마다 검토 확인을 다시 정한다.
// 이미지 위 글자는 저장하지 않는다 — 수업 데이터가 원본이고 앱이 얹는다(FR-061a). 그래서 글자 칸이 없다.
model ClassPromoAsset {
  class_id                     Uuid                    @id
  class                        Class                   @relation(fields: [class_id], references: [id])
  uploaded_photo_file_id       Uuid?
  uploaded_photo_file          UploadedFile?           @relation(fields: [uploaded_photo_file_id], references: [id])
  ai_image_generation_id       Uuid?
  ai_image_generation          PromoImageGeneration?   @relation(fields: [ai_image_generation_id], references: [id])
  cover_source                 PromoCoverSource?
  intro_text                   String?
  intro_source                 PromoIntroSource?
  intro_draft_id               Uuid?
  intro_draft                  ClassIntroDraft?        @relation(fields: [intro_draft_id], references: [id])
  reviewed_at                  DateTime(as: temporal)?
  reviewed_by_staff_account_id Uuid?
  reviewed_by                  StaffAccount?           @relation(fields: [reviewed_by_staff_account_id], references: [id])
  updated_at                   DateTime(as: temporal)  @default(now())

  // 사진이 먼저: 사진이 있으면 표지는 사진이다. AI 표지면 생성 id 가 있고 사진은 없다. 표지가 없으면 둘 다 없다.
  @@check(expression: sql`(uploaded_photo_file_id IS NULL OR cover_source = 'uploaded_photo') AND (cover_source IS DISTINCT FROM 'ai_image' OR (ai_image_generation_id IS NOT NULL AND uploaded_photo_file_id IS NULL)) AND (cover_source IS NOT NULL OR (uploaded_photo_file_id IS NULL AND ai_image_generation_id IS NULL))`, name: "ck_promo_assets_cover")
  // 문구와 그 출처는 함께 있거나 함께 없다.
  @@check(expression: sql`(intro_text IS NULL) = (intro_source IS NULL)`, name: "ck_promo_assets_intro")
  // 문구는 600자까지(임시 확정 2026-11-20).
  @@check(expression: sql`intro_text IS NULL OR char_length(intro_text) BETWEEN 1 AND 600`, name: "ck_promo_assets_intro_len")
  // 검토 시각과 검토한 사람은 함께 있거나 함께 없다.
  @@check(expression: sql`(reviewed_at IS NULL) = (reviewed_by_staff_account_id IS NULL)`, name: "ck_promo_assets_review")
  @@map("class_promo_assets")
}

// ───────────────────────── 105~111. 레벨·카드·개강 후보 (S6-3.1, data-model §11-4) ─────────────────────────
// 회원의 레벨은 「세부 장르」마다 따로 0~10 이다(FR-160 · FR-169). 정규 수업 한 기간을 끝까지 마치고 출석 70% 이상이면
// 1칸 오르고(결정 D7), 오를 때마다 등급 카드 한 장이 생긴다(FR-169e). 강사는 따로 「평가 레벨」을 매기는데 회원에게는 보이지 않는다.
// 이 표들은 S6-3.1 이 만들고, 계산·작업·API·화면은 S6-3.2~S6-3.8 이 채운다.

// 레벨을 매기는 세부 장르(data-model §11-9) — 댄스스포츠 10종목 + 살사·바차타 + 아르헨티나 탱고·스윙.
// 수업에는 이 칸이 없다. 수업의 discipline → sub_genre → genre 순으로 읽어 정한다(levelGenreOf, §14-1).
enum LevelDetailGenre {
  @@type("pg/text@1")
  cha_cha_cha     = "cha_cha_cha"
  samba           = "samba"
  rumba           = "rumba"
  paso_doble      = "paso_doble"
  jive            = "jive"
  waltz           = "waltz"
  tango           = "tango"
  viennese_waltz  = "viennese_waltz"
  slow_foxtrot    = "slow_foxtrot"
  quickstep       = "quickstep"
  argentine_tango = "argentine_tango"
  swing           = "swing"
  salsa           = "salsa"
  bachata         = "bachata"
}

// 레벨이 오른 까닭 — 정규 과정 완주(묻지 않고 바로) / 강사가 올려 준 제안을 회원이 받아들임.
enum LevelPromotionSource {
  @@type("pg/text@1")
  course_completion = "course_completion"
  instructor_offer  = "instructor_offer"
}

// 강사 레벨 제안의 상태 — 열림 / 승급함 / 지금 레벨에서 키우기로 함 / 강사가 다시 올려 줘서 닫힘.
enum LevelOfferStatus {
  @@type("pg/text@1")
  offered    = "offered"
  accepted   = "accepted"
  declined   = "declined"
  superseded = "superseded"
}

// 105. 회원의 세부 장르별 현재 레벨. 행이 없으면 레벨 0 이다(수강 기록이 없으면 가입 때 고른 경험 수준으로 읽는다 — S6-3.2).
// 레벨은 내려가지 않는다(FR-169): 쓰기는 늘 `... SET level = :to WHERE ... AND level < :to` 한 문장이다.
// 단계 이름(입문·초급…)은 저장하지 않고 레벨 숫자에서 계산한다(FR-161).
model MemberGenreLevel {
  member_id    Uuid
  member       Member                 @relation(fields: [member_id], references: [id])
  detail_genre LevelDetailGenre
  level        Int
  updated_at   DateTime(as: temporal) @default(now())

  // 레벨은 0~10 만(FR-160). 앱이 실수로 11 을 넣어도 DB 가 막는다.
  @@check(expression: sql`level BETWEEN 0 AND 10`, name: "ck_levels_range")
  @@id([member_id, detail_genre])
  @@map("member_genre_levels")
}

// 106. 정규 과정 한 기간의 판정 기록 — 레벨 계산 작업(S6-3.3)이 판매 단위·회원마다 한 줄 쓴다.
// 같은 작업을 두 번 돌려도 줄이 하나라 레벨이 두 번 오르지 않는다(uq_completions_offering_member).
// 출석 횟수는 서버 안에서만 쓴다 — 화면·응답에는 「끝까지 마치고 출석 70% 이상」 문구만 나간다(결정 D7).
model CourseCompletion {
  id                Uuid                   @id
  offering_id       Uuid
  offering          ClassOffering          @relation(fields: [offering_id], references: [id])
  member_id         Uuid
  member            Member                 @relation(fields: [member_id], references: [id])
  reservation_id    Uuid
  reservation       Reservation            @relation(fields: [reservation_id], references: [id])
  order_id          Uuid
  order             Order                  @relation(fields: [order_id], references: [id])
  // 기간이 끝날 때까지 환불·취소 없이 수강을 유지했는가.
  completed         Boolean
  attended_sessions Int
  // 휴강·폐강 회차를 뺀 회차 수(열린 점 ⑩).
  total_sessions    Int
  level_awarded     Boolean
  promotion_id      Uuid?
  promotion         LevelPromotion?        @relation(fields: [promotion_id], references: [id])
  evaluated_at      DateTime(as: temporal) @default(now())

  // 출석 횟수는 0 이상, 전체 회차 이하.
  @@check(expression: sql`total_sessions >= 0 AND attended_sessions BETWEEN 0 AND total_sessions`, name: "ck_completions_sessions")
  // 레벨을 줬으면 그 승급 기록이 있고, 안 줬으면 없다.
  @@check(expression: sql`level_awarded = (promotion_id IS NOT NULL)`, name: "ck_completions_award")
  // 끝까지 마치지 않았으면 레벨을 줄 수 없다(추천안 — 설계에 없던 CHECK, 증거 EVIDENCE.md 기록).
  @@check(expression: sql`completed OR NOT level_awarded`, name: "ck_completions_award_requires_completed")
  @@index([offering_id, member_id], unique: true, name: "uq_completions_offering_member")
  // 회원 한 사람의 수강 완료 이력(강사 「지난 수업」 I38 · 회원 레벨 화면).
  @@index([member_id, evaluated_at], name: "ix_completions_member")
  @@map("course_completions")
}

// 107. 레벨이 오른 이력 — 추가 전용(고치지 않는다). 카드 한 장은 이 줄 하나에서 나온다.
model LevelPromotion {
  id           Uuid                   @id
  member_id    Uuid
  member       Member                 @relation(fields: [member_id], references: [id])
  detail_genre LevelDetailGenre
  from_level   Int
  to_level     Int
  source       LevelPromotionSource
  // 완주 승급이면 그 판매 단위, 강사 제안이면 제안이 나온 수업 명단(없을 수 있다).
  offering_id  Uuid?
  offering     ClassOffering?         @relation(fields: [offering_id], references: [id])
  offer_id     Uuid?
  offer        LevelOffer?            @relation(fields: [offer_id], references: [id])
  created_at   DateTime(as: temporal) @default(now())
  completions  CourseCompletion[]
  card         LevelCard?

  @@check(expression: sql`from_level BETWEEN 0 AND 10 AND to_level BETWEEN 0 AND 10`, name: "ck_promotions_range")
  // 승급은 언제나 위로만(FR-169 — 회원 레벨은 내려가지 않는다).
  @@check(expression: sql`to_level > from_level`, name: "ck_promotions_up")
  // 완주 승급은 판매 단위가 있고 제안이 없다. 강사 제안 승급은 제안이 있다.
  @@check(
    expression: sql`(source = 'course_completion' AND offering_id IS NOT NULL AND offer_id IS NULL) OR (source = 'instructor_offer' AND offer_id IS NOT NULL)`,
    name: "ck_promotions_source"
  )
  // 완주 승급은 한 번에 1칸만(설계는 「앱 검사 + 테스트」 — DB 도 막는다, 추천안).
  @@check(expression: sql`source <> 'course_completion' OR to_level = from_level + 1`, name: "ck_promotions_completion_step")
  // 같은 판매 단위를 마쳐서 두 번 오르지 않는다.
  @@index([member_id, offering_id], unique: true, where: sql`(source = 'course_completion')`, name: "uq_promotions_completion")
  // 같은 제안을 두 번 받아들여 두 번 오르지 않는다(추천안).
  @@index([offer_id], unique: true, where: sql`(offer_id IS NOT NULL)`, name: "uq_promotions_offer")
  @@index([member_id, detail_genre, created_at], name: "ix_promotions_member_genre")
  @@map("level_promotions")
}

// 108. 발급된 등급 카드(카드 모음 FR-169f). 발급된 것만 줄이 있다 — 강사 제안을 「아니오」로 거절하면 카드도 없다(FR-169e).
model LevelCard {
  id             Uuid                    @id
  member_id      Uuid
  member         Member                  @relation(name: "level_card_owner", fields: [member_id], references: [id])
  detail_genre   LevelDetailGenre
  level          Int
  promotion_id   Uuid
  promotion      LevelPromotion          @relation(fields: [promotion_id], references: [id])
  // 발급 연출을 본 시각. 앱을 열었을 때 NULL 인 카드가 있으면 연출을 띄운다.
  revealed_at    DateTime(as: temporal)?
  created_at     DateTime(as: temporal)  @default(now())
  // 이 카드를 대표 캐릭터로 고른 회원(FR-169c) — DB 칸이 아니라 관계다.
  featured_by    Member[]                @relation(name: "member_featured_level_card")

  @@check(expression: sql`level BETWEEN 0 AND 10`, name: "ck_level_cards_range")
  // 같은 장르·같은 레벨 카드는 한 장뿐이다.
  @@index([member_id, detail_genre, level], unique: true, name: "uq_level_cards_member_genre_level")
  // 승급 한 번에 카드 한 장.
  @@index([promotion_id], unique: true, name: "uq_level_cards_promotion")
  // 「아직 연출을 안 본 카드」 찾기 전용(추천안).
  @@index([member_id], where: sql`(revealed_at IS NULL)`, name: "ix_level_cards_unrevealed")
  @@map("level_cards")
}

// 109. 강사 평가 레벨 — 강사가 새 반 후보를 모을 때 쓰는 모집용 숫자(FR-164 · FR-169d). 올리고 내릴 수 있다.
// 회원에게는 보이지 않는다: 회원 화면 응답 모양에 이 키 자체가 없다(S6-3 수용 ③). 쓰기는 감사 기록 level.evaluation_set 을 남긴다.
model InstructorLevelEvaluation {
  instructor_account_id Uuid
  instructor            StaffAccount           @relation(fields: [instructor_account_id], references: [id])
  member_id             Uuid
  member                Member                 @relation(fields: [member_id], references: [id])
  detail_genre          LevelDetailGenre
  eval_level            Int
  evaluated_at          DateTime(as: temporal) @default(now())

  @@check(expression: sql`eval_level BETWEEN 0 AND 10`, name: "ck_evaluations_range")
  @@id([instructor_account_id, member_id, detail_genre])
  // 개강 후보 찾기(강사 · 장르 · 평가 레벨 구간) 전용(추천안).
  @@index([instructor_account_id, detail_genre, eval_level], name: "ix_evaluations_candidates")
  @@map("instructor_level_evaluations")
}

// 110. 강사가 올려 준 레벨 제안 — 멤버십 강사만 보낸다, 받는 회원은 멤버십 무관(2026-11-24 FR-169d 개정 — 이전 2026-10-15 「멤버십 회원에게만」, 보내는 API 가 확인). 회원이 「승급하기」 또는 「지금 레벨에서 키우기」를 고른다.
// 쓰기는 감사 기록 level.offer_sent 를 남긴다.
model LevelOffer {
  id                    Uuid                    @id
  member_id             Uuid
  member                Member                  @relation(fields: [member_id], references: [id])
  instructor_account_id Uuid
  instructor            StaffAccount            @relation(fields: [instructor_account_id], references: [id])
  // 어느 수업 명단에서 올렸는가(없을 수 있다).
  offering_id           Uuid?
  offering              ClassOffering?          @relation(fields: [offering_id], references: [id])
  detail_genre          LevelDetailGenre
  from_level            Int
  to_level              Int
  status                LevelOfferStatus        @default(offered)
  offered_at            DateTime(as: temporal)  @default(now())
  // 회원이 답한 시각 — 승급하기·지금 레벨에서 키우기에만 있다(superseded 는 회원이 답한 게 아니다).
  responded_at          DateTime(as: temporal)?
  created_at            DateTime(as: temporal)  @default(now())
  updated_at            DateTime(as: temporal)  @default(now())
  promotions            LevelPromotion[]

  @@check(expression: sql`from_level BETWEEN 0 AND 10 AND to_level BETWEEN 0 AND 10`, name: "ck_level_offers_range")
  // 제안은 올리는 경우만이다 — 회원 레벨은 내려가지 않는다. 내린 평가는 평가 레벨에만 남는다(I23).
  @@check(expression: sql`to_level > from_level`, name: "ck_level_offers_up")
  // 회원이 답했으면(승급·거절) 답한 시각이 있고, 그 밖에는 없다(추천안).
  @@check(expression: sql`(status IN ('accepted', 'declined')) = (responded_at IS NOT NULL)`, name: "ck_level_offers_responded")
  // 같은 회원·같은 장르에 열린 제안은 하나 — 다시 올려 주면 앞 제안을 superseded 로 닫고 새로 만든다.
  @@index([member_id, detail_genre], unique: true, where: sql`(status = 'offered')`, name: "uq_level_offers_open")
  @@index([instructor_account_id, offered_at], name: "ix_level_offers_instructor")
  @@map("level_offers")
}

// 111. 개강 후보 연락처 제공 동의(FR-165 · FR-272). 회원 한 사람에 한 줄, 행이 없으면 「동의하지 않음」이다.
// 동의하지 않은 후보는 강사 화면에 숫자로만 나온다(S6-3 수용 ④). 연락처 「보기」는 audit_logs(candidate.contact_viewed)에 남긴다.
model CandidateContactConsent {
  member_id    Uuid                    @id
  member       Member                  @relation(fields: [member_id], references: [id])
  consented    Boolean
  consented_at DateTime(as: temporal)?
  withdrawn_at DateTime(as: temporal)?
  updated_at   DateTime(as: temporal)  @default(now())

  // 지금 동의 중이면 동의한 시각이 있고 철회 시각은 없다. 철회했으면 consented=false 다(추천안).
  @@check(expression: sql`NOT consented OR (consented_at IS NOT NULL AND withdrawn_at IS NULL)`, name: "ck_candidate_consents_state")
  @@map("candidate_contact_consents")
}
