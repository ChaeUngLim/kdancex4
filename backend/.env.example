# backend 환경 변수 예시. 복사해서 backend/.env 로 쓰고 값을 채운다(.env 는 커밋하지 않는다).
# 이 파일에는 이름만 적는다 — 값은 비워 둔다(S0-6.4). 이름 목록은 app/config.py 의 Settings 필드와 같아야 한다.
# 주의: 빈 값으로 남긴 줄도 「빈 문자열」로 읽힌다. 기본값(config.py)을 쓰려면 그 줄을 지운다.

# 개발 DB. 모양: postgresql+psycopg://kdance:<비밀번호>@localhost:5433/kdance
DATABASE_URL=
# 테스트 DB. 모양: postgresql+psycopg://kdance:<비밀번호>@localhost:5433/kdance_test
TEST_DATABASE_URL=
# Redis. 모양: redis://localhost:6380/0
REDIS_URL=
